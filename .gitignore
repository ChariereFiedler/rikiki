# Dependencies
node_modules/

# Playwright
test-results/
playwright-report/
loop-shots/

# Build / cache
.cache/
.parcel-cache/

# Note: rikiki/dist/ IS versioned (zero-build promise for consumers).
# Other dist/ folders elsewhere remain ignored:
**/build/dist/
examples/*/dist/

# Logs
*.log
npm-debug.log*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Slidev (legacy)
.slidev/

# Local artefacts, not deliverables
.playwright-mcp/
docs/chardon/

# Contact sheets · generated for looking at, never committed
.shots*/

# Staged from ../rikiki by site/scripts/stage-assets.mjs · never edited by hand
site/public/rikiki/
# staged copies of example decks · rebuilt by site/scripts/stage-assets.mjs
site/public/decks/showcase/
site/public/decks/bento/

# Staged story decks
site/public/stories/*.html
# Story theme assets are staged from examples/stories/art.
site/public/stories/art/
