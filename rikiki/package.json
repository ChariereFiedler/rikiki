{
  "name": "rikiki-deck",
  "version": "0.4.0",
  "description": "A tiny Lit Web Components framework for technical presentations · zero-build for consumers, TypeScript for contributors.",
  "author": "Cédric Chariere Fiedler <chariere.fiedler.cedric@gmail.com>",
  "homepage": "https://rikiki.tordu-jardin.fr",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/tordu-jardin/rikiki.git"
  },
  "bugs": {
    "url": "https://gitlab.com/tordu-jardin/rikiki/-/issues"
  },
  "type": "module",
  "bin": {
    "rikiki": "./bin/rikiki.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./themes/rikiki.css": "./themes/rikiki.css",
    "./themes/siliceum.css": "./themes/siliceum.css",
    "./livereload": "./dist/livereload.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "bin",
    "tokens.css",
    "themes",
    "fonts",
    "README.md",
    "llms.txt",
    "docs/llms"
  ],
  "scripts": {
    "build": "node build-vendor.mjs && node build.mjs && node build-standalone.mjs && tsc --emitDeclarationOnly",
    "vendor": "node build-vendor.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "bundle": "node bundle.mjs",
    "deck": "node build/vite-deck.mjs",
    "deck:example": "node build/vite-deck.mjs decks/example/deck.config.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "lint": "biome check src scripts",
    "format": "biome format --write src scripts",
    "bump": "node scripts/bump-version.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.24.0",
    "lit": "^3.3.3",
    "marked": "^12.0.2",
    "mermaid": "^10.9.6",
    "shiki": "^1.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "keywords": [
    "lit",
    "web-components",
    "presentation",
    "slides",
    "deck",
    "rikiki"
  ],
  "license": "MIT",
  "dependencies": {
    "rolldown": "^1.1.1"
  }
}
