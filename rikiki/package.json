{
  "name": "rikiki-deck",
  "version": "0.7.1",
  "description": "A tiny Lit Web Components framework for technical presentations · zero-build for consumers, TypeScript for contributors.",
  "author": "Cédric Chariere Fiedler <chariere.fiedler.cedric@gmail.com>",
  "homepage": "https://rikiki.tordu-jardin.fr",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/tordu-jardin/rikiki.git"
  },
  "bugs": {
    "url": "https://gitlab.com/tordu-jardin/rikiki/-/issues"
  },
  "type": "module",
  "bin": {
    "rikiki": "bin/rikiki.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./themes/rikiki.css": "./themes/rikiki.css",
    "./themes/siliceum.css": "./themes/siliceum.css",
    "./livereload": "./dist/livereload.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "bin",
    "!bin/**/*.test.mjs",
    "tokens.css",
    "themes",
    "fonts",
    "README.md",
    "llms.txt",
    "docs/llms",
    ".claude/skills/rikiki-deck",
    ".claude/skills/rikiki-theme",
    ".claude/skills/rikiki-debug"
  ],
  "scripts": {
    "build": "node build-vendor.mjs && node build.mjs && node build-standalone.mjs && node build-types.mjs",
    "vendor": "node build-vendor.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "bundle": "node bundle.mjs",
    "examples": "node scripts/rebuild-examples.mjs",
    "readme": "node scripts/build-readme.mjs",
    "deck": "node bin/rikiki.mjs assemble",
    "deck:example": "node bin/rikiki.mjs assemble decks/example/deck.config.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "release:smoke": "node scripts/release-smoke.mjs",
    "lint": "biome check src scripts tools",
    "format": "biome format --write src scripts tools",
    "bump": "node scripts/bump-version.mjs",
    "new:component": "node scripts/new-component.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.24.0",
    "lit": "^3.3.3",
    "marked": "^12.0.2",
    "mermaid": "^10.9.8",
    "rolldown": "^1.1.1",
    "shiki": "^1.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "lit": "^3.3.3",
    "playwright": "^1.60.0",
    "rolldown": "^1.1.1"
  },
  "keywords": [
    "lit",
    "web-components",
    "presentation",
    "slides",
    "deck",
    "rikiki"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "rolldown": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
