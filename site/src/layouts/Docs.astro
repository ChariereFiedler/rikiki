---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}
const { title, description, eyebrow } = Astro.props;
const pageTitle = `${title} · Rikiki docs`;
---

<Base title={pageTitle} description={description}>
  <Nav />
  <div class="layout">
    <Sidebar />
    <main class="content">
      <article>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {description && <p class="lede">{description}</p>}
        <slot />
      </article>
    </main>
    <aside class="toc" aria-label="On this page">
      <p class="toc-head">On this page</p>
      <ul id="toc-list"></ul>
    </aside>
  </div>
  <Footer />
</Base>

<script is:inline>
  // Auto-build the right-side TOC from h2[id] inside the article.
  (function () {
    const list = document.getElementById('toc-list');
    if (!list) return;
    const article = document.querySelector('.content > article');
    if (!article) return;
    const heads = article.querySelectorAll('h2[id], h3[id]');
    if (heads.length === 0) {
      const aside = list.closest('.toc');
      if (aside) aside.style.display = 'none';
      return;
    }

    // Make every h2/h3 with an id shareable · clicking the heading text
    // (or the # affordance) pushes `#id` into the URL without scrolling
    // the page (we let the native anchor jump do that when the user clicks
    // the rendered <a>, but the heading-click handler only updates the URL).
    heads.forEach((h) => {
      // Inject a real anchor link as the # affordance · keyboard-reachable,
      // copy-link friendly, and replaces the pure-CSS ::after we had.
      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = '#' + h.id;
      anchor.setAttribute('aria-label', 'Link to ' + (h.textContent || '').trim());
      anchor.textContent = '#';
      h.appendChild(anchor);

      // Click anywhere on the heading text also pushes the hash · this
      // makes copying the URL trivial without forcing users to hover-hunt
      // the small # badge.
      h.addEventListener('click', (e) => {
        if (e.target.closest('a')) return;          // let native anchor handle itself
        if (e.target.closest('code')) return;       // don't hijack code clicks
        const next = new URL(window.location.href);
        next.hash = '#' + h.id;
        history.pushState(null, '', next);
      });
      // Make the cursor signal the affordance.
      h.style.cursor = 'pointer';
    });

    heads.forEach((h) => {
      const li = document.createElement('li');
      li.className = h.tagName === 'H3' ? 'lvl-3' : 'lvl-2';
      const a = document.createElement('a');
      a.href = '#' + h.id;
      // textContent of h now includes our injected '#' anchor · strip it.
      const labelNode = h.cloneNode(true);
      labelNode.querySelectorAll('.heading-anchor').forEach((n) => n.remove());
      a.textContent = (labelNode.textContent || '').trim();
      li.appendChild(a);
      list.appendChild(li);
    });
    // Keep exactly one active entry. The heading nearest the reading line wins,
    // including while two long component sections overlap the viewport.
    const links = new Map();
    const sections = new Map();
    let currentSection = '';
    heads.forEach((h) => {
      if (h.tagName === 'H2') currentSection = h.id;
      sections.set(h.id, currentSection);
    });
    list.querySelectorAll('a').forEach((a) => {
      const id = a.getAttribute('href').slice(1);
      links.set(id, a);
    });
    let scheduled = false;
    const updateActive = () => {
      scheduled = false;
      const readingLine = 132;
      let current = heads[0];
      heads.forEach((h) => {
        if (h.getBoundingClientRect().top <= readingLine) current = h;
      });
      links.forEach((a, id) => a.classList.toggle('is-active', id === current.id));
      const active = links.get(current.id);
      active?.scrollIntoView({ block: 'nearest' });

      const sectionId = sections.get(current.id);
      document.querySelectorAll('.sidebar a[data-hash]').forEach((a) => {
        a.classList.toggle('active', Boolean(sectionId) && a.dataset.hash === sectionId);
      });
      if (sectionId) {
        document.querySelectorAll('.sidebar a:not([data-hash])').forEach((a) => {
          if (a.getAttribute('href') === location.pathname) a.classList.remove('active');
        });
      }
    };
    const schedule = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateActive);
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    updateActive();
  })();
</script>

<style is:global>
  /* Generic prose styles shared across docs articles */
  .content > article > h2 {
    font-family: var(--rik-font-display);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--rik-text-default);
    margin: var(--rik-space-6) 0 var(--rik-space-3);
    padding-bottom: var(--rik-space-2);
    border-bottom: 3px solid var(--rik-accent);
    display: inline-block;
    width: fit-content;
    scroll-margin-top: 80px;
  }
  .content > article > h3 {
    font-family: var(--rik-font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--rik-text-default);
    margin: var(--rik-space-5) 0 var(--rik-space-2);
    scroll-margin-top: 80px;
  }
  .content > article > p,
  .content > article > ul,
  .content > article > ol {
    font-size: var(--rik-font-size-body);
    line-height: 1.7;
    color: var(--rik-text-default--muted);
    margin: 0 0 var(--rik-space-3);
    max-width: 75ch;
  }
  .content > article ul,
  .content > article ol {
    padding-left: 1.4rem;
  }
  .content > article li { margin-bottom: 0.3rem; }
  .content > article strong { color: var(--rik-text-default); font-weight: 700; }
  .content > article a {
    color: var(--rik-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .content > article a:hover { text-decoration-thickness: 2px; }
  .content > article :not(pre) > code {
    font-family: var(--rik-font-mono);
    font-size: 0.92em;
    background: rgba(42, 37, 32, 0.06);
    color: var(--rik-text-default);
    padding: 2px 6px;
    border-radius: 5px;
  }
  .content > article pre code {
    background: transparent;
    color: inherit;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }
  /* Anchor link badge next to h2/h3 on hover · real <a>, injected by JS */
  .content > article h2[id], .content > article h3[id] { position: relative; }
  .content > article h2[id] .heading-anchor,
  .content > article h3[id] .heading-anchor {
    position: absolute; left: -1.2em; top: 0;
    color: var(--rik-text-default--faint);
    text-decoration: none;
    font-weight: 400;
    opacity: 0;
    transition: opacity 0.12s, color 0.12s;
  }
  .content > article h2[id]:hover .heading-anchor,
  .content > article h3[id]:hover .heading-anchor,
  .content > article .heading-anchor:focus-visible { opacity: 1; }
  .content > article .heading-anchor:hover { color: var(--rik-accent); }

  /* ── Right-side TOC ──────────────────────────────────────────────
     These rules sit in the `is:global` block because the <li>/<a>
     children are created at runtime by the inline script · Astro's
     scoped CSS adds a data-astro-cid-* selector that those dynamic
     nodes never receive, so a `<style>` rule would never match them. */
  .toc {
    position: sticky;
    top: 60px;
    align-self: start;
    padding: var(--rik-space-6) var(--rik-space-4) var(--rik-space-6) 0;
    max-height: calc(100vh - 60px);
    overflow-y: auto;
  }
  .toc .toc-head {
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rik-text-default--faint);
    margin: 0 0 var(--rik-space-3);
    padding-left: var(--rik-space-3);
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--rik-border-default);
  }
  .toc li { margin: 0; }
  .toc a {
    display: block;
    padding: 7px var(--rik-space-3);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--rik-text-default--muted);
    text-decoration: none;
    font-size: var(--rik-font-size-sm);
    line-height: 1.4;
    transition: color 0.12s, border-color 0.12s, background 0.12s;
  }
  .toc a:hover {
    color: var(--rik-text-default);
    text-decoration: none;
    background: rgba(42, 37, 32, 0.04);
  }
  .toc a.is-active {
    color: var(--rik-accent);
    border-left-color: var(--rik-accent);
    background: rgba(240, 112, 32, 0.06);
    font-weight: 700;
  }
  .toc .lvl-3 a {
    padding-left: var(--rik-space-5);
    font-size: 0.82rem;
    color: var(--rik-text-default--faint);
  }
</style>

<style>
  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 220px;
    max-width: 1440px;
    margin: 0 auto;
    min-height: calc(100vh - 60px);
  }
  .content {
    padding: var(--rik-space-6) var(--rik-space-6);
    max-width: 920px;
    min-width: 0;
  }
  /* TOC styles live in the is:global block above (dynamic <li>/<a>). */
  article > .eyebrow {
    display: table;
    padding: 4px 10px;
    background: var(--rik-accent);
    color: var(--rik-surface-inverse);
    border-radius: var(--rik-radius-pill);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 var(--rik-space-3);
  }
  article > h1 {
    font-family: var(--rik-font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--rik-text-default);
    margin-bottom: var(--rik-space-3);
  }
  article > .lede {
    font-size: var(--rik-font-size-lead);
    line-height: 1.55;
    color: var(--rik-text-default--faint);
    max-width: 70ch;
    margin: 0 0 var(--rik-space-5);
  }
  @media (max-width: 1180px) {
    .layout { grid-template-columns: 240px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 920px) {
    .layout { grid-template-columns: 1fr; }
    .content { padding: var(--rik-space-4); }
  }
  @media (max-width: 480px) {
    /* Phones · tighten article padding further so prose has breathing room. */
    .content { padding: var(--rik-space-3); }
    article > h1 { font-size: clamp(1.7rem, 7vw, 2.2rem); }
  }
</style>
