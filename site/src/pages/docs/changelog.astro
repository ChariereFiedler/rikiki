---
// The changelog is not retyped here: CHANGELOG.md in the repository is read at
// build time and rendered by src/lib/changelog.mjs, so the page cannot drift
// from the file the release process writes. Every size figure quoted below
// comes from that file too.
import { resolve } from 'node:path';
import Docs from '../../layouts/Docs.astro';
import { renderChangelogFile } from '../../lib/changelog.mjs';

const changelog = renderChangelogFile(resolve(process.cwd(), '../CHANGELOG.md'));
---

<Docs
  title="Changelog"
  eyebrow="Reference"
  description="For anyone upgrading or deciding whether to adopt: what each release changed and what is merged but not yet released, rendered from CHANGELOG.md so it cannot drift. The format follows Keep a Changelog and the project follows semver."
>

<p class="source-note">
  The <strong>Unreleased</strong> section below lists what is merged and not yet
  published to npm. Everything under a dated heading ships in that release.
</p>

<Fragment set:html={changelog} />

