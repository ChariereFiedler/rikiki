<style>
  /* Aerated layout · one component per "page-break" block, generous padding,
     subtle alternating background to separate sections at a glance. */
  .comp {
    padding: var(--rik-space-6) 0 var(--rik-space-7);
    border-bottom: 1px solid var(--rik-border-default);
  }
  .comp:last-child { border-bottom: none; }
  .comp h3 {
    margin: 0 0 var(--rik-space-3);
    font-size: 1.4rem !important;
  }
  .comp h3 code {
    background: var(--rik-accent--faint) !important;
    color: var(--rik-text-default) !important;
    padding: 4px 10px !important;
    border-radius: var(--rik-radius-sm) !important;
    font-size: 0.95em !important;
  }
  .summary {
    color: var(--rik-text-default--muted);
    font-size: var(--rik-font-size-lead);
    line-height: 1.6;
    margin: 0 0 var(--rik-space-5);
    max-width: 70ch;
  }
  .comp > * {
    margin-top: var(--rik-space-4);
  }
  .comp > h3 { margin-top: 0; }

  /* Small heading above each sub-block for scannability */
  .comp .block-head {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rik-text-default--faint);
    margin: var(--rik-space-5) 0 var(--rik-space-2);
  }

  table.attrs {
    width: 100%; max-width: 720px;
    border-collapse: collapse;
    margin: 0 0 var(--rik-space-3);
    font-size: var(--rik-font-size-md);
  }
  table.attrs th, table.attrs td {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid var(--rik-border-default);
    vertical-align: top;
  }
  table.attrs th {
    background: var(--rik-surface-raised);
    color: var(--rik-text-default--muted);
    font: 700 var(--rik-font-size-sm)/1.2 var(--rik-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  table.attrs td code {
    background: rgba(42, 37, 32, 0.06);
    padding: 1px 5px;
    border-radius: 3px;
  }
  table.attrs td:first-child code {
    color: var(--rik-accent--strong);
    background: var(--rik-accent--faint);
  }
  table.attrs td:nth-child(2) code {
    color: #067a64;
    background: rgba(0, 200, 160, .10);
    border: 1px solid rgba(0, 200, 160, .22);
  }
  table.optional {
    width: 100%;
    border-collapse: collapse;
    margin: var(--rik-space-4) 0 var(--rik-space-6);
  }
  table.optional th,
  table.optional td {
    padding: 12px 14px;
    text-align: left;
    border-bottom: 1px solid var(--rik-border-default);
    vertical-align: top;
  }
  table.optional th {
    color: var(--rik-text-default--muted);
    font: 700 var(--rik-font-size-sm)/1.2 var(--rik-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  table.optional td:first-child {
    width: 24%;
    color: var(--rik-text-default);
    font-weight: 700;
  }
  /* A child element is documented inside its module's entry · indented behind
     a rule so the reader can see it belongs to the element above it. */
  .child-comp {
    margin-top: var(--rik-space-5);
    padding-left: var(--rik-space-4);
    border-left: 2px solid var(--rik-border-default);
  }
  .child-comp h4 {
    margin: 0 0 var(--rik-space-2);
    font-size: 1.1rem;
  }
  .child-comp h4 code {
    background: var(--rik-accent--faint);
    color: var(--rik-text-default);
    padding: 3px 8px;
    border-radius: var(--rik-radius-sm);
  }
  .child-comp .summary { margin-bottom: var(--rik-space-3); }
  .module-path { margin: 0; }
  .module-path code { color: var(--rik-accent--strong); }
  .optional-details {
    display: grid;
    gap: 0;
    margin: var(--rik-space-4) 0;
    border-top: 1px solid var(--rik-border-default);
  }
  .optional-details > div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: var(--rik-space-3);
    padding: var(--rik-space-3) 0;
    border-bottom: 1px solid var(--rik-border-default);
  }
  .optional-details dt {
    color: var(--rik-text-default--muted);
    font: 700 var(--rik-font-size-xs)/1.4 var(--rik-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .optional-details dd {
    min-width: 0;
    margin: 0;
    color: var(--rik-text-default--muted);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .detail-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .detail-chips li { min-width: 0; }
  .detail-chips code {
    display: inline-block;
    max-width: 100%;
    padding: 5px 8px;
    border: 1px solid var(--rik-border-default);
    border-radius: var(--rik-radius-sm);
    background: var(--rik-surface-raised);
    color: var(--rik-text-default);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .tokens-list code {
    color: var(--rik-accent--strong);
    background: var(--rik-accent--faint);
    border-color: transparent;
  }
  .bento-guide {
    max-width: 760px;
    padding: var(--rik-space-4);
    border-left: 4px solid var(--rik-status-success);
    background: var(--rik-surface-raised);
    color: var(--rik-text-default--muted);
  }
  .bento-guide strong {
    display: block;
    margin-bottom: var(--rik-space-2);
    color: var(--rik-text-default);
    font-family: var(--rik-font-display);
    font-size: 1.25rem;
  }
  .bento-guide p { margin: var(--rik-space-2) 0 0; line-height: 1.6; }
  .bento-guide code { color: var(--rik-text-default); }
  @media (max-width: 640px) {
    table.optional th,
    table.optional td {
      padding: 10px 8px;
      font-size: var(--rik-font-size-sm);
    }
    table.optional td:first-child { width: auto; }
    .optional-details > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
  p.tokens {
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-default--faint);
    margin: var(--rik-space-3) 0 0;
  }
  p.tokens code {
    background: rgba(240, 112, 32, 0.10);
    color: var(--rik-text-default);
    padding: 1px 6px;
    border-radius: 3px;
  }
</style>

</Docs>
