---
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import Docs from '../../layouts/Docs.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ComponentPreview from '../../components/ComponentPreview.astro';
import TokenReference from '../../components/TokenReference.astro';

// How many elements the default bundle registers, and how many stay opt-in ·
// read from src/index.ts by scripts/component-surfaces.mjs rather than typed
// here. Loaded through a runtime file URL so Vite leaves the module out of the
// prerender bundle: it locates the package from its own import.meta.url.
const componentSurfaces = pathToFileURL(
  resolve(process.cwd(), '../rikiki/scripts/component-surfaces.mjs'),
).href;
const { coreElements, optInElements } = await import(/* @vite-ignore */ componentSurfaces);
const coreCount = coreElements().length;
const optInCount = optInElements().length;

const layoutTags = new Set(['deck-cover', 'deck-section', 'deck-feature', 'deck-split', 'deck-feature-cards', 'deck-takeaway', 'deck-photo', 'deck-bento']);

interface Component {
  tag: string;
  summary: string;
  attrs?: { name: string; type: string; note?: string }[];
  slots?: { name: string; note: string }[];
  example: string;
  tokens?: string[];
}

function parseItems(value: string) {
  return value.split(' · ').map((item) => {
    const colon = item.indexOf(':');
    return colon < 0
      ? { name: item.trim(), value: 'boolean' }
      : { name: item.slice(0, colon).trim(), value: item.slice(colon + 1).trim() };
  });
}

const layouts: Component[] = [
  {
    tag: 'deck-cover',
    summary: 'Opening slide · XL title on dark, optional brand mark, meta block.',
    attrs: [
      { name: 'brand',       type: 'string',  note: 'Text label · split on " · " (first segment = brand name)' },
      { name: 'brand-src',   type: 'URL',     note: 'Optional logo path' },
      { name: 'speaker',     type: 'string' },
      { name: 'company',     type: 'string' },
      { name: 'company-src', type: 'URL',     note: 'Optional client logo · shown before the company name' },
      { name: 'duration',    type: 'string' },
      { name: 'audience',    type: 'string' },
      { name: 'runtime',     type: 'string' },
      { name: 'speaker-label',  type: 'string', note: 'Override the meta label · the default follows the document language' },
      { name: 'company-label',  type: 'string' },
      { name: 'duration-label', type: 'string' },
      { name: 'audience-label', type: 'string' },
      { name: 'runtime-label',  type: 'string' },
    ],
    slots: [
      { name: '(default)', note: 'Title (h1) and subtitle (.sub)' },
    ],
    example: `<deck-cover brand="rikiki · docs" speaker="Jane">
  <h1>Hello, <span class="accent">world</span>.</h1>
  <p class="sub">Sub-title or opening question.</p>
</deck-cover>`,
    tokens: ['--deck-cover-bg', '--deck-cover-text', '--deck-cover-soft', '--deck-cover-muted', '--deck-cover-faint', '--deck-cover-border'],
  },
  {
    tag: 'deck-section',
    summary: 'Chapter separator · number + centered title on dark. Marks a 2D-nav boundary.',
    attrs: [{ name: 'num', type: 'string', note: 'Small label above the title' }],
    slots: [{ name: '(default)', note: 'Title (h1)' }],
    example: `<deck-section num="02">
  <h1>Anatomy</h1>
</deck-section>`,
    tokens: ['--deck-section-bg', '--deck-section-num-color', '--deck-section-title-color', '--deck-section-em-color', '--deck-section-rule-color'],
  },
  {
    tag: 'deck-feature',
    summary: 'One focal block · code, table, mermaid, big stat.',
    attrs: [
      { name: 'eyebrow', type: 'string', note: 'Small pill above the title' },
      { name: 'spread',  type: 'between | around | evenly | center | end | start', note: 'How the leftover vertical space of the body is distributed · default start' },
      { name: 'fill',    type: 'boolean', note: 'Let the body blocks take the leftover height instead · pair with a <deck-fit> child' },
    ],
    slots: [
      { name: 'title', note: 'h1' },
      { name: 'lead',  note: 'one-line intro' },
      { name: '(default)', note: 'The focal block · usually deck-code, deck-mermaid, or a custom widget' },
    ],
    example: `<deck-feature eyebrow="Module">
  <h1 slot="title">Side effects</h1>
  <p slot="lead" class="lead">A module can act on import.</p>
  <deck-code lang="ts" hero>
    import './polyfill';
  </deck-code>
</deck-feature>`,
    tokens: ['--deck-eyebrow-bg', '--deck-eyebrow-color', '--deck-eyebrow-radius', '--deck-eyebrow-padding-x', '--deck-eyebrow-padding-y'],
  },
  {
    tag: 'deck-split',
    summary: 'Two or three columns of cards.',
    attrs: [
      { name: 'cols',    type: '"1-1" | "1-2" | "2-1" | "3"', note: 'Default 1-1' },
      { name: 'gap',     type: '1..6',                        note: 'maps to var(--rik-space-N)' },
      { name: 'col-gap', type: '1..6',                        note: 'gap between children inside a column' },
      { name: 'eyebrow', type: 'string',                      note: 'Small pill above the title' },
      { name: 'spread',  type: 'between | around | evenly | center | end | start', note: 'How the leftover vertical space of the body is distributed · default start' },
      { name: 'fill',    type: 'boolean',                     note: 'Let the body blocks take the leftover height instead' },
      { name: 'pivot',   type: 'string',                      note: 'Symbol or word drawn between the two columns · turns a neutral split into a directed comparison. Two columns only' },
      { name: 'winner',  type: 'left | right',                note: 'Which side carries the accent rule · absent for neither' },
    ],
    slots: [
      { name: 'title / lead', note: 'header above the columns' },
      { name: 'left / right', note: '2-col layout' },
      { name: 'a / b / c',    note: '3-col layout' },
    ],
    example: `<deck-split cols="1-1">
  <h1 slot="title">Two takes</h1>
  <deck-card slot="left" color="red">Problem</deck-card>
  <deck-card slot="right" color="green">Fix</deck-card>
</deck-split>`,
    tokens: ['--deck-split-gap', '--deck-split-col-gap', '--deck-eyebrow-bg', '--deck-eyebrow-color'],
  },
  {
    tag: 'deck-feature-cards',
    summary: 'Hero on top, two detail cards underneath.',
    attrs: [{ name: 'eyebrow', type: 'string' }],
    slots: [
      { name: 'title / lead', note: 'header' },
      { name: '(default)',    note: 'the hero block · usually deck-code or deck-mermaid' },
      { name: 'left / right', note: 'the two detail cards' },
    ],
    example: `<deck-feature-cards eyebrow="Deep dive">
  <h1 slot="title">One thing at a time</h1>
  <deck-code lang="ts" hero>function run() { return 42; }</deck-code>
  <deck-card slot="left">What changes</deck-card>
  <deck-card slot="right">What stays</deck-card>
</deck-feature-cards>`,
    tokens: ['--deck-feature-cards-gap', '--deck-feature-cards-col-gap', '--deck-feature-cards-hero-flex', '--deck-feature-cards-detail-flex', '--deck-eyebrow-bg', '--deck-eyebrow-color'],
  },
  {
    tag: 'deck-takeaway',
    summary: 'Centered punchline on dark · the take-home line.',
    attrs: [
      { name: 'kicker', type: 'string', note: 'Small caption above the punch' },
      { name: 'spread', type: 'between | around | evenly | center | end | start', note: 'How the leftover vertical space of the body is distributed · default start' },
      { name: 'fill',   type: 'boolean', note: 'Let the body blocks take the leftover height instead' },
    ],
    slots: [{ name: '(default)', note: 'Use <deck-punch size="display"> for the big text' }],
    example: `<deck-takeaway kicker="The whole point">
  <deck-punch size="display">Source = output.</deck-punch>
  <p class="caption on-dark">A deck is a folder.</p>
</deck-takeaway>`,
    tokens: ['--deck-takeaway-bg', '--deck-takeaway-display-color', '--deck-takeaway-caption-color', '--deck-takeaway-gap'],
  },
  {
    tag: 'deck-photo',
    summary: 'Full-bleed image slide · slotted content sits on a dimmable overlay. Cover-style hero or mood section break.',
    attrs: [
      { name: 'src',        type: 'URL',                          note: 'Image URL · required' },
      { name: 'position',   type: 'CSS object-position',          note: 'Default "center"' },
      { name: 'darken',     type: '0..1',                         note: 'Overlay alpha · default 0.35' },
      { name: 'align',      type: 'top | center | bottom',        note: 'Vertical alignment of slotted content' },
      { name: 'text-align', type: 'left | center | right',        note: 'Text alignment inside the overlay · default left' },
    ],
    slots: [
      { name: '(default)', note: 'Title (h1), subtitle (.sub), or any HTML to overlay on the image' },
    ],
    example: `<deck-photo src="/component-photo.svg" darken="0.4" align="center">
  <h1>Mood opener</h1>
  <p class="sub">One line caption.</p>
</deck-photo>`,
    tokens: ['--deck-photo-overlay-color', '--deck-photo-text-color', '--deck-photo-text-muted', '--deck-photo-content-max-width', '--deck-photo-padding-x', '--deck-photo-padding-y'],
  },
  {
    tag: 'deck-bento',
    summary: 'Bento grid slide · cells share a multi-row, multi-column canvas.',
    attrs: [
      { name: 'eyebrow', type: 'string' },
      { name: 'cols',    type: '1..12 | template', note: 'default 2' },
      { name: 'rows',    type: '1..12 | template', note: 'default 1 full-height row' },
      { name: 'gap',     type: '1..6 | CSS length', note: 'default 3' },
      { name: 'align',   type: 'start | center | end | stretch', note: 'align-items on every cell' },
      { name: 'justify', type: 'start | center | end | stretch', note: 'justify-items on every cell' },
    ],
    slots: [
      { name: 'title', note: 'Slide title (<h1>)' },
      { name: '(default)', note: 'deck-point children for words, deck-cell for anything measured' },
    ],
    example: `<deck-bento eyebrow="Layout" cols="3" rows="2">
  <h1 slot="title">Cells share the space</h1>
  <deck-cell col="1 / 3" row="1"><deck-punch fit>Measured</deck-punch></deck-cell>
  <deck-cell col="3 / 4" row="1 / 3" tone="info"><h3>Tall</h3><p>Two rows.</p></deck-cell>
  <deck-point col="1 / 2" row="2 / 3" tone="ok"><h3>A</h3><p>Placed explicitly.</p></deck-point>
  <deck-point col="2 / 3" row="2 / 3" tone="warn"><h3>B</h3><p>No grid ambiguity.</p></deck-point>
</deck-bento>`,
    tokens: ['--deck-bento-gap'],
  },
];

// Ordered by theme rather than by source folder · text first (what a slide
// says), then data (what it proves), then structure (how the slide is laid
// out), then media (what it embeds). An author scanning for "the thing that
// shows a number" reads one run of entries instead of the whole list.
const atoms: Component[] = [
  // ── Text ──────────────────────────────────────────────────────
  {
    tag: 'deck-md',
    summary: 'Markdown body · GFM, tables, lists, code, **bold**, *italic*.',
    example: `<deck-md>
  **Markdown** body with \`inline code\`, lists, and links.
</deck-md>`,
    tokens: ['--deck-md-pre-bg', '--deck-md-pre-border', '--deck-md-pre-text'],
  },
  {
    tag: 'deck-punch',
    summary: 'Big punchline text · sized via attribute, color via tone.',
    attrs: [
      { name: 'size',    type: 'lead | big | mega | stat | display' },
      { name: 'tone',    type: 'warn | danger | ok | info | muted | accent' },
      { name: 'weight',  type: '700 | 800 | 900' },
      { name: 'align',   type: 'left | center | right' },
      { name: 'fit',     type: 'boolean', note: 'Shrink to fit the box · overrides size and the fluid cqw scaling' },
      { name: 'fit-min', type: 'rem',     note: 'Fit floor · default 1' },
      { name: 'fit-max', type: 'rem',     note: 'Fit ceiling · default 12' },
    ],
    example: `<deck-punch size="display">Source = output.</deck-punch>`,
    tokens: ['--deck-punch-color', '--deck-punch-size'],
  },
  {
    tag: 'deck-fit',
    summary: 'Shrink slotted text to fit its box by font-size · not for images.',
    attrs: [
      { name: 'min', type: 'rem', note: 'default 1' },
      { name: 'max', type: 'rem', note: 'default 12' },
    ],
    example: `<deck-fit max="6">
  A line that shrinks until it fits its cell.
</deck-fit>`,
  },
  {
    tag: 'deck-kicker',
    summary: 'Caption-style label above a section · uppercase, mono.',
    attrs: [
      { name: 'on-dark', type: 'boolean', note: 'Switch to the inverse-surface palette · use on dark backgrounds' },
    ],
    example: `<deck-kicker>Before</deck-kicker>`,
    tokens: ['--deck-kicker-color', '--deck-kicker-on-dark-color', '--deck-kicker-font-size', '--deck-kicker-tracking', '--deck-kicker-margin'],
  },
  {
    tag: 'deck-badge',
    summary: 'Status pill · bad / ok / info / warn / neutral.',
    attrs: [{ name: 'type', type: 'bad | ok | info | warn | neutral' }],
    example: `<deck-badge type="ok">production-ready</deck-badge>`,
    tokens: ['--deck-badge-bg', '--deck-badge-fg', '--deck-badge-border', '--deck-badge-radius', '--deck-badge-padding-x', '--deck-badge-padding-y'],
  },
  {
    tag: 'deck-kbd',
    summary: 'One keyboard key chip · inline anywhere in body text, and the piece <deck-shortcut> draws its keys from.',
    attrs: [
      { name: 'tone', type: 'accent | ok', note: 'Paint the chip when one key in a run deserves the emphasis' },
    ],
    slots: [{ name: '(default)', note: 'The key name · Esc, ⌘, PgDn' }],
    example: `<p>Press <deck-kbd>P</deck-kbd> to open the presenter window.</p>`,
    tokens: ['--deck-kbd-bg', '--deck-kbd-color', '--deck-kbd-border', '--deck-kbd-radius', '--deck-kbd-padding-x', '--deck-kbd-padding-y', '--deck-kbd-accent-bg', '--deck-kbd-ok-bg'],
  },
  {
    tag: 'deck-callout',
    summary: 'Boxed note with icon · info / warn / danger / ok.',
    attrs: [
      { name: 'type',    type: 'info | warn | danger | ok' },
      { name: 'on-dark', type: 'boolean', note: 'Readable surface and inverse text inside a dark layout' },
    ],
    example: `<deck-callout type="warn">
  <strong>Heads up ·</strong> this changes the public API.
</deck-callout>`,
    tokens: ['--deck-callout-bg', '--deck-callout-border', '--deck-callout-stroke', '--deck-callout-radius', '--deck-callout-padding-x', '--deck-callout-padding-y', '--deck-callout-color', '--deck-callout-strong-color', '--deck-callout-code-bg'],
  },
  {
    tag: 'deck-notes',
    summary: 'Speaker notes for a slide · hidden by default, surfaced in the presenter window (press P). Free-form text content.',
    slots: [
      { name: '(default)', note: 'Plain text or markup · displayed as-is in the presenter window' },
    ],
    example: `<deck-feature>
  <h1 slot="title">My slide</h1>
  <deck-notes>
    Talking points:
    - Mention the migration story
    - Pause for laughter on the Java joke
  </deck-notes>
</deck-feature>`,
  },

  // ── Data ──────────────────────────────────────────────────────
  {
    tag: 'deck-stat',
    summary: 'Big-number visual · for promises, metrics, milestones.',
    attrs: [
      { name: 'num',     type: 'string',                      note: 'Huge display-font number' },
      { name: 'tone',    type: 'yellow|orange|green|red|purple|lime|cyan' },
      { name: 'compact', type: 'boolean',                     note: 'Smaller scale, for a row of stats rather than one hero figure' },
    ],
    slots: [
      { name: 'claim',     note: 'Mid-size headline below the number' },
      { name: '(default)', note: 'One line of body text' },
    ],
    example: `<deck-stat num="01" tone="orange">
  <h3 slot="claim">Serve a folder</h3>
  No build, no toolchain.
</deck-stat>`,
    tokens: ['--deck-stat-color', '--deck-stat-num-size', '--deck-stat-num-weight', '--deck-stat-claim-color', '--deck-stat-body-color', '--deck-stat-border-width', '--deck-stat-padding-x', '--deck-stat-padding-y', '--deck-stat-gap'],
  },
  {
    tag: 'deck-metric',
    summary: 'One-line metric · label + value · severity colored. Wrap several in <deck-metric-list> for the rule-divided list look.',
    attrs: [
      { name: 'value',    type: 'string' },
      { name: 'severity', type: 'bad | warn | ok | info' },
      { name: 'mono',     type: 'boolean' },
    ],
    example: `<deck-metric-list>
  <deck-metric value="5"  severity="bad">Files parsed</deck-metric>
  <deck-metric value="1"  severity="ok">Used</deck-metric>
</deck-metric-list>`,
    tokens: ['--deck-metric-bg', '--deck-metric-border', '--deck-metric-text', '--deck-metric-radius', '--deck-metric-padding-x', '--deck-metric-padding-y', '--deck-metric-shadow', '--deck-metric-label-color', '--deck-metric-value-{bad,warn,ok,info}'],
  },
  {
    tag: 'deck-metric-list',
    summary: 'Container · rule dividers between stacked <deck-metric> rows. No attributes · purely a layout grouping.',
    example: `<deck-metric-list>
  <deck-metric value="5"  severity="bad">Files parsed</deck-metric>
  <deck-metric value="1"  severity="ok">Used</deck-metric>
</deck-metric-list>`,
  },
  {
    tag: 'deck-csv',
    summary: 'Inline CSV rendered as a styled table · cells are trimmed.',
    attrs: [
      { name: 'delimiter',      type: 'string',  note: 'default ","' },
      { name: 'no-header',      type: 'boolean', note: 'first row is data' },
      { name: 'fit',            type: 'boolean', note: 'shrink the table to fit its box' },
      { name: 'fit-min',        type: 'rem',     note: 'default 0.6' },
      { name: 'fit-max',        type: 'rem',     note: 'default 2' },
      { name: 'highlight-rows', type: 'string',  note: '1-based body rows to emphasise · "2" or "2 5"' },
      { name: 'highlight-cols', type: 'string',  note: '1-based columns to emphasise · same grammar' },
      { name: 'reveal',         type: 'boolean', note: 'show one body row per step instead of the whole table' },
    ],
    example: `<deck-csv delimiter=";" highlight-rows="2" fit>
  Region; Users; Plan
  EMEA; 12 040; Pro
  APAC; 9 310; Pro
</deck-csv>`,
    tokens: ['--deck-csv-border', '--deck-csv-header-bg', '--deck-csv-padding-x', '--deck-csv-padding-y'],
  },
  {
    tag: 'deck-tier-list',
    summary: 'Tier ladder · stacks <deck-tier> rows for JIT levels, severity ladders, ranking. No attributes · the rows carry the data.',
    example: `<deck-tier-list>
  <deck-tier name="LLInt" speed="×1">Bytecode</deck-tier>
  <deck-tier name="FTL"   speed="×100" hot>LLVM</deck-tier>
</deck-tier-list>`,
  },
  {
    tag: 'deck-tier',
    summary: 'One tier of a <deck-tier-list> · name on the left, speed on the right, description in the default slot.',
    attrs: [
      { name: 'name',     type: 'string', note: 'Left-hand label, in the mono face' },
      { name: 'speed',    type: 'string', note: 'Right-side figure · free text, not only a number' },
      { name: 'severity', type: 'muted | warn | ok', note: 'Colors the speed figure' },
      { name: 'hot',      type: 'boolean', note: 'Marks the top tier · tints the row and the figure with the accent' },
    ],
    slots: [{ name: '(default)', note: 'Description line under the name' }],
    example: `<deck-tier-list>
  <deck-tier name="LLInt" speed="×1"   severity="muted">Bytecode interpreter</deck-tier>
  <deck-tier name="DFG"   speed="×8"   severity="ok">Optimizing JIT</deck-tier>
  <deck-tier name="FTL"   speed="×100" hot>Top-tier JIT</deck-tier>
</deck-tier-list>`,
    tokens: ['--deck-tier-bg', '--deck-tier-border', '--deck-tier-radius', '--deck-tier-padding-x', '--deck-tier-padding-y', '--deck-tier-shadow', '--deck-tier-name-color', '--deck-tier-desc-color', '--deck-tier-speed-{muted,warn,ok}', '--deck-tier-hot-bg', '--deck-tier-hot-border', '--deck-tier-hot-color'],
  },
  {
    tag: 'deck-tier-arrow',
    summary: 'Separator note between two tiers of a deck-tier-list.',
    example: `<deck-tier-list>
  <deck-tier name="S" speed="×1">Ships today</deck-tier>
  <deck-tier-arrow>after ~6 runs</deck-tier-arrow>
  <deck-tier name="A" speed="×10">Ships next</deck-tier>
</deck-tier-list>`,
  },
  {
    tag: 'deck-step-list',
    summary: 'Numbered steps · stacks <deck-step> rows, or chains them across the width.',
    attrs: [
      { name: 'direction',     type: 'column | row', note: 'default column · row lays the steps as a chain across the width' },
      { name: 'no-connectors', type: 'boolean',      note: 'Drop the connector drawn between steps in row direction' },
    ],
    slots: [{ name: '(default)', note: '<deck-step> children' }],
    example: `<deck-step-list>
  <deck-step n="1" note="opens the deck">Cover</deck-step>
  <deck-step n="2" note="chapter break">Section</deck-step>
</deck-step-list>`,
    tokens: ['--deck-step-list-gap', '--deck-step-list-connector', '--deck-step-list-arrow'],
  },
  {
    tag: 'deck-step',
    summary: 'One step of a <deck-step-list> · number, label, and the note that explains it.',
    attrs: [
      { name: 'n',             type: 'string',          note: 'Number or letter carrying the sequence' },
      { name: 'note',          type: 'string',          note: 'Supporting explanation, read after the label' },
      { name: 'note-position', type: 'inline | below',  note: 'default inline · below puts the note under its label, which keeps a row of steps readable' },
    ],
    slots: [{ name: '(default)', note: 'The step label' }],
    example: `<deck-step-list direction="row">
  <deck-step n="1" note="What the check measures" note-position="below">Inspect</deck-step>
  <deck-step n="2" note="What it writes" note-position="below">Report</deck-step>
</deck-step-list>`,
    tokens: ['--deck-step-rule', '--deck-step-padding-y', '--deck-step-num-color', '--deck-step-num-size', '--deck-step-num-scale', '--deck-step-label-color', '--deck-step-note-color', '--deck-step-note-gap'],
  },
  {
    tag: 'deck-shortcut-list',
    summary: 'Two-column grid of <deck-shortcut> rows, with a separator line under each.',
    attrs: [
      { name: 'cols',    type: 'string', note: 'Set to "1" for a single column · the default is two' },
      { name: 'col-gap', type: '1..6',   note: 'Space between the two columns' },
    ],
    slots: [{ name: '(default)', note: '<deck-shortcut> children' }],
    example: `<deck-shortcut-list cols="1" col-gap="4">
  <deck-shortcut keys="O" label="Overview" note="Path layout"></deck-shortcut>
  <deck-shortcut keys="?" label="Help" note="Full shortcut overlay"></deck-shortcut>
</deck-shortcut-list>`,
  },
  {
    tag: 'deck-shortcut',
    summary: 'Keyboard shortcut row · keys + label + note. Pairs with <deck-shortcut-list>.',
    attrs: [
      { name: 'keys',  type: 'string', note: 'Space-separated · e.g. "Space PgDn"' },
      { name: 'label', type: 'string' },
      { name: 'note',  type: 'string', note: 'Falls back to the default slot when absent' },
      { name: 'tone',  type: 'accent | ok', note: 'Paints the keys of this row' },
    ],
    slots: [{ name: '(default)', note: 'The note, when it is richer than a string attribute' }],
    example: `<deck-shortcut-list>
  <deck-shortcut keys="O" label="Overview" note="Path layout"></deck-shortcut>
  <deck-shortcut keys="?" label="Help" note="Full shortcut overlay" tone="accent"></deck-shortcut>
</deck-shortcut-list>`,
  },

  // ── Structure ─────────────────────────────────────────────────
