---
import Docs from '../../layouts/Docs.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ComponentPreview from '../../components/ComponentPreview.astro';

const coverEx = `<deck-cover brand="my-talk · 2026" speaker="Jane">
  <h1>Hello, <span class="accent">world</span>.</h1>
  <p class="sub">A 12-min talk about the thing.</p>
</deck-cover>`;

const sectionEx = `<deck-section num="02">
  <h1>Why this matters</h1>
</deck-section>`;

const heroEx = `<deck-feature eyebrow="Module">
  <h1 slot="title">The whole point</h1>
  <p slot="lead" class="lead">One sentence that frames the slide.</p>
  <deck-code lang="ts" hero>
    const greet = (name: string) => \`Hello, \${name}\`;
  </deck-code>
</deck-feature>`;

const splitEx = `<deck-split cols="1-1">
  <h1 slot="title">Two takes</h1>
  <deck-card slot="left" color="red">
    <h3>Before</h3>
    <p>Bundler explodes.</p>
  </deck-card>
  <deck-card slot="right" color="green">
    <h3>After</h3>
    <p>Ship plain HTML.</p>
  </deck-card>
</deck-split>`;

const hookEx = `<deck-takeaway kicker="Take-home">
  <deck-punch size="display">Source = output.</deck-punch>
  <p class="caption on-dark">A deck is a folder.</p>
</deck-takeaway>`;

const sceneEx = `<deck-feature id="brief-to-slide">
  <h1 slot="title">From brief to verified slide</h1>
  <deck-scene-steps conclusion="Then look at it" conclusion-icon="flag">
    <deck-scene-item label="Say it" note="what the room must understand"></deck-scene-item>
    <deck-scene-item label="Write the items" note="words and numbers, no coordinates"></deck-scene-item>
    <deck-scene-item label="Check" emphasis tag="a few seconds"></deck-scene-item>
  </deck-scene-steps>
</deck-feature>`;

const fullDeckEx = `<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="rikiki/themes/rikiki.css">
  <script type="module" src="rikiki/dist/index.js"></script>
</head>
<body>
  <deck-root>
    ${coverEx}
    ${sectionEx}
    ${heroEx}
    ${splitEx}
    ${hookEx}
  </deck-root>
</body>
</html>`;
---

<Docs
  title="Cheatsheet · your first deck in 5 components"
  eyebrow="Getting started"
  description="The five elements you actually need for a 10-minute talk. Copy, paste, ship. Read the full Component library page later, when you know what to look for."
>

<p>
  Rikiki has 36 components but you do not need them on day one. Pick these
  five, give your talk, come back later for the rest. Each example below is
  self-contained · drop it inside <code>&lt;deck-root&gt;</code> in the order
  that fits your story.
</p>

<p>
  This page is for reading. An agent does not need it: it reads the
  <a href="/docs/components/">full catalogue</a> and the packaged reference
  instead, which carry every element rather than a starter set. See
  <a href="/docs/getting-started#agent">letting an agent do it</a>.
</p>

<h2 id="cover">1 · Cover</h2>
<p>The opening slide. Title, optional sub-title, optional brand + speaker. It comes first.</p>
<CodeBlock label="cover" lang="html" code={coverEx} />
<ComponentPreview code={coverEx} full />

<h2 id="section">2 · Section</h2>
<p>
  Use this every time you want a chapter break. With <code>nav="2d"</code> on
  <code>&lt;deck-root&gt;</code> it also tells the framework where the 2D
  navigation columns are · <kbd>←</kbd>/<kbd>→</kbd> jumps from one
  <code>&lt;deck-section&gt;</code> to the next, <kbd>↑</kbd>/<kbd>↓</kbd> walks
  the slides inside. Without it, arrows stay linear.
</p>
<CodeBlock label="section" lang="html" code={sectionEx} />
<ComponentPreview code={sectionEx} full />

<h2 id="hero">3 · Hero with code</h2>
<p>
  The workhorse · a title, a one-line lead, then one focal block (code,
  diagram, big number). Most body slides take this shape.
</p>
<CodeBlock label="hero" lang="html" code={heroEx} />
<ComponentPreview code={heroEx} full />

<h2 id="split">4 · Split for comparison</h2>
<p>
  Two columns · before / after, problem / fix, A / B. Pass <code>cols="1-1"</code>
  for equal columns or <code>"1-2"</code> for an asymmetric split.
</p>
<CodeBlock label="split" lang="html" code={splitEx} />
<ComponentPreview code={splitEx} full />

<h2 id="hook">5 · Hook for the punch line</h2>
<p>
  Close on a dark slide with one big sentence the audience leaves with. Use it
  once or twice per deck · it loses weight when it is everywhere.
</p>
<CodeBlock label="hook" lang="html" code={hookEx} />
<ComponentPreview code={hookEx} full />

<h2 id="ship">Putting it together</h2>
<p>
  That is a complete deck. Save it as <code>index.html</code>, serve the
  folder as in <a href="/docs/getting-started#serve">Getting started</a>,
  give the talk. Speaker notes go in a <code>&lt;deck-notes&gt;</code> inside
  a slide; pressing <kbd>P</kbd> opens a second window that shows them next to
  the current and next slide.
</p>
<CodeBlock label="my-talk/index.html" lang="html" code={fullDeckEx} />
<ComponentPreview code={`${coverEx}\n${sectionEx}\n${heroEx}\n${splitEx}\n${hookEx}`} full />

<h2 id="scenes">A picture for a slide</h2>
<p>
  When a slide needs an illustration, write what it says, not where it goes. A
  scene is an opt-in module (<code>rikiki/dist/deck-scene-*.js</code>) filled
  with <code>&lt;deck-scene-item&gt;</code> children; it measures every word in
  the slide's font and plays when the slide opens. One line each:
</p>
<ul>
  <li><a href="/docs/components#deck-scene-cards"><code>deck-scene-cards</code></a> · two to five options of the same rank, side by side.</li>
  <li><a href="/docs/components#deck-scene-steps"><code>deck-scene-steps</code></a> · things in order, with an optional closing band.</li>
  <li><a href="/docs/components#deck-scene-flow"><code>deck-scene-flow</code></a> · several inputs into one hub, and one or two outcomes.</li>
  <li><a href="/docs/components#deck-scene-bars"><code>deck-scene-bars</code></a> · up to eight things compared by one number each.</li>
  <li><a href="/docs/components#deck-scene-matrix"><code>deck-scene-matrix</code></a> · who stands where, in what state.</li>
  <li><a href="/docs/components#deck-scene-ranges"><code>deck-scene-ranges</code></a> · how long each takes, on one scale.</li>
  <li><a href="/docs/components#deck-scene-lanes"><code>deck-scene-lanes</code></a> · what happens to the same traffic when one thing changes.</li>
  <li><a href="/docs/components#deck-scene-units"><code>deck-scene-units</code></a> · a share of a crowd, one cell per person.</li>
</ul>
<CodeBlock label="steps" lang="html" code={sceneEx} />
<p>
  <code>npx rikiki scene plan brief.json</code> picks the shape for you, and
  <code>npx rikiki check talk.html --slides 7</code> measures only that slide.
  For a picture that demonstrates something, see
  <a href="/docs/components#deck-diagram"><code>&lt;deck-diagram&gt;</code></a>.
</p>

<h2 id="next">Next</h2>
<p>When you outgrow these five:</p>
<ul>
  <li><a href="/docs/anatomy">Anatomy of a slide</a> · the three layers every slide is built from.</li>
  <li>For a callout / warning box · <a href="/docs/components#deck-callout"><code>&lt;deck-callout&gt;</code></a></li>
  <li>For a big metric on the cover · <a href="/docs/components#deck-stat"><code>&lt;deck-stat&gt;</code></a></li>
  <li>For markdown body text · <a href="/docs/components#deck-md"><code>&lt;deck-md&gt;</code></a></li>
  <li>For a flowchart · <a href="/docs/components#deck-mermaid"><code>&lt;deck-mermaid&gt;</code></a></li>
  <li>For speaker notes and the presenter window · <a href="/docs/components#deck-notes"><code>&lt;deck-notes&gt;</code></a>, then <a href="/docs/navigation#presenter">press <kbd>P</kbd></a></li>
  <li>The full reference · <a href="/docs/components">Component library</a></li>
</ul>

</Docs>
