---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import Docs from '../../layouts/Docs.astro';
import Card from '../../components/Card.astro';
import CardGrid from '../../components/CardGrid.astro';

// Read from rikiki/package.json at build time so the range never drifts.
const packageDir = resolve(process.cwd(), '../rikiki');
const pkg = JSON.parse(readFileSync(resolve(packageDir, 'package.json'), 'utf8'));
const nodeRange = pkg.engines.node;

// The sizes below are measured from the build artifacts they describe ·
// scripts/size-surfaces.mjs is the single source. Loaded through a runtime file
// URL so Vite leaves the module out of the prerender bundle: it locates the
// package from its own import.meta.url.
const sizeSurfaces = pathToFileURL(resolve(packageDir, 'scripts/size-surfaces.mjs')).href;
const { measureSizes, toKb } = await import(/* @vite-ignore */ sizeSurfaces);
const sizes = measureSizes();
const engineKb = toKb(sizes.bundleGzip);
const initialLoadKb = toKb(sizes.initialLoadGzip);
---

<Docs
  title="Rikiki documentation"
  eyebrow="Docs"
  description="A tiny Lit Web Components framework for technical presentations. Write a deck as plain HTML, serve the folder, give the talk."
>

<p>
  A Rikiki deck is a folder of readable HTML. The first file is
  <code>index.html</code>; the slides are <code>&lt;deck-*&gt;</code> elements
  inside one <code>&lt;deck-root&gt;</code>, and the framework loads from a
  <code>rikiki/</code> folder next to it. There is no build step: any static
  server serves the deck as written. The command line checks a deck in a real
  browser and delivers it as a single HTML file or a PDF.
</p>
<p class="prereqs">
  <strong>Prerequisites.</strong> Writing and serving a deck needs a browser
  and a static server. The command line needs Node <code>{nodeRange}</code>;
  <code>check</code>, <code>render</code> and <code>export</code> also need
  Playwright, an optional peer.
</p>

<h2 id="map">Where to start</h2>
<p>
  Pick the entry point that matches what you came for.
</p>

