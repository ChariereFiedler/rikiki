  table.opts {
    width: 100%;
    border-collapse: collapse;
    margin: var(--rik-space-3) 0 var(--rik-space-5);
    font-size: var(--rik-font-size-md);
  }
  table.opts th,
  table.opts td {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--rik-border-default);
    vertical-align: top;
  }
  table.opts th {
    background: var(--rik-surface-sunken);
    color: var(--rik-text-default--faint);
    font: 700 var(--rik-font-size-sm)/1.2 var(--rik-font-mono);
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }
</style>

</Docs>
