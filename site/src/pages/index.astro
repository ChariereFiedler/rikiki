---
import Base       from '../layouts/Base.astro';
import Nav        from '../components/Nav.astro';
import Hero       from '../components/Hero.astro';
import Section    from '../components/Section.astro';
import ThemeSwap  from '../components/ThemeSwap.astro';
import Hook       from '../components/Hook.astro';
import Footer     from '../components/Footer.astro';
import LayoutPreview from '../components/LayoutPreview.astro';
import DualUse from '../components/DualUse.astro';
import PluginShelf from '../components/PluginShelf.astro';
import Faq from '../components/Faq.astro';
import AnatomyBento from '../components/AnatomyBento.astro';
import Limits from '../components/Limits.astro';
import AgentLoop from '../components/AgentLoop.astro';
import DeckGallery from '../components/DeckGallery.astro';

const anatomyCode = `<deck-feature eyebrow="Module">
  <h1 slot="title">Side effects</h1>
  <p slot="lead" class="lead">
    A module can act on import.
  </p>
  <deck-code lang="ts" hero>
    import './polyfill';
  </deck-code>
</deck-feature>`;

---

<Base>
  <Nav />
  <Hero />

  <Section id="quickstart" num="01" eyebrow="Interactive example" title="Write. Inspect. Deliver." tone="tint">
    <p class="section-lead">Edit the HTML and watch the slide respond. The panel below runs three sample rules of its own, so you can see the loop from edit to diagnostic; the real <code>rikiki check</code> command loads every slide in Chromium and reports structural, runtime, timing and visual-layout diagnostics.</p>
    <AnatomyBento code={anatomyCode} />
    <div class="inline-cta"><a href="/docs/getting-started">Create your first deck</a><span>Install the package and Playwright once (<code>npm i -D playwright &amp;&amp; npx playwright install chromium</code>); <code>bundle</code> also needs the rolldown bundler.</span></div>
  </Section>

  <!-- ── Example decks ──────────────────────────────── -->
  <Section id="decks" num="02" eyebrow="Example decks" title="See finished decks">
    <DeckGallery />
  </Section>

  <!-- ── Agents ─────────────────────────────────────── -->
  <Section id="agents" num="03" eyebrow="Coding-agent workflow" title="Brief your agent, then check its deck">
    <p class="section-lead">Rikiki ships a component reference and an authoring workflow for coding agents. Hand your own agent a brief plus <code>llms.txt</code>, the packaged component reference; it writes the same HTML you would review by hand, and <code>rikiki check</code> returns diagnostics for the next revision. Rikiki supplies the reference and the checks, not an AI service.</p>
    <AgentLoop />
  </Section>

  <!-- ── Library ────────────────────────────────────── -->
  <Section id="library" num="04" eyebrow="Reusable parts" title="Compose with purpose-built layouts">
    <ul class="layout-grid">
      <li>
        <LayoutPreview type="cover" />
        <h3>Open the deck <code>&lt;deck-cover&gt;</code></h3>
        <p>An XL title on a dark surface, with an optional brand mark and a meta block for the speaker, company and talk duration.</p>
      </li>
      <li>
        <LayoutPreview type="hero" />
        <h3>Focus one idea <code>&lt;deck-feature&gt;</code></h3>
        <p>One idea per slide, backed by code, a Markdown table, a mermaid diagram or a single large stat.</p>
      </li>
      <li>
        <LayoutPreview type="split" />
        <h3>Compare columns <code>&lt;deck-split&gt;</code></h3>
        <p>Lay content side by side in two or three columns, with ratios like <code>cols="1-1"</code>, <code>"1-2"</code> or <code>"3"</code>.</p>
      </li>
      <li>
        <LayoutPreview type="bento" />
        <h3>Give each idea its own cell <code>&lt;deck-bento&gt;</code></h3>
        <p>Arrange several ideas on one slide with explicit rows, columns and spans, so each keeps the space it deserves.</p>
      </li>
      <li>
        <LayoutPreview type="data" />
        <h3>Present evidence <code>&lt;deck-kpi-grid&gt;</code> <span class="opt">optional module</span></h3>
        <p>Align a small set of metrics so the result reads in one glance. Loads from <code>dist/deck-kpi-grid.js</code> when a deck imports it.</p>
      </li>
      <li>
        <LayoutPreview type="hook" />
        <h3>Land the message <code>&lt;deck-takeaway&gt;</code></h3>
        <p>A single line, centered on a dark background, for the point the audience should remember.</p>
      </li>
    </ul>
    <p class="swipe-hint">Swipe to browse · 6 layouts</p>
    <div class="component-groups">
      <p><strong>Media</strong><span>photo · mermaid · code</span></p>
      <p><strong>Data</strong><span>stat · metric · tier list</span></p>
      <p><strong>Structure</strong><span>grid · stack · cards</span></p>
      <a href="/docs/components">Browse all components</a>
    </div>
  </Section>

  <!-- ── Themes ─────────────────────────────────────── -->
  <Section id="themes" num="05" eyebrow="Design system" title="Brand the same source with tokens" tone="tint">
    <ThemeSwap />
    <p class="more">
      Theme tokens control the main colors, type and spacing of deck components.
      Copy <code>themes/rikiki.css</code>, keep its structure and adjust the values
      for your brand.
    </p>
  </Section>

  <DualUse />

  <PluginShelf />
  <Limits />
  <Faq />

  <Hook
    kicker="Ready to try it"
    punch="Create a checked, standalone deck."
    caption="Review the diagnostics and slide images before you deliver the offline HTML and PDF."
  />

  <Footer />
</Base>

<style>
  .section-lead { max-width:70ch; margin:-1rem 0 var(--rik-space-5); color:var(--rik-text-default--muted); font-size:var(--rik-font-size-lead); line-height:1.55; }
  .inline-cta { display:flex; justify-content:space-between; align-items:center; gap:var(--rik-space-3); margin-top:var(--rik-space-4); padding:var(--rik-space-3) 0; border-bottom:1px solid var(--rik-border-default); }
  .inline-cta a { color:var(--rik-accent--strong); font-weight:700; text-decoration:none; white-space:nowrap; }
  .inline-cta span { color:var(--rik-text-default--muted); font:var(--rik-font-size-sm)/1.5 var(--rik-font-sans); }
  .inline-cta code { color:var(--rik-text-default); }
  .more {
    margin-top: var(--rik-space-5);
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-default--faint);
    line-height: 1.65;
    max-width: 75ch;
  }
  .more code {
    color: var(--rik-text-default);
  }
  .swipe-hint { display:none; color:var(--rik-text-default--muted); font:600 var(--rik-font-size-sm)/1.4 var(--rik-font-sans); }
  .component-groups { display:grid; grid-template-columns:repeat(3,1fr) auto; align-items:end; gap:var(--rik-space-4); margin-top:var(--rik-space-4); padding-top:var(--rik-space-3); border-top:1px solid var(--rik-border-default); }
  .component-groups p { display:grid; gap:4px; margin:0; }
  .component-groups > * { min-width:0; }
  .component-groups strong { color:var(--rik-text-default); font-size:var(--rik-font-size-md); }
  .component-groups span { color:var(--rik-text-default--muted); font-size:var(--rik-font-size-md); }
  .component-groups a { color:var(--rik-accent--strong); font-weight:700; text-decoration:none; white-space:nowrap; }

  /* Library section · six previews at one scale, three to a row. */
  .layout-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--rik-space-5) var(--rik-space-4);
  }
  @media (max-width: 880px) {
    .layout-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .layout-grid {
      display:flex !important;
      overflow-x:auto !important;
      scroll-snap-type:x mandatory;
      scrollbar-width:none;
      max-width:100%;
      contain:inline-size paint;
      padding:0 0 var(--rik-space-3);
    }
    .layout-grid::-webkit-scrollbar { display:none; }
    .layout-grid li { flex:0 0 min(82vw,320px); scroll-snap-align:center; }
    .swipe-hint { display:block; margin:var(--rik-space-2) 0 0; }
  }
  .layout-grid li {
    display: flex; flex-direction: column;
    gap: var(--rik-space-2);
    min-width: 0;
  }
  .layout-grid :global(.layout-preview) { margin-bottom: var(--rik-space-1); }
  .layout-grid h3 {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--rik-space-1) var(--rik-space-2);
    font-family: var(--rik-font-sans);
    font-size: var(--rik-font-size-lead);
    font-weight: 700;
    color: var(--rik-text-default);
    letter-spacing: -0.005em;
    margin: 0;
  }
  .layout-grid .opt {
    color: var(--rik-text-default--muted);
    font-size: var(--rik-font-size-sm);
    font-weight: 500;
    white-space: nowrap;
  }
  .layout-grid p {
    font-size: var(--rik-font-size-md);
    color: var(--rik-text-default--muted);
    line-height: 1.5;
    margin: 0;
  }
  .layout-grid h3 code {
    font: 700 var(--rik-font-size-sm)/1.3 var(--rik-font-mono);
    color: var(--rik-text-default);
  }
  .layout-grid p code { color: var(--rik-text-default); }

  @media (max-width: 640px) {
    .layout-grid {
      gap: var(--rik-space-3);
    }
    .more {
      font-size: var(--rik-font-size-body);
    }
    .more code { overflow-wrap:anywhere; white-space:normal; }
    .inline-cta { align-items:flex-start; flex-direction:column; }
    .component-groups { grid-template-columns:1fr; gap:var(--rik-space-3); }
    .component-groups a { grid-column:1 / -1; margin-top:var(--rik-space-2); }
    .component-groups p { padding-bottom:var(--rik-space-2); border-bottom:1px solid var(--rik-border-default); }
    .component-groups span,.component-groups a { overflow-wrap:anywhere; white-space:normal; }
  }
</style>
