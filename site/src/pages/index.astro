---
import Base       from '../layouts/Base.astro';
import Nav        from '../components/Nav.astro';
import Hero       from '../components/Hero.astro';
import LiveDemo   from '../components/LiveDemo.astro';
import Section    from '../components/Section.astro';
import Stat       from '../components/Stat.astro';
import StatGrid   from '../components/StatGrid.astro';
import ThemeSwap  from '../components/ThemeSwap.astro';
import Hook       from '../components/Hook.astro';
import Footer     from '../components/Footer.astro';
import LayoutPreview from '../components/LayoutPreview.astro';
import DocsToc from '../components/DocsToc.astro';
import DualUse from '../components/DualUse.astro';
import PluginShelf from '../components/PluginShelf.astro';
import LiveReload from '../components/LiveReload.astro';
import Limits from '../components/Limits.astro';
import Faq from '../components/Faq.astro';
import StickyCta from '../components/StickyCta.astro';
import AgentLoop from '../components/AgentLoop.astro';
import AnatomyBento from '../components/AnatomyBento.astro';

const anatomyCode = `<deck-feature eyebrow="Module">
  <h1 slot="title">Side effects</h1>
  <p slot="lead" class="lead">
    A module can act on import.
  </p>
  <deck-code lang="ts" hero>
    import './polyfill';
  </deck-code>
</deck-feature>`;

---

<Base>
  <Nav />
  <Hero />

  <!-- ── Live demo embedded right after the hero ─────── -->
  <section class="demo-band">
    <div class="demo-inner">
      <LiveDemo />
    </div>
  </section>

  <!-- ── Workflow ───────────────────────────────────── -->
  <Section id="workflow" num="01" eyebrow="The workflow" title="From brief to delivery, with evidence">
    <StatGrid>
      <Stat num="01" claim="Write the source" tone="mango">
        Give an LLM the brief, the Rikiki skill, and the component reference.
        It writes a readable <code>index.html</code> you can inspect and edit.
      </Stat>
      <Stat num="02" claim="Run the doctor" tone="helico">
        <code>rikiki check</code> inspects structure, runtime, accessibility,
        timing, and pixels. Its report tells the agent what to revise.
      </Stat>
      <Stat num="03" claim="Deliver the proof" tone="lime">
        Render the slides, bundle a standalone HTML file, and export a PDF.
        <br /><strong>Everything needed to present travels with the deliverable.</strong>
      </Stat>
    </StatGrid>
    <AgentLoop />
  </Section>

  <DualUse />

  <!-- ── Source loop ─────────────────────────────────── -->
  <Section id="quickstart" num="03" eyebrow="Source and result" title="Source, checks, delivery">
    <AnatomyBento code={anatomyCode} />
  </Section>

  <!-- ── Library ────────────────────────────────────── -->
  <Section id="library" num="04" eyebrow="Library" title="Layouts, one job each">
    <ul class="layout-grid">
      <li>
        <LayoutPreview type="cover" />
        <h3>&lt;deck-cover&gt;</h3>
        <p>The opener. XL title on dark, brand mark if you want one, meta block.</p>
      </li>
      <li>
        <LayoutPreview type="section" />
        <h3>&lt;deck-section&gt;</h3>
        <p>A chapter break. Number and centered title on dark.</p>
      </li>
      <li>
        <LayoutPreview type="hero" />
        <h3>&lt;deck-feature&gt;</h3>
        <p>One thing in focus. Code, a table, a mermaid diagram, a big stat.</p>
      </li>
      <li>
        <LayoutPreview type="split" />
        <h3>&lt;deck-split&gt;</h3>
        <p>Two columns or three. <code>cols="1-1"</code>, <code>"1-2"</code>, <code>"3"</code>.</p>
      </li>
      <li>
        <LayoutPreview type="hero-detail" />
        <h3>&lt;deck-feature-cards&gt;</h3>
        <p>Hero up top, two detail cards under it.</p>
      </li>
      <li>
        <LayoutPreview type="hook" />
        <h3>&lt;deck-takeaway&gt;</h3>
        <p>The line they remember. Centered, on dark.</p>
      </li>
    </ul>
    <p class="more">
      And there's more. <code>&lt;deck-photo&gt;</code> for full-bleed images, plus ~21 other
      building blocks · <code>md</code>, <code>code</code>, <code>callout</code>,
      <code>card</code>, <code>mermaid</code>, <code>stat</code>, <code>badge</code>,
      <code>metric</code>, <code>tier-list</code>, <code>step-list</code>,
      <code>kicker</code>, <code>stack</code>, <code>grid</code>, <code>punch</code>,
      <code>shortcut</code>, <code>kbd</code> · and the rest.
    </p>
  </Section>

  <!-- ── Themes ─────────────────────────────────────── -->
  <Section id="themes" num="05" eyebrow="Two themes" title="Pick a look. One link, one swap.">
    <ThemeSwap />
    <p class="more">
      Every component reads its colors, type and spacing from CSS custom
      properties. Want a third theme? Copy <code>themes/rikiki.css</code>,
      change the values, ship it.
    </p>
  </Section>

  <PluginShelf />
  <LiveReload />
  <StickyCta />
  <Limits />
  <Faq />
  <DocsToc />

  <Hook
    kicker="The whole point"
    punch={`Source <span class="accent">→</span> proof.`}
    caption="A deck should be readable at the start, verifiable in review, and complete when it reaches the room."
  />

  <Footer />
</Base>

<style>
  .demo-band {
    /* Dark on top so the preview overlaps the hero · pulls into the dark
       portion via the negative top-margin on .demo-inner. */
    background: linear-gradient(180deg, var(--rik-surface-inverse) 0%, var(--rik-surface-inverse) 80px, var(--rik-surface-page) 80px);
    padding: 0 var(--rik-space-5) var(--rik-space-6);
  }
  .demo-inner {
    max-width: 1080px;
    margin: -80px auto 0;     /* preview crosses the hero/paper boundary */
    position: relative;
  }
  .notes {
    display: flex; flex-direction: column;
    gap: var(--rik-space-3);
  }
  .more {
    margin-top: var(--rik-space-5);
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-default--faint);
    line-height: 1.65;
    max-width: 75ch;
  }
  .more code {
    color: var(--rik-text-default);
  }

  /* Library section · 6 layouts with mini schematics on top of each card */
  .layout-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--rik-space-4);
  }
  @media (max-width: 880px) {
    .layout-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .layout-grid { grid-template-columns: 1fr; }
  }
  .layout-grid li {
    display: flex; flex-direction: column;
    gap: var(--rik-space-2);
    padding: var(--rik-space-3);
    background: var(--rik-surface-raised--strong);
    border: 1px solid var(--rik-border-default);
    border-radius: var(--rik-radius-md);
    box-shadow: var(--rik-elevation-1);
  }
  .layout-grid h3 {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-body);
    font-weight: 700;
    color: var(--rik-text-default);
    letter-spacing: -0.005em;
    margin: var(--rik-space-1) 0 0;
  }
  .layout-grid p {
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-default--muted);
    line-height: 1.5;
    margin: 0;
  }
  .layout-grid code {
    font-family: var(--rik-font-mono);
    font-size: 0.9em;
    background: var(--rik-surface-tint);
    color: var(--rik-text-default);
    padding: 1px 5px;
    border-radius: 3px;
  }

  @media (max-width: 640px) {
    .demo-band {
      padding: 0 var(--rik-space-3) var(--rik-space-5);
    }
    .demo-inner {
      margin-top: -48px;
    }
    .layout-grid {
      gap: var(--rik-space-3);
    }
    .layout-grid li {
      padding: var(--rik-space-3);
    }
    .more {
      font-size: var(--rik-font-size-body);
    }
  }
</style>
