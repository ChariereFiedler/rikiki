---
import Base       from '../layouts/Base.astro';
import Nav        from '../components/Nav.astro';
import Hero       from '../components/Hero.astro';
import Section    from '../components/Section.astro';
import ThemeSwap  from '../components/ThemeSwap.astro';
import Hook       from '../components/Hook.astro';
import Footer     from '../components/Footer.astro';
import LayoutPreview from '../components/LayoutPreview.astro';
import DualUse from '../components/DualUse.astro';
import PluginShelf from '../components/PluginShelf.astro';
import Faq from '../components/Faq.astro';
import AnatomyBento from '../components/AnatomyBento.astro';
import Limits from '../components/Limits.astro';
import AgentLoop from '../components/AgentLoop.astro';

const anatomyCode = `<deck-feature eyebrow="Module">
  <h1 slot="title">Side effects</h1>
  <p slot="lead" class="lead">
    A module can act on import.
  </p>
  <deck-code lang="ts" hero>
    import './polyfill';
  </deck-code>
</deck-feature>`;

---

<Base>
  <Nav />
  <Hero />

  <Section id="quickstart" num="01" eyebrow="Interactive example" title="Write. Inspect. Deliver." tone="tint">
    <p class="section-lead">Edit the HTML and watch the slide respond. The panel below simulates three fast checks; the full <code>rikiki check</code> command measures every slide in a browser and reports structural, runtime and visual risks.</p>
    <AnatomyBento code={anatomyCode} />
    <div class="inline-cta"><a href="/docs/getting-started">Create your first deck →</a><span>Install once, then run the commands shown above.</span></div>
  </Section>

  <!-- ── Library ────────────────────────────────────── -->
  <Section id="library" num="02" eyebrow="Reusable parts" title="Compose with purpose-built layouts">
    <ul class="layout-grid">
      <li class="tile-cover">
        <LayoutPreview type="cover" />
        <h3>Open the deck <code>&lt;deck-cover&gt;</code></h3>
        <p>The opener. XL title on dark, brand mark if you want one, meta block.</p>
      </li>
      <li class="tile-feature">
        <LayoutPreview type="hero" />
        <h3>Focus one idea <code>&lt;deck-feature&gt;</code></h3>
        <p>One thing in focus. Code, a table, a mermaid diagram, a big stat.</p>
      </li>
      <li class="tile-split">
        <LayoutPreview type="split" />
        <h3>Compare columns <code>&lt;deck-split&gt;</code></h3>
        <p>Two columns or three. <code>cols="1-1"</code>, <code>"1-2"</code>, <code>"3"</code>.</p>
      </li>
      <li class="tile-bento">
        <LayoutPreview type="bento" />
        <h3>Compose a visual system <code>&lt;deck-bento&gt;</code></h3>
        <p>Give each idea the space it deserves with explicit rows, columns and spans.</p>
      </li>
      <li class="tile-data">
        <LayoutPreview type="data" />
        <h3>Present evidence <code>&lt;deck-kpi-grid&gt;</code></h3>
        <p>Align a small set of metrics so the result reads in one glance.</p>
      </li>
      <li class="tile-hook">
        <LayoutPreview type="hook" />
        <h3>Land the message <code>&lt;deck-takeaway&gt;</code></h3>
        <p>The line they remember. Centered, on dark.</p>
      </li>
    </ul>
    <p class="swipe-hint">Swipe to browse · 6 layouts</p>
    <div class="component-groups">
      <p><strong>Media</strong><span>photo · mermaid · code</span></p>
      <p><strong>Data</strong><span>stat · metric · tier list</span></p>
      <p><strong>Structure</strong><span>grid · stack · cards</span></p>
      <a href="/docs/components">Browse all components →</a>
    </div>
  </Section>

  <!-- ── Themes ─────────────────────────────────────── -->
  <Section id="themes" num="03" eyebrow="Design system" title="Brand the same source with tokens" tone="tint">
    <ThemeSwap />
    <p class="more">
      Theme tokens control the main colors, type and spacing of deck components.
      Copy <code>themes/rikiki.css</code>, keep its structure and adjust the values
      for your brand.
    </p>
  </Section>

  <Section id="agents" num="04" eyebrow="Coding-agent workflow" title="Give an agent a contract, then check its work">
    <p class="section-lead">Rikiki ships a component reference and an authoring workflow for coding agents. Give your own agent a brief and <code>llms.txt</code>; it writes the same HTML you review, while <code>rikiki check</code> returns actionable diagnostics for the next revision. Rikiki supplies the contract and checks, not an AI service.</p>
    <AgentLoop />
  </Section>

  <DualUse />

  <PluginShelf />
  <Limits />
  <Faq />

  <Hook
    kicker="Ready to try it"
    punch={`Create a checked, <span class="accent">standalone deck.</span>`}
    caption="Review the diagnostics and slide images before you deliver the offline HTML and PDF."
  />

  <Footer />
</Base>

<style>
  .section-lead { max-width:70ch; margin:-1rem 0 var(--rik-space-5); color:var(--rik-text-default--muted); font-size:var(--rik-font-size-lead); line-height:1.55; }
  .inline-cta { display:flex; justify-content:space-between; align-items:center; gap:var(--rik-space-3); margin-top:var(--rik-space-4); padding:var(--rik-space-3) 0; border-bottom:1px solid var(--rik-border-default); }
  .inline-cta a { color:var(--rik-accent--strong); font-weight:800; text-decoration:none; }
  .inline-cta span { color:var(--rik-text-default--faint); font:var(--rik-font-size-xs)/1.4 var(--rik-font-mono); }
  .more {
    margin-top: var(--rik-space-5);
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-default--faint);
    line-height: 1.65;
    max-width: 75ch;
  }
  .more code {
    color: var(--rik-text-default);
  }
  .swipe-hint { display:none; color:var(--rik-text-default--faint); font:700 var(--rik-font-size-xs)/1.4 var(--rik-font-mono); text-transform:uppercase; letter-spacing:.1em; }
  .component-groups { display:grid; grid-template-columns:repeat(3,1fr) auto; align-items:end; gap:var(--rik-space-4); margin-top:var(--rik-space-4); padding-top:var(--rik-space-3); border-top:1px solid var(--rik-border-default); }
  .component-groups p { display:grid; gap:4px; margin:0; }
  .component-groups > * { min-width:0; }
  .component-groups strong { color:var(--rik-text-default); font-size:var(--rik-font-size-sm); }
  .component-groups span { color:var(--rik-text-default--faint); font-size:var(--rik-font-size-sm); }
  .component-groups a { color:var(--rik-accent--strong); font-weight:800; text-decoration:none; white-space:nowrap; }

  /* Library section · an uneven grid mirrors the compositional system. */
  .layout-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--rik-space-4);
  }
  .tile-cover,.tile-split,.tile-data { grid-column:span 5; }
  .tile-feature,.tile-bento,.tile-hook { grid-column:span 7; }
  .tile-hook { display:grid !important; grid-template-columns:minmax(0,1.25fr) minmax(220px,.75fr); align-items:center; }
  .tile-hook .layout-preview { grid-column:1; grid-row:1 / span 2; margin-bottom:0; }
  .tile-hook h3 { grid-column:2; grid-row:1; align-self:end; }
  .tile-hook p { grid-column:2; grid-row:2; align-self:start; }
  @media (max-width: 880px) {
    .layout-grid { grid-template-columns: repeat(2, 1fr); }
    .layout-grid li { grid-column:auto; }
    .tile-hook { display:flex !important; }
  }
  @media (max-width: 560px) {
    .layout-grid {
      display:flex !important;
      overflow-x:auto !important;
      scroll-snap-type:x mandatory;
      scrollbar-width:none;
      max-width:100%;
      contain:inline-size paint;
      padding:0 0 var(--rik-space-3);
    }
    .layout-grid::-webkit-scrollbar { display:none; }
    .layout-grid li { flex:0 0 min(82vw,320px); scroll-snap-align:center; }
    .swipe-hint { display:block; margin:var(--rik-space-2) 0 0; }
  }
  .layout-grid li {
    display: flex; flex-direction: column;
    gap: var(--rik-space-2);
    padding: var(--rik-space-3);
    background: var(--rik-surface-raised--strong);
    border: 1px solid var(--rik-border-default);
    border-radius: var(--rik-radius-md);
    box-shadow: var(--rik-elevation-1);
  }
  .layout-grid h3 {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-body);
    font-weight: 700;
    color: var(--rik-text-default);
    letter-spacing: -0.005em;
    margin: var(--rik-space-1) 0 0;
  }
  .layout-grid p {
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-default--muted);
    line-height: 1.5;
    margin: 0;
  }
  .layout-grid code {
    font-family: var(--rik-font-mono);
    font-size: 0.9em;
    background: var(--rik-surface-tint);
    color: var(--rik-text-default);
    padding: 1px 5px;
    border-radius: 3px;
  }

  @media (max-width: 640px) {
    .layout-grid {
      gap: var(--rik-space-3);
    }
    .layout-grid li {
      padding: var(--rik-space-3);
    }
    .more {
      font-size: var(--rik-font-size-body);
    }
    .more code { overflow-wrap:anywhere; white-space:normal; }
    .inline-cta { align-items:flex-start; flex-direction:column; }
    .component-groups { grid-template-columns:1fr; gap:var(--rik-space-3); }
    .component-groups a { grid-column:1 / -1; margin-top:var(--rik-space-2); }
    .component-groups p { padding-bottom:var(--rik-space-2); border-bottom:1px solid var(--rik-border-default); }
    .component-groups span,.component-groups a { overflow-wrap:anywhere; white-space:normal; }
  }
</style>
