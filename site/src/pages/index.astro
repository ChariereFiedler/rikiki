---
import Base       from '../layouts/Base.astro';
import Nav        from '../components/Nav.astro';
import Hero       from '../components/Hero.astro';
import LiveDemo   from '../components/LiveDemo.astro';
import Section    from '../components/Section.astro';
import Stat       from '../components/Stat.astro';
import StatGrid   from '../components/StatGrid.astro';
import Card       from '../components/Card.astro';
import CardGrid   from '../components/CardGrid.astro';
import CodeBlock  from '../components/CodeBlock.astro';
import ThemeSwap  from '../components/ThemeSwap.astro';
import Hook       from '../components/Hook.astro';
import Footer     from '../components/Footer.astro';
import LayoutPreview from '../components/LayoutPreview.astro';
import Comparison from '../components/Comparison.astro';
import DocsToc from '../components/DocsToc.astro';
import DualUse from '../components/DualUse.astro';
import PluginShelf from '../components/PluginShelf.astro';
import LiveReload from '../components/LiveReload.astro';
import Limits from '../components/Limits.astro';
import Faq from '../components/Faq.astro';
import StickyCta from '../components/StickyCta.astro';

const anatomyCode = `<deck-feature eyebrow="Module">
  <h1 slot="title">Side effects</h1>
  <p slot="lead" class="lead">
    A module can act on import.
  </p>
  <deck-code lang="ts" hero>
    import './polyfill';
  </deck-code>
</deck-feature>`;

const quickstartCode = `<!doctype html>
<html>
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="rikiki/tokens.css">
  <script type="module" src="rikiki/dist/index.js"></script>
</head>
<body>
  <deck-root>
    <deck-cover brand="my-talk">
      <h1>Hello, <span class="accent">world</span>.</h1>
    </deck-cover>
    <deck-feature eyebrow="One slide">
      <h1 slot="title">That's all you need.</h1>
      <deck-md>Write **markdown**, drop &lt;deck-*&gt; blocks, navigate with arrows.</deck-md>
    </deck-feature>
  </deck-root>
</body>
</html>`;
---

<Base>
  <Nav />
  <Hero />

  <!-- ── Live demo embedded right after the hero ─────── -->
  <section class="demo-band">
    <div class="demo-inner">
      <LiveDemo />
    </div>
  </section>

  <!-- ── Why ────────────────────────────────────────── -->
  <Section id="why" num="01" eyebrow="Why" title="Three constraints, on purpose">
    <StatGrid>
      <Stat num="01" claim={`Open <code>index.html</code>`} tone="mango">
        No build step, no toolchain. <strong>A deck is a folder</strong>, served by any static server.
      </Stat>
      <Stat num="02" claim="Alive in 2031" tone="helico">
        Web standards only. Custom Elements, Shadow DOM, ES Modules, CSS variables.
      </Stat>
      <Stat num="03" claim="~38 KB gzip" tone="lime">
        Lit and 34 components. <strong>Anything bigger, you opt in.</strong>
      </Stat>
    </StatGrid>
  </Section>

  <DualUse />

  <!-- ── Anatomy ────────────────────────────────────── -->
  <Section id="anatomy" num="03" eyebrow="Anatomy" title="A slide is just HTML">
    <CardGrid cols={2}>
      <CodeBlock label="Source · index.html" lang="html" code={anatomyCode} />
      <div class="notes">
        <Card title="Layouts">
          <p><code>&lt;deck-feature&gt;</code> and friends give you structure. Title, lead, body.</p>
        </Card>
        <Card title="Slots">
          <p>Drop content where it goes. <code>slot="title"</code>, <code>slot="lead"</code>, <code>slot="left"</code>, <code>slot="right"</code>.</p>
        </Card>
        <Card title="Atoms">
          <p>The pieces inside. <code>&lt;deck-code&gt;</code>, <code>&lt;deck-md&gt;</code>, <code>&lt;deck-callout&gt;</code>, <code>&lt;deck-card&gt;</code>, <code>&lt;deck-mermaid&gt;</code>.</p>
        </Card>
      </div>
    </CardGrid>
  </Section>

  <!-- ── Library ────────────────────────────────────── -->
  <Section id="library" num="04" eyebrow="Library" title="Layouts, one job each">
    <ul class="layout-grid">
      <li>
        <LayoutPreview type="cover" />
        <h3>&lt;deck-cover&gt;</h3>
        <p>The opener. XL title on dark, brand mark if you want one, meta block.</p>
      </li>
      <li>
        <LayoutPreview type="section" />
        <h3>&lt;deck-section&gt;</h3>
        <p>A chapter break. Number and centered title on dark.</p>
      </li>
      <li>
        <LayoutPreview type="hero" />
        <h3>&lt;deck-feature&gt;</h3>
        <p>One thing in focus. Code, a table, a mermaid diagram, a big stat.</p>
      </li>
      <li>
        <LayoutPreview type="split" />
        <h3>&lt;deck-split&gt;</h3>
        <p>Two columns or three. <code>cols="1-1"</code>, <code>"1-2"</code>, <code>"3"</code>.</p>
      </li>
      <li>
        <LayoutPreview type="hero-detail" />
        <h3>&lt;deck-feature-cards&gt;</h3>
        <p>Hero up top, two detail cards under it.</p>
      </li>
      <li>
        <LayoutPreview type="hook" />
        <h3>&lt;deck-takeaway&gt;</h3>
        <p>The line they remember. Centered, on dark.</p>
      </li>
    </ul>
    <p class="more">
      And there's more. <code>&lt;deck-photo&gt;</code> for full-bleed images, plus ~23 other
      building blocks · <code>md</code>, <code>code</code>, <code>callout</code>,
      <code>card</code>, <code>mermaid</code>, <code>stat</code>, <code>badge</code>,
      <code>metric</code>, <code>tier-list</code>, <code>step-list</code>,
      <code>kicker</code>, <code>stack</code>, <code>grid</code>, <code>punch</code>,
      <code>shortcut</code>, <code>kbd</code> · and the rest.
    </p>
  </Section>

  <!-- ── Themes ─────────────────────────────────────── -->
  <Section id="themes" num="05" eyebrow="Two themes" title="Pick a look. One link, one swap.">
    <ThemeSwap />
    <p class="more">
      Every component reads its colors, type and spacing from CSS custom
      properties. Want a third theme? Copy <code>themes/rikiki.css</code>,
      change the values, ship it.
    </p>
  </Section>

  <!-- ── Quickstart ─────────────────────────────────── -->
  <Section id="quickstart" num="06" eyebrow="60 seconds, no install" title="A deck, end to end">
    <CodeBlock label="my-talk/index.html" lang="html" code={quickstartCode} />
    <p class="more">
      Drop this file on any static host. GitHub Pages, S3, Netlify, your local
      <code>python -m http.server</code>. No build, no environment to set up.
    </p>
    <p class="more">
      Want the guided version? &nbsp;<a href="/docs/cheatsheet">→ Your first deck in 5 components</a>.
    </p>
  </Section>

  <PluginShelf />
  <LiveReload />
  <Comparison />
  <StickyCta />
  <Limits />
  <Faq />
  <DocsToc />

  <Hook
    kicker="The whole point"
    punch={`Source <span class="accent">=</span> output.`}
    caption="A deck is a folder. Open it in 2031, change one character, give the talk again."
  />

  <Footer />
</Base>

<style>
  .demo-band {
    /* Dark on top so the preview overlaps the hero · pulls into the dark
       portion via the negative top-margin on .demo-inner. */
    background: linear-gradient(180deg, var(--rik-surface-inverse) 0%, var(--rik-surface-inverse) 80px, var(--rik-surface-page) 80px);
    padding: 0 var(--rik-space-5) var(--rik-space-6);
  }
  .demo-inner {
    max-width: 1080px;
    margin: -80px auto 0;     /* preview crosses the hero/paper boundary */
    position: relative;
  }
  .notes {
    display: flex; flex-direction: column;
    gap: var(--rik-space-3);
  }
  .more {
    margin-top: var(--rik-space-5);
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-default--faint);
    line-height: 1.65;
    max-width: 75ch;
  }
  .more code {
    color: var(--rik-text-default);
  }

  /* Library section · 6 layouts with mini schematics on top of each card */
  .layout-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--rik-space-4);
  }
  @media (max-width: 880px) {
    .layout-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .layout-grid { grid-template-columns: 1fr; }
  }
  .layout-grid li {
    display: flex; flex-direction: column;
    gap: var(--rik-space-2);
    padding: var(--rik-space-3);
    background: var(--rik-surface-raised--strong);
    border: 1px solid var(--rik-border-default);
    border-radius: var(--rik-radius-md);
    box-shadow: var(--rik-elevation-1);
  }
  .layout-grid h3 {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-body);
    font-weight: 700;
    color: var(--rik-text-default);
    letter-spacing: -0.005em;
    margin: var(--rik-space-1) 0 0;
  }
  .layout-grid p {
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-default--muted);
    line-height: 1.5;
    margin: 0;
  }
  .layout-grid code {
    font-family: var(--rik-font-mono);
    font-size: 0.9em;
    background: var(--rik-surface-tint);
    color: var(--rik-text-default);
    padding: 1px 5px;
    border-radius: 3px;
  }
</style>
