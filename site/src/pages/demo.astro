---
import Base from '../layouts/Base.astro';
---

<Base
  title="Rikiki · the docs tour"
  description="A 17-slide tour of every layout, atom and navigation key."
>
  <!--
    The demo deck lives in /examples/rikiki-tour/ in the source repo · we
    embed it here as a full-bleed iframe. In dev mode `astro dev` proxies
    parent files via vite.server.fs.allow.
  -->
  <header class="back">
    <a href="/">← Back to docs</a>
    <span class="hint">Press <kbd>O</kbd> for overview · <kbd>?</kbd> for shortcuts</span>
  </header>
  <iframe src="/embed/" title="Rikiki · the docs tour" allowfullscreen></iframe>

  <style>
    html, body { height: 100%; margin: 0; }
    iframe {
      position: fixed; inset: 40px 0 0 0;
      width: 100%; height: calc(100vh - 40px);
      border: 0;
    }
    .back {
      position: fixed; top: 0; left: 0; right: 0;
      height: 40px;
      background: var(--dark);
      color: var(--on-dark-text);
      display: flex; justify-content: space-between; align-items: center;
      padding: 0 var(--sp-4);
      font-family: var(--mono);
      font-size: var(--fs-micro);
      z-index: 10;
    }
    .back a { color: var(--mango); }
    .back a:hover { text-decoration: underline; }
    .hint { color: var(--on-dark-muted); letter-spacing: 0.1em; text-transform: uppercase; }
    .hint kbd {
      background: var(--on-dark-surface, rgba(232, 228, 240, 0.08));
      border: 1px solid var(--on-dark-border, rgba(232, 228, 240, 0.12));
      border-radius: 4px;
      padding: 1px 6px;
      margin: 0 2px;
      color: var(--on-dark-text);
    }
  </style>
</Base>
