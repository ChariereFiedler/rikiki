---
// Comparison · trimmed to the 5 rows that actually carry the differentiation.
// The "Read this fairly" lede now sits ABOVE the table so the framing isn't
// buried after the data dump. Rikiki column is a saturated highlight stripe.

interface Row {
  label: string;
  values: [string, string, string, string, string];
}

const headers = ['Rikiki', 'Slidev', 'reveal.js', 'Marp', 'Spectacle'];
const rows: Row[] = [
  { label: 'Source format',       values: ['HTML',         'Markdown + Vue',  'HTML + JS',     'Markdown',      'JSX'] },
  { label: 'Build step',          values: ['no',           'yes (Vite)',      'optional',      'yes (CLI)',     'yes (webpack)'] },
  { label: 'Runtime bundle (gz)', values: ['~14 KB',       '~600 KB',         '~80 KB',        '~50 KB',        '~250 KB'] },
  { label: 'Per-deck deps',       values: ['1 CSS + 1 JS', 'package.json',    'reveal.js dir', 'marp-cli',      'package.json'] },
  { label: 'Works in 5 years',    values: ['yes',          'depends on Vue',  'yes',           'depends on CLI','depends on JSX'] },
];

/** ✓ / partial / – glyphs based on the cell content · this is intentional
 *  shorthand: any cell that says "yes" or starts with "no" gets a glyph. */
function glyphFor(label: string, value: string): string | null {
  const v = value.toLowerCase();
  if (label === 'Build step') {
    if (v === 'no') return '✓';
    if (v.startsWith('optional')) return '~';
    return '×';
  }
  if (label === 'Works in 5 years') {
    if (v === 'yes') return '✓';
    if (v.startsWith('depends')) return '~';
    return '×';
  }
  return null;
}
---

<section id="vs" class="section">
  <div class="inner">
    <p class="eyebrow"><span class="num">08</span> Comparison</p>
    <h2>Where Rikiki sits</h2>
    <p class="lede">
      <strong>Read this fairly.</strong> Slidev, reveal.js, Marp and
      Spectacle are all good. Rikiki is for one case. You want to open a
      folder five years from now and still give the talk. Or drop a
      touch-friendly carousel on a landing page. That one constraint
      explains every column below.
    </p>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="row-head"></th>
            {headers.map((h, i) => (
              <th class:list={['col', i === 0 && 'us']}>
                <span class="col-name">{h}</span>
                {i === 0 && <span class="col-mark">our case</span>}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th class="row-head">{r.label}</th>
              {r.values.map((v, i) => {
                const g = glyphFor(r.label, v);
                return (
                  <td class:list={['cell', i === 0 && 'us', g === '✓' && 'good', g === '×' && 'bad', g === '~' && 'meh']}>
                    {g && <span class="g">{g}</span>}
                    <span class="v">{v}</span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .section {
    background: var(--rik-surface-page);
    padding: var(--rik-space-7) var(--rik-space-5);
    border-top: 1px solid var(--rik-border-default);
  }
  .inner { max-width: 1080px; margin: 0 auto; }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--rik-accent);
    color: var(--rik-accent__on);
    padding: 4px 14px 4px 4px;
    border-radius: var(--rik-radius-pill);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 var(--rik-space-3);
  }
  .eyebrow .num {
    background: var(--rik-accent__on);
    color: var(--rik-accent--strong);
    padding: 4px 7px;
    border-radius: var(--rik-radius-pill);
  }
  h2 {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-mega);
    font-weight: 900;
    color: var(--rik-text-default);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 var(--rik-space-3);
  }
  .lede {
    font-size: var(--rik-font-size-lead);
    color: var(--rik-text-default--muted);
    line-height: 1.6;
    max-width: 72ch;
    margin: 0 0 var(--rik-space-5);
  }
  .lede strong { color: var(--rik-text-default); font-weight: 700; }

  /* ── Table ─────────────────────────────────────────────── */
  .table-wrap {
    overflow-x: auto;
    border-radius: var(--rik-radius-md);
    border: 1px solid var(--rik-border-default);
    box-shadow: var(--rik-elevation-2);
    background: var(--rik-surface-raised--strong);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--rik-font-size-body);
  }
  th, td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid var(--rik-border-default);
    vertical-align: middle;
  }
  thead th {
    background: var(--rik-surface-sunken);
    color: var(--rik-text-default--faint);
    font: 800 var(--rik-font-size-sm)/1.2 var(--rik-font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  thead .col-name { display: block; }
  thead .col-mark {
    display: block;
    margin-top: 4px;
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    color: var(--rik-accent);
  }
  thead th.us {
    background: var(--rik-accent);
    color: var(--rik-accent__on);
  }
  thead th.us .col-name { color: var(--rik-accent__on); }
  thead th.us .col-mark { color: rgba(255, 255, 255, 0.7); }

  tbody th.row-head {
    background: var(--rik-surface-sunken);
    color: var(--rik-text-default--muted);
    font: 700 var(--rik-font-size-sm)/1.3 var(--rik-font-mono);
    white-space: nowrap;
    width: 1px;
  }
  .cell {
    color: var(--rik-text-default--muted);
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-sm);
  }
  .cell .g {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px;
    border-radius: 50%;
    font: 900 0.85rem/1 var(--rik-font-sans);
    margin-right: 8px;
    vertical-align: middle;
    background: var(--rik-surface-tint);
    color: var(--rik-text-default--faint);
  }
  .cell.good .g { background: var(--rik-status-success); color: #fff; }
  .cell.bad  .g { background: var(--rik-status-danger);  color: #fff; }
  .cell.meh  .g { background: var(--rik-status-warn);    color: #fff; }
  .cell .v { vertical-align: middle; }

  .cell.us {
    background: var(--rik-accent--faint);
    color: var(--rik-text-default);
    font-weight: 700;
  }
  .cell.us .g {
    background: var(--rik-accent);
    color: var(--rik-accent__on);
  }

  tr:last-child th, tr:last-child td { border-bottom: 0; }
</style>
