---
interface Props {
  code: string;
  /** Layout components need a 16:9 slide canvas (scaled). Atoms render at
   *  natural size inline so the reader sees them at the same scale they will
   *  appear in a real deck. */
  full?: boolean;
  /** Slide aspect ratio · only honoured when `full` is true. */
  aspect?: string;
  /** Optional component module loaded after the core runtime. */
  module?: string;
}
const { code, full = false, aspect, module } = Astro.props;
const ar = aspect ?? '16 / 9';
const optionalScript = module
  ? '<script type="module" src="/rikiki/dist/' + module + '"></scr' + 'ipt>'
  : '';

const layoutSrcdoc = '<!doctype html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="/rikiki/themes/rikiki.css"><script type="module" src="/rikiki/dist/index.js"></scr' + 'ipt>' + optionalScript + '<style>html,body{width:100%;height:100%;overflow:hidden;margin:0}body{display:flex;background:var(--rik-surface-page)}deck-root{flex:1}</style></head><body><deck-root>' + code + '</deck-root></body></html>';

/* The framework themes set `html, body { height: 100%; overflow: hidden }`
   which would clip the atom. We override after the link so the body becomes
   a flex container that fits the iframe's height. The script below messages
   the iframe to communicate the natural height back. */
const atomSrcdoc = '<!doctype html><html><head><meta charset="UTF-8"><link rel="stylesheet" href="/rikiki/themes/rikiki.css"><script type="module" src="/rikiki/dist/index.js"></scr' + 'ipt>' + optionalScript + '<style>html,body{min-height:0!important;height:auto!important;overflow:hidden!important;margin:0;padding:0;font-size:16px!important}body{display:flex;align-items:center;justify-content:center;padding:24px 32px;background:var(--rik-surface-page);box-sizing:border-box}body>*{max-width:100%}body>:is(deck-bar,deck-checklist,deck-flow,deck-graph,deck-kpi-grid,deck-table,deck-timeline,deck-versus,deck-tier-list,deck-step-list,deck-shortcut-list,deck-metric-list,deck-code,deck-mermaid){width:100%}deck-table table{width:100%;border-collapse:collapse;font:16px/1.4 var(--rik-font-sans)}deck-table th,deck-table td{padding:10px 14px;text-align:left;border-bottom:1px solid var(--rik-border-default)}deck-table th{background:var(--rik-surface-raised);font-weight:700}</style></head><body>' + code + '</body></html>';
---

{full ? (
  <figure class="comp-preview layout" style={'--ar: ' + ar}>
    <figcaption>Live preview · slide canvas</figcaption>
    <div class="frame">
      <iframe srcdoc={layoutSrcdoc} title="Slide preview" loading="lazy"></iframe>
    </div>
  </figure>
) : (
  <figure class="comp-preview atom">
    <figcaption>Live preview</figcaption>
    <iframe srcdoc={atomSrcdoc} title="Atom preview" loading="lazy" class="atom-frame"></iframe>
  </figure>
)}

<style>
  .comp-preview {
    margin: var(--rik-space-3) 0 var(--rik-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--rik-space-2);
  }
  figcaption {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rik-text-default--faint);
  }

  /* ── Layout previews · scaled slide canvas (16:9) ─────── */
  .layout .frame {
    position: relative;
    aspect-ratio: var(--ar);
    overflow: hidden;
    background: var(--rik-surface-sunken);
    border: 1px solid var(--rik-border-default);
    border-radius: var(--rik-radius-md);
  }
  .layout iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1080px;
    transform: scale(1);
    transform-origin: top left;
    border: 0;
  }

  /* ── Atom previews · fixed canvas, content centered inside ─── */
  .atom .atom-frame {
    width: 100%;
    height: 160px;
    min-height: 120px;
    max-height: 440px;
    border: 1px solid var(--rik-border-default);
    border-radius: var(--rik-radius-md);
    background: var(--rik-surface-sunken);
  }
</style>

<script is:inline>
  // Scale layout iframes to fit width (deck is fixed at 1920×1080).
  document.querySelectorAll('.comp-preview.layout .frame').forEach((el) => {
    const iframe = el.querySelector('iframe');
    if (!iframe) return;
    const apply = () => {
      const w = el.getBoundingClientRect().width;
      const h = el.getBoundingClientRect().height;
      const s = w / 1920;
      iframe.style.transform = 'scale(' + s + ')';
      iframe.style.height = (h / s) + 'px';
    };
    apply();
    new ResizeObserver(apply).observe(el);
  });

  // Atom previews follow the rendered component instead of reserving the same
  // large empty canvas for a tiny icon, table, or quote.
  document.querySelectorAll('iframe.atom-frame').forEach((iframe) => {
    iframe.addEventListener('load', () => {
      try {
        const doc = iframe.contentDocument;
        if (!doc) return;
        const fit = () => {
          const el = doc.body.firstElementChild;
          if (!el) return;
          const contentHeight = Math.ceil(el.getBoundingClientRect().height + 48);
          iframe.style.height = Math.max(120, Math.min(440, contentHeight)) + 'px';
        };
        requestAnimationFrame(() => requestAnimationFrame(fit));
        if (doc.fonts?.ready) void doc.fonts.ready.then(fit);
      } catch { /* noop */ }
    });
  });
</script>
