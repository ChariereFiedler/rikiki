---
// Mid-page CTA · sits between Comparison and Limits so a reader convinced by
// the table has somewhere to click without scrolling all the way back to the
// hero. Sticks to the viewport bottom on long sections; copy-button on the
// install command.
---

<section class="cta-bar" aria-label="Get started">
  <div class="inner">
    <div class="left">
      <p class="title">Convinced? Try it in 60 seconds.</p>
      <p class="sub">No build, no install · just drop one HTML file on a static host.</p>
    </div>
    <div class="actions">
      <button type="button" class="copy" data-clip="npm install rikiki" aria-label="Copy install command">
        <code class="cmd">npm install rikiki</code>
        <span class="copy-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </span>
      </button>
      <a class="primary" href="/docs/cheatsheet">Read the 5-min start →</a>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.cta-bar .copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-clip') || '';
      try { await navigator.clipboard.writeText(text); } catch { /* noop */ }
      const cmd = btn.querySelector('.cmd');
      const original = cmd?.textContent;
      btn.classList.add('copied');
      if (cmd) cmd.textContent = 'Copied to clipboard';
      window.setTimeout(() => {
        btn.classList.remove('copied');
        if (cmd && original) cmd.textContent = original;
      }, 1400);
    });
  });
</script>

<style>
  .cta-bar {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
    padding: var(--rik-space-5) var(--rik-space-5);
    border-top: 1px solid var(--rik-border-inverse);
    border-bottom: 1px solid var(--rik-border-inverse);
    position: relative;
    overflow: hidden;
  }
  .cta-bar::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 50%, rgba(240, 112, 32, 0.18) 0%, transparent 55%);
    pointer-events: none;
  }
  .inner {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--rik-space-5);
    flex-wrap: wrap;
  }
  .left { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .title {
    font-family: var(--rik-font-display);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--rik-text-inverse);
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
  }
  .sub {
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-inverse--muted);
    line-height: 1.4;
    margin: 0;
  }
  .actions { display: inline-flex; gap: var(--rik-space-3); flex-wrap: wrap; align-items: center; }

  .copy {
    appearance: none;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 14px;
    background: var(--rik-surface-inverse__overlay);
    border: 1px solid var(--rik-border-inverse);
    border-radius: var(--rik-radius-md);
    color: var(--rik-text-inverse);
    font: 700 var(--rik-font-size-sm)/1 var(--rik-font-mono);
    cursor: pointer;
    transition: background var(--rik-motion-fast) var(--rik-motion__ease-out),
                border-color var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .copy::before {
    content: '$';
    color: var(--rik-text-inverse--ghost);
    font-weight: 700;
  }
  .copy:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.20);
  }
  .copy.copied {
    background: rgba(0, 200, 160, 0.18);
    border-color: rgba(0, 200, 160, 0.45);
    color: #c3e88d;
  }
  .copy .cmd { color: inherit; background: transparent; padding: 0; }
  .copy-icon { display: inline-flex; opacity: 0.6; }

  .primary {
    display: inline-flex; align-items: center;
    padding: 12px 22px;
    border-radius: var(--rik-radius-pill);
    background: var(--rik-accent);
    color: var(--rik-accent__on);
    font: 700 var(--rik-font-size-body)/1 var(--rik-font-sans);
    text-decoration: none;
    transition: transform var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .primary:hover {
    transform: translateY(-2px);
    text-decoration: none;
    color: var(--rik-accent__on);
  }

  @media (max-width: 720px) {
    .inner { flex-direction: column; align-items: flex-start; }
    .actions { width: 100%; }
    .primary { flex: 1; justify-content: center; }
  }
</style>
