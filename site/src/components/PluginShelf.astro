---
const plugins = [
  { role: 'transitions',    name: 'deck-transition',  file: 'deck-transition.js',  kb: 1.7, activate: 'transition="slide"',     summary: 'Slide, fade, zoom, flip. Picks its own direction. Cross-fades old and new, no background flash.', href: '/docs/plugins#transition', glyph: 'transitions' },
  { role: 'presenter mode', name: 'deck-presenter',   file: 'deck-presenter.js',   kb: 2.9, activate: 'press P',                 summary: 'A popup with the current slide, the next one, your notes and a timer. Syncs over BroadcastChannel.',           href: '/docs/plugins#presenter',  glyph: 'presenter' },
  { role: 'syntax',         name: 'shiki',            file: 'shiki.js',            kb: 0.6, activate: 'installShiki()',          summary: 'Real syntax highlighting for deck-code. TextMate grammars, JSX, TSX, template literals.',           href: '/docs/plugins#shiki',      glyph: 'syntax' },
  { role: 'click reveals',  name: 'click-stages',     file: 'click-stages.js',     kb: 0.8, activate: 'installClickStages()',    summary: 'Reveal elements one click at a time. data-click and data-anim. Builds on the step engine, reverses cleanly.', href: '/docs/plugins#click-stages', glyph: 'clicks' },
  { role: 'speaker notes',  name: 'deck-notes',       file: 'deck-notes',          kb: 0.4, activate: '<deck-notes>',            summary: 'A hidden slot that surfaces in the presenter window. Free text, kept as written.',                          href: '/docs/plugins#notes',      glyph: 'notes' },
];
const totalKb = plugins.reduce((s, p) => s + p.kb, 0).toFixed(1);
---

<section id="plugins" class="shelf">
  <div class="inner">
    <header class="head">
      <p class="eyebrow"><span class="num">07</span> Plugin shelf</p>
      <h2>Five opt-in modules. Nothing else loads.</h2>
      <p class="lede">
        The ~41 KB initial load ships none of these. Each one fetches on first use.
        A deck that never asks for a feature never pays for it.
      </p>
      <p class="budget" aria-label="Total weight if every plugin opts in">
        Total if you enable everything · <strong>~{totalKb} KB gzip</strong> on top of core
      </p>
    </header>

    <ol class="shelf-list">
      {plugins.map((p, i) => (
        <li>
          <a class="plugin" href={p.href}>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <span class="glyph" aria-hidden="true">
              {p.glyph === 'transitions' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="8" width="14" height="20" rx="2"></rect>
                  <rect x="19" y="8" width="14" height="20" rx="2" opacity="0.55"></rect>
                  <path d="M11 18 L25 18" stroke-dasharray="2 3"></path>
                  <path d="M22 15 L25 18 L22 21"></path>
                </svg>
              )}
              {p.glyph === 'presenter' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="6" width="20" height="14" rx="2"></rect>
                  <path d="M9 24 L15 24"></path>
                  <path d="M12 20 L12 24"></path>
                  <rect x="24" y="14" width="10" height="8" rx="1"></rect>
                  <path d="M24 18 L34 18" stroke-dasharray="2 2"></path>
                </svg>
              )}
              {p.glyph === 'syntax' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 8 L4 18 L11 28"></path>
                  <path d="M25 8 L32 18 L25 28"></path>
                  <path d="M20 6 L16 30" opacity="0.65"></path>
                </svg>
              )}
              {p.glyph === 'notes' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 6 H30 V25 H17 L10 32 V25 H6 Z"></path>
                  <path d="M11 13 L25 13" opacity="0.7"></path>
                  <path d="M11 18 L22 18" opacity="0.5"></path>
                </svg>
              )}
              {p.glyph === 'clicks' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 6 L6 22 L11 18 L14 25 L17 23 L14 16 L20 16 Z"></path>
                  <path d="M24 9 L29 9" opacity="0.6"></path>
                  <path d="M24 14 L31 14" opacity="0.45"></path>
                  <path d="M24 19 L29 19" opacity="0.3"></path>
                </svg>
              )}
            </span>
            <div class="body">
              <header>
                <h3>
                  <span class="role">{p.role}</span>
                  <code class="file">{p.file}</code>
                </h3>
                <span class="size"><strong>{p.kb}</strong> KB gz</span>
              </header>
              <p class="summary">{p.summary}</p>
              <p class="how">
                <span class="how-label">Activate</span>
                <code class="how-code">{p.activate}</code>
              </p>
            </div>
            <span class="chev" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="footer-note">
      <a href="/docs/plugins">Read the plugin reference →</a>
    </p>
  </div>
</section>

<style>
  /* ── Dark editorial band · the tonal pivot of the page ── */
  .shelf {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
    padding: var(--rik-space-7) var(--rik-space-5);
    position: relative;
    overflow: hidden;
  }
  .shelf::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 8% 5%, rgba(240, 112, 32, 0.12) 0%, transparent 45%),
      radial-gradient(circle at 95% 95%, rgba(0, 200, 160, 0.08) 0%, transparent 55%);
    pointer-events: none;
  }
  .inner {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
  }

  .head { max-width: 70ch; margin-bottom: var(--rik-space-6); }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--rik-accent);
    color: var(--rik-accent__on);
    padding: 4px 14px 4px 4px;
    border-radius: var(--rik-radius-pill);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 var(--rik-space-3);
  }
  .eyebrow .num {
    background: var(--rik-accent__on);
    color: var(--rik-accent--strong);
    padding: 4px 7px;
    border-radius: var(--rik-radius-pill);
  }
  h2 {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-mega);
    font-weight: 900;
    color: var(--rik-text-inverse);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 var(--rik-space-3);
    max-width: 22ch;
  }
  .lede {
    font-size: var(--rik-font-size-lead);
    color: var(--rik-text-inverse--muted);
    line-height: 1.55;
    margin: 0 0 var(--rik-space-3);
  }
  .budget {
    display: inline-block;
    padding: 8px 14px;
    background: var(--rik-surface-inverse__overlay);
    border: 1px solid var(--rik-border-inverse);
    border-radius: var(--rik-radius-pill);
    font: 600 var(--rik-font-size-sm)/1 var(--rik-font-mono);
    color: var(--rik-text-inverse--muted);
    margin: var(--rik-space-2) 0 0;
  }
  .budget strong { color: var(--rik-accent); font-weight: 800; }

  /* ── Typographic shelf · no card boxes, the type carries it ── */
  .shelf-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: shelf-row;
    border-top: 1px solid var(--rik-border-inverse);
  }
  .shelf-list li {
    border-bottom: 1px solid var(--rik-border-inverse);
  }
  .plugin {
    display: grid;
    grid-template-columns: 64px 44px 1fr auto;
    gap: var(--rik-space-4);
    align-items: center;
    padding: var(--rik-space-4) var(--rik-space-2);
    color: inherit;
    text-decoration: none;
    transition: background var(--rik-motion-fast) var(--rik-motion__ease-out),
                padding var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .plugin:hover {
    background: var(--rik-surface-inverse__overlay);
    padding-left: var(--rik-space-3);
    text-decoration: none;
  }

  .idx {
    font: 900 2.6rem/1 var(--rik-font-display);
    color: var(--rik-text-inverse--ghost);
    letter-spacing: -0.03em;
    align-self: center;
    text-align: center;
  }
  .plugin:hover .idx { color: var(--rik-accent); }

  .glyph {
    color: var(--rik-text-inverse--muted);
    display: inline-flex; align-items: center; justify-content: center;
    transition: color var(--rik-motion-fast) var(--rik-motion__ease-out),
                transform var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .plugin:hover .glyph {
    color: var(--rik-accent);
    transform: scale(1.06);
  }

  .body { min-width: 0; }
  .body > header {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: var(--rik-space-3);
    margin-bottom: 4px;
  }
  .body h3 {
    display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 10px;
    font-family: var(--rik-font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--rik-text-inverse);
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
  }
  .role { color: var(--rik-text-inverse); }
  .file {
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    color: var(--rik-accent);
    background: rgba(240, 112, 32, 0.12);
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0;
  }
  .size {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-inverse--muted);
    white-space: nowrap;
  }
  .size strong {
    color: var(--rik-text-inverse);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.005em;
  }
  .summary {
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-inverse--muted);
    line-height: 1.5;
    margin: 0 0 6px;
    max-width: 70ch;
  }
  .how {
    display: inline-flex; align-items: center; gap: 8px;
    margin: 0;
    font-size: var(--rik-font-size-sm);
  }
  .how-label {
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rik-text-inverse--faint);
  }
  .how-code {
    font: 700 var(--rik-font-size-sm)/1.3 var(--rik-font-mono);
    color: var(--rik-status-success);
    background: rgba(0, 200, 160, 0.10);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .chev {
    align-self: center;
    font: 700 1.4rem/1 var(--rik-font-mono);
    color: var(--rik-text-inverse--faint);
    transition: transform var(--rik-motion-fast) var(--rik-motion__ease-out),
                color var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .plugin:hover .chev {
    color: var(--rik-accent);
    transform: translateX(4px);
  }

  .footer-note {
    margin-top: var(--rik-space-5);
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-inverse--muted);
    line-height: 1.6;
  }
  .footer-note a {
    color: var(--rik-accent);
    font-weight: 700;
    text-decoration: none;
  }
  .footer-note a:hover { text-decoration: underline; }

  @media (max-width: 600px) {
    .plugin { grid-template-columns: 48px 36px 1fr; }
    .chev { display: none; }
    .idx { font-size: 2rem; }
    .body h3 { font-size: 1.25rem; }
  }
</style>
