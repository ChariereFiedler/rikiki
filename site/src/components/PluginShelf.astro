---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { gzipSync } from 'node:zlib';
const packageDir = resolve(process.cwd(), '../rikiki');
const measuredKb = (path: string) => {
  const kb = gzipSync(readFileSync(resolve(packageDir, path)), { level: 9 }).length / 1024;
  return kb < 10 ? Math.round(kb * 10) / 10 : Math.round(kb);
};
const plugins = [
  { role: 'transitions', file: 'deck-transition.js', size: `${measuredKb('dist/deck-transition.js')} KB`, activate: 'transition="slide"', summary: 'Add slide, fade, zoom or flip transitions only when a deck asks for them.', href: '/docs/plugins#transition', glyph: 'transitions' },
  { role: 'presenter mode', file: 'deck-presenter.js', size: `${measuredKb('dist/deck-presenter.js')} KB`, activate: 'press P', summary: 'Open the current slide, next slide, notes and timer in a synchronized presenter window.', href: '/docs/plugins#presenter', glyph: 'presenter' },
  { role: 'syntax highlighting', file: 'shiki.js', size: `${measuredKb('dist/shiki.js')} KB loader + ${measuredKb('dist/vendor/shiki.js')} KB engine`, activate: 'installShiki()', summary: 'Load TextMate syntax highlighting and its vendored engine on first use, with no CDN request.', href: '/docs/plugins#shiki', glyph: 'syntax' },
];
const extras = ['deck-agenda', 'deck-flow', 'deck-graph', 'deck-kpi-grid', 'deck-timeline', 'deck-versus'];
---

<section id="plugins" class="shelf">
  <div class="inner">
    <header class="head">
      <p class="eyebrow"><span class="num">06</span> Optional modules</p>
      <h2>Bring only the pieces the deck needs.</h2>
      <p class="lede">
        The ~43 KB initial load excludes these modules. In a source deck, imported
        modules load when their feature starts. A standalone bundle packages them locally.
      </p>
      <p class="budget">
        Sizes below are measured from the current gzip-compressed build artifacts.
      </p>
    </header>

    <ol class="shelf-list">
      {plugins.map((p, i) => (
        <li>
          <a class="plugin" href={p.href}>
            <span class="idx">{String(i + 1).padStart(2, '0')}</span>
            <span class="glyph" aria-hidden="true">
              {p.glyph === 'transitions' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="8" width="14" height="20" rx="2"></rect>
                  <rect x="19" y="8" width="14" height="20" rx="2" opacity="0.55"></rect>
                  <path d="M11 18 L25 18" stroke-dasharray="2 3"></path>
                  <path d="M22 15 L25 18 L22 21"></path>
                </svg>
              )}
              {p.glyph === 'presenter' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="6" width="20" height="14" rx="2"></rect>
                  <path d="M9 24 L15 24"></path>
                  <path d="M12 20 L12 24"></path>
                  <rect x="24" y="14" width="10" height="8" rx="1"></rect>
                  <path d="M24 18 L34 18" stroke-dasharray="2 2"></path>
                </svg>
              )}
              {p.glyph === 'syntax' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 8 L4 18 L11 28"></path>
                  <path d="M25 8 L32 18 L25 28"></path>
                  <path d="M20 6 L16 30" opacity="0.65"></path>
                </svg>
              )}
              {p.glyph === 'notes' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 6 H30 V25 H17 L10 32 V25 H6 Z"></path>
                  <path d="M11 13 L25 13" opacity="0.7"></path>
                  <path d="M11 18 L22 18" opacity="0.5"></path>
                </svg>
              )}
              {p.glyph === 'clicks' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 6 L6 22 L11 18 L14 25 L17 23 L14 16 L20 16 Z"></path>
                  <path d="M24 9 L29 9" opacity="0.6"></path>
                  <path d="M24 14 L31 14" opacity="0.45"></path>
                  <path d="M24 19 L29 19" opacity="0.3"></path>
                </svg>
              )}
            </span>
            <div class="body">
              <header>
                <h3>
                  <span class="role">{p.role}</span>
                  <code class="file">{p.file}</code>
                </h3>
                <span class="size"><strong>{p.size}</strong> gzip</span>
              </header>
              <p class="summary">{p.summary}</p>
              <p class="how">
                <span class="how-label">Activate</span>
                <code class="how-code">{p.activate}</code>
              </p>
            </div>
            <span class="chev" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="extras">
      <p class="extras-title">Extended components</p>
      <p class="extras-list">
        {extras.map((name, index) => (
          <>
            <a href={'/docs/components#' + name}><code>&lt;{name}&gt;</code></a>{index < extras.length - 1 && ' · '}
          </>
        ))}
        <span> · and more</span>
      </p>
    </div>

    <p class="footer-note">
      <a href="/docs/plugins">Read the plugin reference →</a>
    </p>
  </div>
</section>

<style>
  /* ── Dark editorial band · the tonal pivot of the page ── */
  .shelf {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
    padding: var(--rik-space-6) var(--rik-space-5);
    position: relative;
    overflow: hidden;
  }
  .shelf::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 8% 5%, rgba(240, 112, 32, 0.12) 0%, transparent 45%),
      radial-gradient(circle at 95% 95%, rgba(0, 200, 160, 0.08) 0%, transparent 55%);
    pointer-events: none;
  }
  .inner {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
  }

  .head { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr); gap:var(--rik-space-3) var(--rik-space-6); max-width:none; margin-bottom:var(--rik-space-6); }
  .head .eyebrow { grid-column:1 / -1; }
  .head h2 { grid-column:1; grid-row:2 / span 2; }
  .head .lede,.head .budget { grid-column:2; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    color: var(--rik-accent);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 var(--rik-space-3);
  }
  .eyebrow .num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 26px; height: 26px;
    background: var(--rik-accent);
    color: var(--rik-accent__on);
    border-radius: 50%;
    letter-spacing: 0;
  }
  h2 {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-mega);
    font-weight: 900;
    color: var(--rik-text-inverse);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 var(--rik-space-3);
    max-width: 22ch;
    overflow-wrap:anywhere;
  }
  .lede {
    font-size: var(--rik-font-size-lead);
    color: var(--rik-text-inverse--muted);
    line-height: 1.55;
    margin: 0 0 var(--rik-space-3);
  }
  .budget {
    display: inline-block;
    padding: 8px 14px;
    background: var(--rik-surface-inverse__overlay);
    border: 1px solid var(--rik-border-inverse);
    border-radius: var(--rik-radius-pill);
    font: 600 var(--rik-font-size-sm)/1 var(--rik-font-mono);
    color: var(--rik-text-inverse--muted);
    margin: var(--rik-space-2) 0 0;
  }
  .budget strong { color: var(--rik-accent); font-weight: 800; }

  /* ── Typographic shelf · no card boxes, the type carries it ── */
  .shelf-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: shelf-row;
    border-top: 1px solid var(--rik-border-inverse);
  }
  .shelf-list li {
    border-bottom: 1px solid var(--rik-border-inverse);
  }
  .plugin {
    display: grid;
    grid-template-columns: 64px 44px 1fr auto;
    gap: var(--rik-space-4);
    align-items: center;
    padding: var(--rik-space-4) var(--rik-space-2);
    color: inherit;
    text-decoration: none;
    transition: background var(--rik-motion-fast) var(--rik-motion__ease-out),
                padding var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .plugin:hover {
    background: var(--rik-surface-inverse__overlay);
    padding-left: var(--rik-space-3);
    text-decoration: none;
  }

  .idx {
    font: 900 2.6rem/1 var(--rik-font-display);
    color: var(--rik-text-inverse--faint);
    letter-spacing: -0.03em;
    align-self: center;
    text-align: center;
  }
  .plugin:hover .idx { color: var(--rik-accent); }

  .glyph {
    color: var(--rik-text-inverse--muted);
    display: inline-flex; align-items: center; justify-content: center;
    transition: color var(--rik-motion-fast) var(--rik-motion__ease-out),
                transform var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .plugin:hover .glyph {
    color: var(--rik-accent);
    transform: scale(1.06);
  }

  .body { min-width: 0; }
  .body > header {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: var(--rik-space-3);
    margin-bottom: 4px;
  }
  .body h3 {
    display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 10px;
    font-family: var(--rik-font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--rik-text-inverse);
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
  }
  .role { color: var(--rik-text-inverse); }
  .file {
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    color: var(--rik-accent);
    background: rgba(240, 112, 32, 0.12);
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0;
    white-space:normal;
    overflow-wrap:anywhere;
  }
  .size {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-inverse--muted);
    white-space: nowrap;
  }
  .size strong {
    color: var(--rik-text-inverse);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.005em;
  }
  .summary {
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-inverse--muted);
    line-height: 1.5;
    margin: 0 0 6px;
    max-width: 70ch;
  }
  .how {
    display: inline-flex; align-items: center; gap: 8px;
    margin: 0;
    font-size: var(--rik-font-size-sm);
  }
  .how-label {
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rik-text-inverse--faint);
  }
  .how-code {
    font: 700 var(--rik-font-size-sm)/1.3 var(--rik-font-mono);
    color: var(--rik-status-success);
    background: rgba(0, 200, 160, 0.10);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .chev {
    align-self: center;
    font: 700 1.4rem/1 var(--rik-font-mono);
    color: var(--rik-text-inverse--faint);
    transition: transform var(--rik-motion-fast) var(--rik-motion__ease-out),
                color var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .plugin:hover .chev {
    color: var(--rik-accent);
    transform: translateX(4px);
  }

  .footer-note {
    margin-top: var(--rik-space-5);
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-inverse--muted);
    line-height: 1.6;
  }
  .footer-note a {
    color: var(--rik-accent);
    font-weight: 700;
    text-decoration: none;
  }
  .footer-note a:hover { text-decoration: underline; }
  .extras {
    margin-top: var(--rik-space-6);
    padding-top: var(--rik-space-4);
    border-top: 1px solid var(--rik-border-inverse);
  }
  .extras-title {
    margin: 0 0 var(--rik-space-2);
    color: var(--rik-text-inverse--faint);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .extras-list { margin: 0; color: var(--rik-text-inverse--muted); line-height: 1.8; }
  .extras-list a { color: var(--rik-text-inverse); text-decoration: none; }
  .extras-list a:hover { color: var(--rik-accent); }

  @media (max-width: 600px) {
    .shelf { padding-inline: var(--rik-space-3); }
    .head { grid-template-columns:1fr; margin-bottom:var(--rik-space-4); }
    .head .eyebrow,.head h2,.head .lede,.head .budget { grid-column:1; grid-row:auto; }
    .plugin {
      grid-template-columns: minmax(36px,auto) minmax(0, 1fr);
      gap: var(--rik-space-3);
      align-items: start;
      padding: var(--rik-space-4) 0;
    }
    .chev { display: none; }
    .glyph { display:none; }
    .idx { font-size: 1rem; color:var(--rik-accent); text-align:left; padding-top:5px; }
    .body h3 { font-size: 1.25rem; }
    .body h3,.role { overflow-wrap:anywhere; }
    .body > header { align-items:flex-start; }
    .size { font-size:var(--rik-font-size-xs); }
    .summary { font-size:var(--rik-font-size-sm); }
    .summary { line-height:1.65; margin-block:8px 10px; color:var(--rik-text-inverse--muted); overflow-wrap:anywhere; }
    .how { max-width:100%; flex-wrap:wrap; gap:10px; }
    .how-code { overflow-wrap:anywhere; }
    .budget { line-height:1.45; border-radius:4px; }
  }
  @media (max-width:480px) {
    .body > header { flex-direction:column; gap:8px; }
    .size { align-self:flex-start; }
  }
</style>
