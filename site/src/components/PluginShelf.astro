---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { gzipSync } from 'node:zlib';
import Eyebrow from './Eyebrow.astro';
const packageDir = resolve(process.cwd(), '../rikiki');
const measuredKb = (path: string) => {
  const kb = gzipSync(readFileSync(resolve(packageDir, path)), { level: 9 }).length / 1024;
  return kb < 10 ? Math.round(kb * 10) / 10 : Math.round(kb);
};
const plugins = [
  { role: 'transitions', file: 'deck-transition.js', mass: `${measuredKb('dist/deck-transition.js')}`, unit: 'KB gzip', activate: 'transition="slide"', summary: 'Add slide, fade, zoom or flip transitions only when a deck asks for them.', href: '/docs/plugins#transition' },
  { role: 'presenter mode', file: 'deck-presenter.js', mass: `${measuredKb('dist/deck-presenter.js')}`, unit: 'KB gzip', activate: 'press P', summary: 'Open the current slide, next slide, notes and timer in a synchronized presenter window.', href: '/docs/plugins#presenter' },
  { role: 'syntax highlighting', file: 'shiki.js', mass: `${measuredKb('dist/shiki.js')} + ${measuredKb('dist/vendor/shiki.js')}`, unit: 'KB gzip, loader + engine', activate: 'installShiki()', summary: 'Load TextMate syntax highlighting and its vendored engine on first use, with no CDN request.', href: '/docs/plugins#shiki' },
];
const extras = ['deck-agenda', 'deck-flow', 'deck-graph', 'deck-kpi-grid', 'deck-timeline', 'deck-versus'];
---

<section id="plugins" class="shelf">
  <div class="inner">
    <header class="head">
      <Eyebrow text="Optional modules" tone="inverse" />
      <h2>Bring only the pieces the deck needs.</h2>
      <p class="lede">
        The ~43 KB initial load excludes these modules. In a source deck, imported
        modules load when their feature starts. A standalone bundle packages them locally.
      </p>
      <p class="budget">
        Sizes below are measured from the current gzip-compressed build artifacts.
      </p>
    </header>

    <ol class="shelf-list">
      {plugins.map((p) => (
        <li>
          <a class="plugin" href={p.href}>
            <span class="mass">
              <strong>{p.mass}</strong>
              <span class="unit">{p.unit}</span>
            </span>
            <div class="body">
              <h3>
                <span class="role">{p.role}</span>
                <code class="file">{p.file}</code>
              </h3>
              <p class="summary">{p.summary}</p>
              <p class="how">
                <span class="how-label">Activate</span>
                <code class="how-code">{p.activate}</code>
              </p>
            </div>
          </a>
        </li>
      ))}
    </ol>

    <div class="extras">
      <p class="extras-title">Optional component modules</p>
      <p class="extras-list">
        {extras.map((name, index) => (
          <>
            <a href={'/docs/components#' + name}><code>&lt;{name}&gt;</code></a>{index < extras.length - 1 && ' · '}
          </>
        ))}
        <span> · and more</span>
      </p>
      <p class="extras-note">
        A deck is plain HTML, so your own custom elements or a stylesheet can sit
        next to it and load with a <code>&lt;script type="module"&gt;</code> tag,
        with no build step. <a href="/docs/api">Read the API reference</a>
      </p>
    </div>

    <p class="footer-note">
      <a href="/docs/plugins">Read the optional-module reference</a>
    </p>
  </div>
</section>

<style>
  /* ── Dark editorial band · the tonal pivot of the page ── */
  .shelf {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
    padding: var(--rik-space-6) var(--rik-space-5);
    position: relative;
    overflow: hidden;
  }
  .inner {
    position: relative;
    max-width: var(--rik-measure-page);
    margin: 0 auto;
  }

  .head { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr); gap:var(--rik-space-3) var(--rik-space-6); max-width:none; margin-bottom:var(--rik-space-6); }
  .head :global(.eyebrow) { grid-column:1 / -1; }
  .head h2 { grid-column:1; grid-row:2 / span 2; }
  .head .lede,.head .budget { grid-column:2; }
  h2 {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-mega);
    font-weight: 900;
    color: var(--rik-text-inverse);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 var(--rik-space-3);
    max-width: 22ch;
    overflow-wrap:anywhere;
  }
  .lede {
    font-size: var(--rik-font-size-lead);
    color: var(--rik-text-inverse--muted);
    line-height: 1.55;
    margin: 0 0 var(--rik-space-3);
  }
  .budget {
    display: inline-block;
    padding: 8px 14px;
    background: var(--rik-surface-inverse__overlay);
    border: 1px solid var(--rik-border-inverse);
    border-radius: var(--rik-radius-pill);
    font: 600 var(--rik-font-size-sm)/1 var(--rik-font-mono);
    color: var(--rik-text-inverse--muted);
    margin: var(--rik-space-2) 0 0;
  }
  .budget strong { color: var(--rik-accent); font-weight: 800; }

  /* ── Typographic shelf · no card boxes, the type carries it ──
     One shared grid so the three masses sit on one left edge and the
     widest one (loader + engine) sets the column. The measured size is
     the biggest thing in the row: what you pay is what you read first. */
  .shelf-list {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rik-border-inverse);
  }
  .shelf-list li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    border-bottom: 1px solid var(--rik-border-inverse);
  }
  .shelf-list li:last-child { border-bottom: 0; }
  .plugin {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    column-gap: var(--rik-space-5);
    align-items: center;
    padding: var(--rik-space-4) var(--rik-space-2);
    color: inherit;
    text-decoration: none;
    transition: background var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .plugin:hover {
    background: var(--rik-surface-inverse__overlay);
    text-decoration: none;
  }

  .mass {
    display: grid;
    gap: var(--rik-space-hair);
    align-content: start;
    min-width: 0;
  }
  .mass strong {
    font: 900 var(--rik-font-size-mass)/1 var(--rik-font-display);
    color: var(--rik-text-inverse);
    letter-spacing: -0.03em;
    white-space: nowrap;
    transition: color var(--rik-motion-fast) var(--rik-motion__ease-out);
  }
  .plugin:hover .mass strong { color: var(--rik-accent); }
  .unit {
    font: 600 var(--rik-font-size-sm)/1.3 var(--rik-font-sans);
    color: var(--rik-text-inverse--muted);
  }

  .body { min-width: 0; }
  .body h3 {
    display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: var(--rik-space-2);
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-lead);
    font-weight: 800;
    color: var(--rik-text-inverse);
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0 0 var(--rik-space-hair);
  }
  .role { color: var(--rik-text-inverse); }
  /* The file name is the one thing to copy, so it is the one mango fill.
     Night text on mango clears 5:1; mango on the night panel clears 6:1. */
  .file {
    font: 700 var(--rik-font-size-sm)/1.2 var(--rik-font-mono);
    color: var(--rik-accent__on);
    background: var(--rik-accent);
    padding: var(--rik-space-hair) var(--rik-space-1);
    border-radius: var(--rik-radius-xs);
    letter-spacing: 0;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .summary {
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-inverse--muted);
    line-height: 1.5;
    margin: 0 0 6px;
    max-width: 70ch;
  }
  .how {
    display: inline-flex; align-items: center; gap: 8px;
    margin: 0;
    font-size: var(--rik-font-size-sm);
  }
  .how-label {
    font: 600 var(--rik-font-size-sm)/1 var(--rik-font-sans);
    color: var(--rik-text-inverse--muted);
  }
  .how-code {
    font: 700 var(--rik-font-size-sm)/1.3 var(--rik-font-mono);
    color: var(--rik-status-success);
    background: var(--rik-status-success__bg);
    padding: var(--rik-space-hair) var(--rik-space-1);
    border-radius: var(--rik-radius-xs);
  }

  .footer-note {
    margin-top: var(--rik-space-5);
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-inverse--muted);
    line-height: 1.6;
  }
  .footer-note a {
    color: var(--rik-accent);
    font-weight: 700;
    text-decoration: none;
  }
  .footer-note a:hover { text-decoration: underline; }
  .extras {
    margin-top: var(--rik-space-6);
    padding-top: var(--rik-space-4);
    border-top: 1px solid var(--rik-border-inverse);
  }
  .extras-title {
    margin: 0 0 var(--rik-space-2);
    color: var(--rik-text-inverse--muted);
    font: 600 var(--rik-font-size-sm)/1.3 var(--rik-font-sans);
  }
  .extras-list { margin: 0; color: var(--rik-text-inverse--muted); line-height: 1.8; }
  .extras-list a { color: var(--rik-text-inverse); text-decoration: none; }
  .extras-list a:hover { color: var(--rik-accent); }
  .extras-note { margin: var(--rik-space-3) 0 0; max-width: 72ch; color: var(--rik-text-inverse--muted); font-size: var(--rik-font-size-md); line-height: 1.65; }
  .extras-note code { color: var(--rik-text-inverse); font-family: var(--rik-font-mono); overflow-wrap: anywhere; }
  .extras-note a { color: var(--rik-accent); font-weight: 700; text-decoration: none; white-space: nowrap; }

  @media (max-width: 600px) {
    .shelf { padding-inline: var(--rik-space-3); }
    .head { grid-template-columns:1fr; margin-bottom:var(--rik-space-4); }
    .head :global(.eyebrow),.head h2,.head .lede,.head .budget { grid-column:1; grid-row:auto; }
    .shelf-list, .shelf-list li { display: block; }
    .plugin {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--rik-space-3);
      align-items: start;
      padding: var(--rik-space-4) 0;
    }
    .mass { grid-template-columns: auto minmax(0, 1fr); align-items: baseline; column-gap: var(--rik-space-2); }
    .body h3,.role { overflow-wrap:anywhere; }
    .summary { font-size:var(--rik-font-size-sm); line-height:1.65; margin-block:8px 10px; overflow-wrap:anywhere; }
    .how { max-width:100%; flex-wrap:wrap; gap:10px; }
    .how-code { overflow-wrap:anywhere; }
    .budget { line-height:1.45; border-radius:4px; }
  }
</style>
