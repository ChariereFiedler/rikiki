---
// Static code block · derived from <deck-code> (same dark surface + syntax
// colors). We highlight at build time here, not at runtime, since this is
// purely a marketing snippet · no need to ship a highlighter.
interface Props {
  lang?: 'html' | 'js' | 'ts' | 'css' | 'sh';
  code: string;
  label?: string;
}
const { lang = 'html', code, label } = Astro.props;

function highlight(src: string, lang: string): string {
  let s = src.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  // Stash injected spans behind opaque placeholders so later passes can't see
  // (and re-highlight) the class="..." attributes inside them.
  const stash: string[] = [];
  const put = (cls: string, text: string): string => {
    const id = `P${stash.length}E`;
    stash.push(`<span class="${cls}">${text}</span>`);
    return id;
  };

  if (lang === 'html') {
    s = s.replace(/(&lt;!--[\s\S]*?--&gt;)/g, (m) => put('cmt', m));
    s = s.replace(/(&lt;!doctype[^&]*&gt;)/gi, (m) => put('cmt', m));
    s = s.replace(/("[^"]*"|'[^']*')/g, (m) => put('str', m));
    s = s.replace(/(&lt;\/?)([a-zA-Z][a-zA-Z0-9:-]*)/g,
      (_m, lt: string, tag: string) => lt + put('kw', tag));
    s = s.replace(/\b([a-zA-Z][a-zA-Z0-9-]*)(?==)/g, (m) => put('prop', m));
  } else if (lang === 'js' || lang === 'ts') {
    s = s.replace(/(\/\/[^\n]*)/g, (m) => put('cmt', m));
    s = s.replace(/(['"`])((?:\\.|(?!\1)[^\\])*)\1/g, (m) => put('str', m));
    s = s.replace(/\b(const|let|var|function|return|if|else|class|extends|new|export|import|from|as|await|async|of|in|typeof|true|false|null|undefined)\b/g,
      (m) => put('kw', m));
  } else if (lang === 'sh') {
    // One command per line · `$` prompt, binary, sub-command, then the
    // arguments (a file argument gets its own colour).
    s = s.split('\n').map((line) => {
      const m = line.match(/^(\$\s+)?(\S+)(\s+\S+)?(.*)$/);
      if (!m) return line;
      const [, prompt = '', bin, verb = '', rest = ''] = m;
      const args = rest.replace(/(\S+)/g, (arg) => put(/\.[a-z]+$/.test(arg) ? 'ty' : 'str', arg));
      return (prompt ? put('cmt', prompt.trimEnd()) + ' ' : '') + put('kw', bin) + verb.replace(/\S+/, (v) => put('fn', v)) + args;
    }).join('\n');
  } else if (lang === 'css') {
    // Comments first
    s = s.replace(/(\/\*[\s\S]*?\*\/)/g, (m) => put('cmt', m));
    // Strings
    s = s.replace(/("[^"]*"|'[^']*')/g, (m) => put('str', m));
    // CSS custom properties · --foo
    s = s.replace(/(--[a-zA-Z][a-zA-Z0-9_-]*)/g, (m) => put('prop', m));
    // At-rules · @media, @import, @keyframes
    s = s.replace(/(@[a-zA-Z-]+)/g, (m) => put('kw', m));
    // Hex colors · #f07020, #fff
    s = s.replace(/(#[0-9a-fA-F]{3,8})\b/g, (m) => put('num', m));
    // Numeric values with units · 12px, 1.5rem, 50%, 100vh
    s = s.replace(/\b(\d+(?:\.\d+)?(?:px|rem|em|vh|vw|vmin|vmax|ch|%|ms|s|deg|fr)?)\b/g,
      (m) => put('num', m));
    // Pseudo-classes / pseudo-elements
    s = s.replace(/(:{1,2}[a-zA-Z-]+(?:\([^)]*\))?)/g, (m) => put('ty', m));
    // CSS functions · var, calc, clamp, rgb, etc.
    s = s.replace(/\b(var|calc|clamp|min|max|rgb|rgba|hsl|hsla|linear-gradient|radial-gradient|cubic-bezier|url|attr|env)(?=\()/g,
      (m) => put('fn', m));
    // Property names (followed by a colon)
    s = s.replace(/\b([a-zA-Z-]+)(?=\s*:)/g, (m) => put('prop', m));
  }
  return s.replace(/P(\d+)E/g, (_m, i: string) => stash[+i] ?? '');
}
const highlighted = highlight(code.trim(), lang);
---

<figure class="code">
  {label && <figcaption class="label">{label}</figcaption>}
  <div class="block">
    <pre><code set:html={highlighted}></code></pre>
    <button type="button" class="copy" aria-label="Copy code to clipboard" data-code={code.trim()}>
      <span class="icon" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </span>
      <span class="label-text">Copy</span>
    </button>
  </div>
</figure>

<style>
  .code {
    margin: 0;
    display: flex; flex-direction: column;
    gap: var(--rik-space-2);
    /* min-width: 0 lets us shrink inside a grid/flex parent · without it
       the <pre>'s intrinsic min-content width (one line of code) wins and
       the figure overflows its grid track on narrow viewports. */
    min-width: 0;
  }
  .label {
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rik-text-default--faint);
  }
  pre {
    margin: 0;
    background: var(--rik-code__bg);
    color: var(--rik-code__text);
    border: 1px solid var(--rik-code__border);
    border-radius: var(--rik-radius-md);
    padding: var(--rik-space-4);
    overflow: auto;
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-mono);
    line-height: 1.7;
    box-shadow: var(--rik-elevation-2);
  }
  code { display: block; font-size: inherit; }
  pre :global(.kw)   { color: var(--rik-code__syntax-keyword); }
  pre :global(.str)  { color: var(--rik-code__syntax-string); }
  pre :global(.prop) { color: var(--rik-code__syntax-property); }
  pre :global(.cmt)  { color: var(--rik-code__syntax-comment); font-style: italic; }
  pre :global(.num)  { color: var(--rik-code__syntax-number); }
  pre :global(.ty)   { color: var(--rik-code__syntax-type); }
  pre :global(.fn)   { color: var(--rik-code__syntax-function); }

  /* Copy button · sits top-right of the code block, only visible on hover */
  .block { position: relative; min-width: 0; }
  /* The affordance is opaque on purpose · a translucent chip composites
     against whatever sits behind the figure, so its label contrast stopped
     being a property of the button. Night surface + full-strength inverse
     text reads at ~15:1 wherever the block is placed. */
  .copy {
    position: absolute;
    top: var(--rik-space-1);
    right: var(--rik-space-1);
    display: inline-flex;
    align-items: center;
    gap: var(--rik-space-2xs);
    min-height: var(--rik-code-copy__height);
    padding: var(--rik-space-2xs) var(--rik-space-2);
    background: var(--rik-code-copy__bg);
    border: 1px solid var(--rik-code-copy__border);
    border-radius: var(--rik-control-radius);
    color: var(--rik-code-copy__text);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-sans);
    cursor: pointer;
    opacity: var(--rik-code-copy__opacity);
    transition: opacity 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .block:hover .copy,
  .copy:focus-visible { opacity: 1; }
  .copy:hover { border-color: var(--rik-accent); }
  .copy.copied { color: var(--rik-status-success); border-color: var(--rik-status-success); }
  .copy .icon { display: inline-flex; }
</style>

<script is:inline>
  document.querySelectorAll('.code .copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code') || '';
      try {
        await navigator.clipboard.writeText(code);
      } catch { /* clipboard API failed (e.g. insecure context) · accept silently */ }
      const label = btn.querySelector('.label-text');
      const original = label?.textContent;
      btn.classList.add('copied');
      if (label) label.textContent = 'Copied';
      window.setTimeout(() => {
        btn.classList.remove('copied');
        if (label && original) label.textContent = original;
      }, 1400);
    });
  });
</script>
