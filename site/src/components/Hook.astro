---
// Closing hook · derived from <deck-takeaway>: one centred punchline on
// night, a caption, two actions and the two setup commands. The page opens
// as a cover (Hero, left-aligned, accent in the title) and closes as a
// takeaway (centred, no accent in the type · the mango is spent on the
// primary button and the copy affordance only).
import CodeBlock from './CodeBlock.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
  kicker?: string;
  punch: string;
  caption?: string;
}
const { kicker, punch, caption } = Astro.props;
const setup = `$ npm install rikiki-deck
$ npx rikiki init index.html`;
---

<section class="hook">
  <div class="inner">
    {kicker && <Eyebrow text={kicker} tone="inverse" />}
    <p class="punch" set:html={punch}></p>
    {caption && <p class="caption">{caption}</p>}
    <div class="actions">
      <a class="btn btn-primary" href="/docs/getting-started">Create your first deck</a>
      <a class="btn btn-ghost" href="/llms.txt">Open the agent reference (plain text)</a>
    </div>
    <div class="install">
      <CodeBlock lang="sh" code={setup} />
    </div>
  </div>
</section>

<style>
  .hook {
    --rik-btn-ghost__border: var(--rik-border-inverse--strong);
    --rik-btn-ghost__text: var(--rik-text-inverse);
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
    padding: var(--rik-space-7) var(--rik-space-5);
    text-align: center;
  }
  .inner {
    max-width: var(--rik-measure-page);
    margin: 0 auto;
    display: flex; flex-direction: column;
    align-items: center;
    gap: var(--rik-space-3);
  }
  .inner :global(.eyebrow) { justify-content: center; }
  .punch {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-display);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--rik-text-inverse);
    max-width: 14ch;
    overflow-wrap: anywhere;
  }
  .caption {
    font-size: var(--rik-font-size-lead);
    color: var(--rik-text-inverse--muted);
    max-width: 50ch;
    margin-top: var(--rik-space-3);
  }
  .actions {
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
    gap: var(--rik-space-3);
    margin-top: var(--rik-space-3);
  }
  /* The copy chip is the visible call to action here, not a hover reveal. */
  .install {
    --rik-code-copy__bg: var(--rik-accent);
    --rik-code-copy__border: var(--rik-accent);
    --rik-code-copy__text: var(--rik-accent__on);
    --rik-code-copy__opacity: 1;
    width: min(100%, 34rem);
    margin-top: var(--rik-space-4);
    text-align: left;
  }
  @media (max-width: 640px) {
    .hook { padding: var(--rik-space-6) var(--rik-space-3); }
    /* 12vw keeps "standalone" on one line at 390 · the longest word of
       the punch sets the ceiling, overflow-wrap only guards the rest. */
    .punch { font-size: clamp(2.25rem, 12vw, 4.5rem); }
    .actions { flex-direction: column; align-items: stretch; align-self: stretch; }
  }
</style>
