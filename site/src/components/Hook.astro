---
// Closing hook · derived from <deck-hook>. Big punchline on dark.
interface Props {
  kicker?: string;
  punch: string;
  caption?: string;
}
const { kicker, punch, caption } = Astro.props;
---

<section class="hook">
  <div class="inner">
    {kicker && <p class="kicker">{kicker}</p>}
    <p class="punch" set:html={punch}></p>
    {caption && <p class="caption">{caption}</p>}
  </div>
</section>

<style>
  .hook {
    background: var(--dark);
    color: var(--on-dark-text);
    padding: var(--sp-7) var(--sp-5);
    text-align: center;
  }
  .inner {
    max-width: 880px;
    margin: 0 auto;
    display: flex; flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }
  .kicker {
    font-family: var(--mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-faint);
    margin-bottom: var(--sp-2);
  }
  .punch {
    font-family: var(--display);
    font-size: var(--fs-display);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--on-dark-text);
  }
  .punch :global(.accent) { color: var(--mango); }
  .caption {
    font-size: var(--fs-lead);
    color: var(--on-dark-muted);
    max-width: 50ch;
    margin-top: var(--sp-3);
  }
</style>
