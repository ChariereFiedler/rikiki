---
// Closing hook · derived from <deck-takeaway>. Big punchline on dark.
interface Props {
  kicker?: string;
  punch: string;
  caption?: string;
}
const { kicker, punch, caption } = Astro.props;
---

<section class="hook">
  <div class="inner">
    {kicker && <p class="kicker">{kicker}</p>}
    <p class="punch" set:html={punch}></p>
    {caption && <p class="caption">{caption}</p>}
    <div class="actions">
      <a class="primary" href="/docs/getting-started">Create your first deck</a>
      <a href="/llms.txt">Give the reference to an agent →</a>
    </div>
    <button class="install" type="button" data-copy="npm install rikiki" aria-label="Copy npm install rikiki">
      <code>npm install rikiki</code><span>Copy</span>
    </button>
  </div>
</section>

<style>
  .hook {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
    padding: var(--rik-space-7) var(--rik-space-5);
    text-align: center;
  }
  .inner {
    max-width: 880px;
    margin: 0 auto;
    display: flex; flex-direction: column;
    align-items: center;
    gap: var(--rik-space-3);
  }
  .kicker {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rik-text-inverse--faint);
    margin-bottom: var(--rik-space-2);
  }
  .punch {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-display);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--rik-text-inverse);
    overflow-wrap:anywhere;
  }
  .punch :global(.accent) { color: var(--rik-accent); }
  .caption {
    font-size: var(--rik-font-size-lead);
    color: var(--rik-text-inverse--faint);
    max-width: 50ch;
    margin-top: var(--rik-space-3);
  }
  .actions { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:var(--rik-space-3); margin-top:var(--rik-space-3); }
  .actions a { color:var(--rik-text-inverse); font-weight:750; text-decoration:none; }
  .actions .primary { padding:12px 18px; color:var(--rik-accent__on); background:var(--rik-accent); border-radius:4px; }
  .actions a:hover { text-decoration:underline; }
  .install { display:inline-flex; max-width:100%; align-items:center; gap:var(--rik-space-3); padding:12px 16px; color:var(--rik-text-inverse); background:var(--rik-surface-inverse__overlay); border:1px solid var(--rik-border-inverse--strong); border-radius:4px; cursor:pointer; }
  .install code { min-width:0; font:700 var(--rik-font-size-body)/1.3 var(--rik-font-mono); white-space:normal; overflow-wrap:anywhere; }
  .install span { color:var(--rik-accent); font:800 var(--rik-font-size-xs)/1 var(--rik-font-mono); letter-spacing:.08em; text-transform:uppercase; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy || '');
      const label = button.querySelector('span');
      if (label) label.textContent = 'Copied';
    });
  });
</script>
