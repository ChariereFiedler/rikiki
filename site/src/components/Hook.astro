---
// Closing hook · derived from <deck-takeaway>. Big punchline on dark.
import Eyebrow from './Eyebrow.astro';

interface Props {
  kicker?: string;
  punch: string;
  caption?: string;
}
const { kicker, punch, caption } = Astro.props;
---

<section class="hook">
  <div class="inner">
    {kicker && <Eyebrow text={kicker} tone="inverse" />}
    <p class="punch" set:html={punch}></p>
    {caption && <p class="caption">{caption}</p>}
    <div class="actions">
      <a class="btn btn-primary" href="/docs/getting-started">Create your first deck</a>
      <a class="btn btn-ghost" href="/llms.txt">Open the agent reference (plain text)</a>
    </div>
    <button class="install" type="button" data-copy={'npm install rikiki-deck\nnpx rikiki init index.html'} aria-label="Copy setup commands">
      <span class="commands" aria-hidden="true">
        <code><span class="prompt">$</span> npm install rikiki-deck</code>
        <code><span class="prompt">$</span> npx rikiki init index.html</code>
      </span><span data-copy-label>Copy setup</span>
    </button>
  </div>
</section>

<style>
  .hook {
    --rik-btn-ghost__border: var(--rik-border-inverse--strong);
    --rik-btn-ghost__text: var(--rik-text-inverse);
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
    padding: var(--rik-space-7) var(--rik-space-5);
  }
  .inner {
    max-width: var(--rik-measure-page);
    margin: 0 auto;
    display: flex; flex-direction: column;
    align-items: flex-start;
    gap: var(--rik-space-3);
  }
  .punch {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-display);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--rik-text-inverse);
    max-width: 14ch;
    overflow-wrap: anywhere;
  }
  .caption {
    font-size: var(--rik-font-size-lead);
    color: var(--rik-text-inverse--muted);
    max-width: 50ch;
    margin-top: var(--rik-space-3);
  }
  .actions { display:flex; align-items:center; flex-wrap:wrap; gap:var(--rik-space-3); margin-top:var(--rik-space-3); }
  .install {
    display:inline-flex; max-width:100%; align-items:center; gap:var(--rik-space-4);
    margin-top:var(--rik-space-3); padding:var(--rik-space-3) var(--rik-space-4);
    color:var(--rik-text-inverse); background:var(--rik-surface-inverse__overlay);
    border:1px solid var(--rik-border-inverse--strong); border-radius:var(--rik-control-radius);
    /* A <button> does not inherit the page font · without this it falls back
       to the UA default (Arial) and breaks the one-control-font rule. */
    font-family:var(--rik-font-sans);
    cursor:pointer; text-align:left;
  }
  .install:focus-visible { outline: var(--rik-focus-ring--width) solid var(--rik-focus-ring); outline-offset: var(--rik-focus-ring--offset); }
  .install code { min-width:0; color:var(--rik-text-inverse); font:600 var(--rik-font-size-body)/1.3 var(--rik-font-mono); white-space:normal; overflow-wrap:anywhere; }
  .commands { display:grid; min-width:0; gap:var(--rik-space-hair); }
  .commands .prompt { color:var(--rik-text-inverse--faint); }
  [data-copy-label] { color:var(--rik-text-inverse--muted); font:700 var(--rik-font-size-sm)/1 var(--rik-font-sans); white-space:nowrap; }
  @media (max-width: 640px) {
    .hook { padding: var(--rik-space-6) var(--rik-space-3); }
    .actions { flex-direction: column; align-items: stretch; align-self: stretch; }
    .install { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy || '');
      const label = button.querySelector('[data-copy-label]');
      if (label) label.textContent = 'Copied';
    });
  });
</script>
