---
// Authoring-time DX highlight · rikiki's built-in livereload poller.
// LIVE demo: edit the syntax-highlighted slide source on the left, the rikiki
// preview on the right re-renders and flashes the real livereload toast ·
// the same edit → reload loop you get with ?live while authoring.
const defaultSrc = `<deck-cover brand="rikiki · live" speaker="You">
  <h1>Edit me →</h1>
  <p class="sub">Change the source · use ‹ › to move</p>
</deck-cover>

<deck-feature eyebrow="Live">
  <h1 slot="title">Type, then navigate</h1>
  <deck-md>
- edit any slide on the left
- the preview **reloads** as you type
- step through it with ‹ › on the right
  </deck-md>
</deck-feature>

<deck-takeaway>
  <h1>Ship the folder.</h1>
</deck-takeaway>`;
---

<section id="livereload" class="livereload">
  <div class="inner">
    <header class="head">
      <p class="eyebrow"><span class="num">DX</span> Livereload</p>
      <h2>Edit a slide. The deck reloads itself.</h2>
      <p class="lede">
        A tiny built-in poller watches your deck files and reloads the page the
        moment one changes · landing you right back on the slide you were
        editing. Zero config, authoring-only, never shipped to the audience.
        Try it live below.
      </p>
    </header>

    <div class="lr-grid">
      <figure class="pane">
        <figcaption>Edit · slide source</figcaption>
        <div class="lr-editor">
          <pre class="lr-hl" aria-hidden="true"></pre>
          <textarea class="lr-src" spellcheck="false" autocapitalize="off"
            autocomplete="off" autocorrect="off" aria-label="Editable slide source">{defaultSrc}</textarea>
        </div>
      </figure>

      <figure class="pane">
        <figcaption>Preview · reloads on edit</figcaption>
        <div class="lr-screen">
          <iframe class="lr-frame" title="Live rikiki preview"
            sandbox="allow-scripts allow-same-origin"></iframe>
          <span class="lr-toast">livereload on</span>
          <div class="lr-nav">
            <button type="button" data-k="ArrowLeft" aria-label="Previous slide">‹</button>
            <button type="button" data-k="ArrowRight" aria-label="Next slide">›</button>
          </div>
        </div>
      </figure>
    </div>

    <p class="note">
      Enable it on any deck by appending <code>?live</code> to the URL · the core
      lazy-imports the poller on demand. Prefer it always on while authoring?
      Load <code>dist/livereload.js</code> directly and it auto-starts on import.
    </p>
  </div>
</section>

<script>
  const root = document.getElementById('livereload');
  const ta = root?.querySelector('.lr-src') as HTMLTextAreaElement | null;
  const hl = root?.querySelector('.lr-hl') as HTMLElement | null;
  const frame = root?.querySelector('.lr-frame') as HTMLIFrameElement | null;
  const toast = root?.querySelector('.lr-toast') as HTMLElement | null;

  if (ta && hl && frame && toast) {
    const screen = frame.parentElement as HTMLElement;

    // ── tiny HTML highlighter (decorative) · stash strings/comments first so
    //    later passes can't clobber them, then tags + attribute names. ──
    const esc = (s: string): string =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const highlight = (src: string): string => {
      const stash: string[] = [];
      const keep = (cls: string, text: string): string => {
        stash.push('<span class="' + cls + '">' + text + '</span>');
        return '~~~' + (stash.length - 1) + '~~~';
      };
      let s = esc(src);
      s = s.replace(/(&lt;!--[\s\S]*?--&gt;)/g, (m) => keep('t-cmt', m));
      s = s.replace(/("[^"]*"|'[^']*')/g, (m) => keep('t-str', m));
      s = s.replace(/(&lt;\/?)([a-zA-Z][\w-]*)/g, (_m, lt, tag) => lt + keep('t-tag', tag));
      s = s.replace(/([a-zA-Z_:][\w:.-]*)(=)/g, (_m, name, eq) => keep('t-attr', name) + eq);
      s = s.replace(/~~~(\d+)~~~/g, (_m, i) => stash[+i]);
      return s;
    };

    const paint = (): void => {
      // trailing newline so the last line is reachable in the mirror
      hl.innerHTML = highlight(ta.value) + '\n';
      hl.scrollTop = ta.scrollTop;
      hl.scrollLeft = ta.scrollLeft;
    };

    // ── preview · render at a fixed canvas, scale to the pane width so rikiki's
    //    rem typography stays proportional in the embed (same trick as the hero
    //    LiveDemo). 1280×800 = the pane's 16:10. ──
    const CANVAS_W = 1280;
    const fit = (): void => {
      const w = screen.getBoundingClientRect().width;
      if (w > 0) frame.style.transform = 'scale(' + (w / CANVAS_W) + ')';
    };

    const buildDoc = (slide: string): string =>
      '<!doctype html><html><head><meta charset="UTF-8">' +
      '<link rel="stylesheet" href="/rikiki/tokens.css">' +
      '<script type="module" src="/rikiki/dist/index.js"><' + '/script>' +
      '<style>html,body{margin:0;height:100%;overflow:hidden;background:var(--rik-surface-page)}</style>' +
      '</head><body><deck-root>' + slide + '</deck-root></body></html>';

    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    const flash = (text: string): void => {
      toast.textContent = text;
      toast.classList.add('pulse');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.remove('pulse');
        toast.textContent = 'livereload on';
      }, 1400);
    };

    // The iframe document (with the rikiki bundle) loads ONCE. Edits then swap
    // only the <deck-root> in place · no document reload, no white flash, no
    // "plop" · just a quick crossfade on the new slide.
    let ready = false;
    let pending: string | null = null;

    const swap = (slide: string): void => {
      const doc = frame.contentDocument;
      if (!doc || !doc.body) return;
      // Stay on the slide the user is viewing · read the active slide's index
      // off the old deck, then seed the hash so the fresh deck-root lands there
      // on init (deck-root reads location.hash in firstUpdated). Mirrors how the
      // real livereload keeps the hash across a reload.
      const prev = doc.querySelector('deck-root');
      let idx = 0;
      if (prev) {
        const slides = Array.from(prev.children).filter((c) => c.tagName.startsWith('DECK-'));
        idx = Math.max(0, slides.findIndex((s) => s.hasAttribute('active')));
      }
      try {
        const cw = frame.contentWindow;
        if (cw) cw.location.hash = '#' + (idx + 1);
      } catch { /* srcdoc may reject hash writes · falls back to slide 1 */ }
      doc.body.innerHTML = '<deck-root>' + slide + '</deck-root>';
      const dr = doc.body.firstElementChild as HTMLElement | null;
      if (dr) {
        dr.style.opacity = '0';
        dr.style.transition = 'opacity 0.22s ease';
        requestAnimationFrame(() => requestAnimationFrame(() => { dr.style.opacity = '1'; }));
      }
    };

    frame.addEventListener('load', () => {
      const cw = frame.contentWindow as (Window & { customElements: CustomElementRegistry }) | null;
      const waitForRikiki = (): void => {
        if (cw && cw.customElements && cw.customElements.get('deck-root')) {
          ready = true;
          if (pending !== null) { swap(pending); pending = null; }
        } else {
          setTimeout(waitForRikiki, 40);
        }
      };
      waitForRikiki();
    });

    const update = (): void => {
      if (ready) swap(ta.value);
      else pending = ta.value;
      flash('reload · slide edited');
    };

    let debounce: ReturnType<typeof setTimeout> | undefined;
    ta.addEventListener('input', () => {
      paint();
      if (debounce) clearTimeout(debounce);
      debounce = setTimeout(update, 300);
    });
    ta.addEventListener('scroll', () => {
      hl.scrollTop = ta.scrollTop;
      hl.scrollLeft = ta.scrollLeft;
    });

    // Navigate the preview deck · forward arrow keys into the iframe window
    // (same-origin) where deck-root's keyboard handler picks them up.
    root.querySelectorAll<HTMLButtonElement>('.lr-nav button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cw = frame.contentWindow;
        if (cw && btn.dataset.k) {
          cw.dispatchEvent(new KeyboardEvent('keydown', { key: btn.dataset.k, bubbles: true }));
        }
      });
    });

    paint();
    fit();
    new ResizeObserver(fit).observe(screen);
    // Initial document load · sets up rikiki once; every later edit swaps in place.
    frame.srcdoc = buildDoc(ta.value);
  }
</script>

<style>
  .livereload {
    background: var(--rik-surface-page);
    padding: var(--rik-space-7) var(--rik-space-5);
  }
  @media (max-width: 640px) {
    .livereload { padding: var(--rik-space-6) var(--rik-space-3); }
  }
  .inner { max-width: 1080px; margin: 0 auto; }

  .head { max-width: 70ch; margin-bottom: var(--rik-space-6); }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--rik-accent);
    color: var(--rik-accent__on);
    padding: 4px 14px 4px 4px;
    border-radius: var(--rik-radius-pill);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 var(--rik-space-3);
  }
  .eyebrow .num {
    background: var(--rik-accent__on);
    color: var(--rik-accent--strong);
    padding: 4px 7px;
    border-radius: var(--rik-radius-pill);
  }
  h2 {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-mega);
    font-weight: 800;
    color: var(--rik-text-default);
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin: 0 0 var(--rik-space-3);
    max-width: 22ch;
    padding-bottom: var(--rik-space-2);
    border-bottom: 4px solid var(--rik-accent);
    display: inline-block;
  }
  .lede {
    font-size: var(--rik-font-size-lead);
    color: var(--rik-text-default--muted);
    line-height: 1.55;
    margin: var(--rik-space-3) 0 0;
  }

  .lr-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--rik-space-4);
    align-items: stretch;
  }
  @media (max-width: 760px) { .lr-grid { grid-template-columns: 1fr; } }

  .pane { margin: 0; display: flex; flex-direction: column; gap: var(--rik-space-2); }
  .pane figcaption {
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rik-text-default--faint);
  }

  /* ── Syntax-highlighted editable source · a transparent <textarea> sits
     exactly over a colored <pre> mirror. Both share identical metrics so the
     caret lines up with the painted text. ── */
  .lr-editor {
    position: relative;
    flex: 1;
    min-height: 340px;
    border: 1px solid var(--rik-border-inverse);
    border-radius: var(--rik-radius-md);
    background: var(--rik-surface-inverse);
    box-shadow: var(--rik-elevation-2);
    overflow: hidden;
  }
  .lr-editor:focus-within {
    border-color: var(--rik-accent);
    box-shadow: 0 0 0 3px rgba(240, 112, 32, 0.28);
  }
  .lr-hl, .lr-src {
    margin: 0;
    position: absolute;
    inset: 0;
    padding: 16px 18px;
    font: 500 13px/1.65 var(--rik-font-mono);
    letter-spacing: 0;
    white-space: pre-wrap;
    word-break: break-word;
    overflow: auto;
    tab-size: 2;
    border: 0;
  }
  .lr-hl {
    pointer-events: none;
    color: var(--rik-text-inverse--muted);
    z-index: 1;
  }
  .lr-src {
    z-index: 2;
    background: transparent;
    color: transparent;
    caret-color: var(--rik-accent);
    resize: none;
    outline: none;
  }
  .lr-src::selection { background: rgba(240, 112, 32, 0.35); }
  /* highlight token colors (on the dark editor surface) */
  .lr-hl :global(.t-tag)  { color: #f6995c; }
  .lr-hl :global(.t-attr) { color: #8fd0ff; }
  .lr-hl :global(.t-str)  { color: #c3e88d; }
  .lr-hl :global(.t-cmt)  { color: rgba(232, 228, 240, 0.4); font-style: italic; }

  /* ── Live preview · fixed canvas scaled to the pane (transform set in JS) ── */
  .lr-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--rik-radius-md);
    border: 1px solid var(--rik-border-default);
    background: var(--rik-surface-inverse);
    box-shadow: var(--rik-elevation-2);
    overflow: hidden;
  }
  .lr-frame {
    position: absolute; top: 0; left: 0;
    width: 1280px; height: 800px;
    border: 0;
    transform-origin: top left;
    background: var(--rik-surface-page);
  }
  /* real runtime toast · #0a0a0a bg, #F7CB44 text + border, mono, uppercase,
     pinned bottom-left like position:fixed at runtime. */
  .lr-toast {
    position: absolute; bottom: 12px; left: 12px;
    padding: 6px 12px;
    background: #0a0a0a;
    color: #F7CB44;
    border: 1px solid #F7CB44;
    border-radius: 6px;
    font: 600 11px/1.4 monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.62;
    transition: opacity 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .lr-toast.pulse {
    opacity: 1;
    transform: translateY(-2px);
    box-shadow: 0 0 0 3px rgba(247, 203, 68, 0.2);
  }

  /* Preview navigation · sits over the slide, outside the scaled iframe. */
  .lr-nav {
    position: absolute; bottom: 12px; right: 12px;
    display: flex; gap: 6px;
  }
  .lr-nav button {
    width: 34px; height: 34px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 8px;
    background: rgba(10, 10, 10, 0.6);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    font: 700 18px/1 var(--rik-font-mono);
    cursor: pointer;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
  }
  .lr-nav button:hover {
    background: var(--rik-accent);
    border-color: var(--rik-accent);
  }
  .lr-nav button:active { transform: translateY(1px); }

  .note {
    margin: var(--rik-space-4) 0 0;
    font-size: var(--rik-font-size-body);
    color: var(--rik-text-default--faint);
    line-height: 1.65;
  }
  .note code {
    font-family: var(--rik-font-mono);
    font-size: 0.9em;
    background: var(--rik-surface-tint);
    color: var(--rik-text-default);
    padding: 1px 5px;
    border-radius: 3px;
  }
</style>
