---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import CodeBlock from '../CodeBlock.astro';
import LucideIcon from './LucideIcon.astro';
import Section from '../Section.astro';
import AgentLoop from '../AgentLoop.astro';
import checkRun from '../../data/landing-check.json';
import ThemeSwap from '../ThemeSwap.astro';
import LayoutPreview from '../LayoutPreview.astro';
import PluginShelf from '../PluginShelf.astro';
import Faq from '../Faq.astro';
import pkg from '../../../../rikiki/package.json';
const source = readFileSync(new URL('../../../../examples/stories/incident.html', import.meta.url), 'utf8');
const snippet = (source.match(/<deck-cover[\s\S]*?<\/deck-cover>/)?.[0] ?? '')
  .replace(/(<deck-cover)\s+([^>]+)>/, (_, tag, attributes) => tag + '\n  ' + attributes.replace(/\s+(?=[\w-]+=)/g, '\n  ') + '\n>');
const stories = [
 { id: 'quidditch', category: 'Equipment selection', title: 'The right broom. For your game.', text: 'A Quidditch captain compares candidates, designs the trial and decides when to buy.' },
 { id: 'acme', category: 'Technical design review', title: 'This time. For sure.', text: 'ACME takes a capture plan through its missing dependency, failure modes and an actual abort condition.' },
 { id: 'three-pigs', category: 'Works proposal', title: 'Built for the big bad.', text: 'Three siblings turn separate houses into a shared refuge, from the weakest boundary to the final inspection.' },
];
const thumbnailVersions = Object.fromEntries(stories.map(story => [story.id, createHash('sha256').update(readFileSync(new URL('../../../public/stories/thumbs/' + story.id + '.png', import.meta.url))).digest('hex').slice(0, 10)]));
const filmVersion = createHash('sha256').update(readFileSync(new URL('../../../public/landing/rikiki-demo.mp4', import.meta.url))).digest('hex').slice(0, 10);
---
<div class="landing">
  <header class="nav wrap">
    <a class="wordmark" href="/" aria-label="Rikiki home"><img src="/favicon.svg" width="42" height="42" alt="" />rikiki</a>
    <nav aria-label="Main navigation"><a href="#agents">For agents</a><a href="#examples">Examples</a><a href="#workflow">How it works</a><a href="/docs/getting-started">Docs ↗</a></nav>
    <a class="nav-cta" href="/docs/getting-started">Start building <span>↗</span></a>
  </header>
  <main>
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="engraving" aria-hidden="true"></div><div class="hero-copy">
        <p class="eyebrow"><span class="dot"></span> A tiny toolkit for wildly good decks</p>
        <h1 id="hero-title">Small toolkit.<br/><em>Wild ideas.</em></h1>
        <p class="intro">Your agent can write slides. It also needs to see where they break. Rikiki gives it HTML components, browser checks and screenshots to work from.</p>
        <div class="actions"><a class="primary" href="#agents">See the agent workflow <span>↓</span></a><a class="text-link" href="/docs/getting-started">Create your own ↗</a></div>
        <p class="hero-note">Open source · Runs in your browser</p>
      </div>
      <div class="demo" id="demo">
        <div class="demo-label"><span><i></i> A real Rikiki deck</span><a href="/stories/rikiki.html" target="_blank" rel="noopener">Open the full tour ↗</a></div>
        <div class="deck-mat"><div class="screen"><iframe id="live-deck" src="/stories/rikiki.html" title="Rikiki interactive tour: ten slides explaining the toolkit" loading="eager"></iframe></div></div>
        <div class="tour-controls" aria-label="Interactive tour navigation"><button type="button" data-tour-prev aria-label="Previous slide or step">←</button><span>Explore the toolkit · 10 slides</span><button type="button" data-tour-next aria-label="Next slide or step">Next →</button></div>
        <p class="demo-caption"><span>A working tour, built with the components it explains.</span><a href="/docs/getting-started#agent">Get the authoring skills ↗</a></p>
      </div>
    </section>
    <section class="film-section wrap" id="film" aria-labelledby="film-title">
      <div class="section-head"><div><p class="eyebrow">Watch the workflow</p><h2 id="film-title">Watch a draft<br/>get a second look.</h2></div><p>See Rikiki in action.<br/>73 seconds · With music.</p></div>
      <video controls playsinline preload="none" poster="/landing/rikiki-demo-poster.webp" width="1920" height="1080" aria-label="Rikiki: from an agent's draft to a checked presentation" aria-describedby="film-description">
        <source src={`/landing/rikiki-demo.mp4?v=${filmVersion}`} type="video/mp4" />
        <p><a href="/landing/rikiki-demo.mp4">Download the Rikiki demonstration.</a></p>
      </video>
      <p id="film-description" class="film-description">An agent writes the HTML. Rikiki checks the deck, reports defects and renders screenshots for review. Fix the draft, inspect it and take the presentation into the room. The film uses on-screen text and music.</p>
      <p class="film-description"><strong>Rikiki Sales · Coming soon.</strong></p>
    </section>
    <section class="agent-garden" id="agents" aria-labelledby="agent-title"><div class="wrap">
      <div class="section-head"><div><p class="eyebrow">Built for the agent workflow</p><h2 id="agent-title">Would you present<br/>the first draft?</h2></div><p>Give the agent a brief and the tools to inspect its work.<br/>You keep the final review (and the microphone).</p></div>
      <div class="brief-workbench"><article class="brief-card"><span class="seed-label">Start here / Your brief</span><blockquote>“Explain our incident to the engineering team. Ten minutes. Show the timeline, the root cause and what we changed. Use the attached report. Don't invent the numbers.”</blockquote><p>Tell it who is in the room, what they need to decide and which sources to use. Leave the missing numbers blank.</p></article><article class="agent-instructions"><p class="eyebrow">A workflow your agent can follow</p><h3>Give it the instructions.</h3><p>The authoring skills tell your agent which components exist, how to compose them and how to check the result. Install them alongside the toolkit.</p><CodeBlock code={`npm i rikiki-deck
npx rikiki skills`} lang="sh" label="Set up agent authoring" /><a class="text-link" href="/docs/getting-started#agent">Set up your agent ↗</a></article></div>
      <div class="check-proof" aria-label="Recorded deck check example">
        <div class="check-proof-head"><div><p class="eyebrow">From a broken draft to a reviewed slide</p><h3>Catch the defects. Then improve the slide.</h3></div><div class="check-toggle" aria-label="Compare before and after"><button data-check="flawed" aria-pressed="true">Before</button><button data-check="fixed" aria-pressed="false">After the fixes</button></div></div>
        <div class="check-comparison"><div class="check-shot"><img id="check-shot" src="/landing/flawed-slide.png" width="1920" height="1080" loading="lazy" alt="Example slide before fixes: clipped content and small text" /></div><div class="check-terminal"><div class="terminal-heading"><span>● ● ●</span><span>rikiki check --json</span></div>{(['flawed','fixed'] as const).map(state=><div data-check-result={state} hidden={state==='fixed'}><p class="check-summary">{checkRun[state].summary.error} errors · {checkRun[state].summary.warning} warnings</p><ul>{(checkRun[state].diagnostics ?? []).map(d=><li><code>{d.code}</code><span>{d.severity}</span></li>)}</ul>{state==='fixed' && <p class="check-clean">No diagnostics in this run.<br/>Ready for a human visual review.</p>}</div>)}</div></div>
        <p class="check-footnote">A deliberately flawed draft, followed by a content and visual revision. Results are captured CLI runs, not a live browser check.</p>
      </div>
      <AgentLoop />
      <div class="agent-promises"><article><span>01 / Write</span><h3>Source you can inspect.</h3><p>The agent writes readable HTML with real components. Change the text, review a diff, keep it in Git.</p></article><article><span>02 / Check & revise</span><h3>Let it inspect its work.</h3><p>Run <code>rikiki check --json</code>, fix the diagnostics, then render screenshots to catch what the checks cannot judge.</p></article><article><span>03 / Review & share</span><h3>You still do the review.</h3><p>Review the narrative, evidence and visual result. Then deliver a standalone HTML deck or export a PDF.</p></article></div>
    </div></section>
    <div class="proof wrap"><p>From the source file to the speaker notes.</p><span>Readable HTML</span><span>Presenter notes</span><span>Offline HTML & PDF</span></div>
    <section class="examples wrap" id="examples" aria-labelledby="examples-title">
      <div class="section-head"><div><p class="eyebrow">Different species. Same toolkit.</p><h2 id="examples-title">Three briefs<br/>from unlikely clients.</h2></div><p>Fifteen slides each, built from native components.<br/>ACME has requested another design review.</p></div>
      <div class="story-grid">{stories.map(story => <a class={`story story-${story.id}`} href={`/stories/${story.id}.html`} target="_blank" rel="noopener"><div class="story-image"><img src={`/stories/thumbs/${story.id}.png?v=${thumbnailVersions[story.id]}`} width="960" height="540" loading="lazy" alt={`${story.category} example cover`} /><span class="open-story" aria-hidden="true">↗</span></div><p class="eyebrow">{story.category}</p><h3>{story.title}</h3><p>{story.text}</p><span class="story-link">Explore 15 slides →</span></a>)}</div>
      <p class="fineprint">Three fictional briefs. Full stories, speaker notes and distinct visual systems. <a href="/embed/">Explore the full component tour ↗</a></p>
    </section>
    <section class="capabilities wrap" aria-labelledby="capabilities-title">
      <div class="section-head"><div><p class="eyebrow">Start with the content</p><h2 id="capabilities-title">Pick the component<br/>the idea needs.</h2></div><a class="text-link" href="/docs/components">Explore the component library ↗</a></div>
      <div class="layout-showcase">
        {[{type:'hero',title:'Explain the technical detail.',text:'Code, diagrams and a clear place for the main idea.'},{type:'bento',title:'Give the evidence room.',text:'Compose cards, comparisons and metrics into a readable whole.'},{type:'hook',title:'Leave one thought behind.',text:'Covers, section breaks and takeaways give the story its rhythm.'}].map(item => <a href="/docs/components"><LayoutPreview type={item.type as 'hero' | 'bento' | 'hook'} /><h3>{item.title}</h3><p>{item.text}</p></a>)}
      </div>
      <div class="capability-links"><a href="/docs/navigation"><strong>Navigate the deck.</strong><span>Slide steps, keyboard navigation and an overview of the whole deck. ↗</span></a><a href="/docs/plugins#presenter"><strong>See what comes next.</strong><span>Current and next slides, speaker notes and a timer in presenter mode. ↗</span></a><a href="/docs/cli"><strong>Send the finished deck.</strong><span>Layout checks, screenshot review, standalone HTML and PDF export. ↗</span></a></div>
    </section>
    <Section id="themes" eyebrow="Make it yours" title="Change the theme. Keep the deck." tone="tint"><ThemeSwap /></Section>
    <section class="source-section" aria-labelledby="source-title"><div class="wrap source-grid"><div class="source-copy"><p class="eyebrow">Yours, all the way down</p><h2 id="source-title">The slide<br/>is the source.</h2><p>Choose a layout. Add your content. Style it with CSS. This is the source of the incident-review cover. Yes, the whole cover.</p><p>Keep it in Git, review a diff, or let your coding agent make the first draft.</p><a class="text-link" href="/docs/components">Meet the components ↗</a></div><div class="source-code"><div class="file-label"><span>incident.html</span><span>HTML + web components</span></div><CodeBlock code={snippet} lang="html" wrap /><p>No slide editor required. No build step to view your deck.</p></div></div></section>
    <section class="workflow wrap" id="workflow" aria-labelledby="workflow-title"><div class="section-head"><div><p class="eyebrow">From a file to a room</p><h2 id="workflow-title">Start with a file.</h2></div><a class="text-link" href="/docs/getting-started">Follow the setup guide ↗</a></div><div class="workflow-grid"><article><div class="workflow-mark"><LucideIcon name="file-code" size={32}/><span>Write</span></div><h3>Make the first draft.</h3><p>Start from an editable file. Write it yourself, or let your agent work from the brief.</p><code>npx rikiki init talk.html</code></article><article><div class="workflow-mark"><LucideIcon name="scan-eye" size={32}/><span>Review</span></div><h3>Give the draft feedback.</h3><p>Fix the reported defects. Inspect the screenshots. Check the claims against your sources.</p><code>npx rikiki check talk.html</code></article><article><div class="workflow-mark"><LucideIcon name="package-check" size={32}/><span>Deliver</span></div><h3>Send the presentation.</h3><p>Present with notes, send an offline HTML file, or hand over a PDF. Keep the editable source.</p><code>npx rikiki bundle talk.html</code></article></div><p class="setup-note">The setup guide covers the extra dependencies (the browser and bundler need installing too).</p><aside class="agent"><span class="agent-icon" aria-hidden="true">&lt;/&gt;</span><div><strong>Working with a coding agent?</strong><p>Run <code>npx rikiki skills</code> to give it the authoring workflow and component reference.</p></div><a href="/docs/getting-started#agent">Read the agent guide ↗</a></aside></section>
    <PluginShelf />
    <Faq />
    <section class="start wrap"><div><p class="eyebrow">Room for one more wild idea</p><h2>Got a strange idea?</h2><p>Good. Give it a few slides.</p><a class="primary" href="/docs/getting-started">Build your first deck <span>↗</span></a></div><div class="install"><p>Install the toolkit</p><CodeBlock code="npm i rikiki-deck" lang="sh" label="Install Rikiki" /><a href="/docs/changelog">Current release v{pkg.version} ↗</a></div></section>
  </main>
  <footer class="wrap"><a class="wordmark" href="/"><img src="/favicon.svg" width="42" height="42" alt="" />rikiki</a><p>Made at <a href="https://tordu-jardin.fr">Tordu Jardin ↗</a>.</p><div><a href="/docs/getting-started">Documentation</a><a href="https://gitlab.com/tordu-jardin/rikiki">Source ↗</a><a href="/docs/changelog">Changelog</a></div></footer>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-check]').forEach(button => button.addEventListener('click', () => {
    const fixed = button.dataset.check === 'fixed';
    document.querySelectorAll<HTMLButtonElement>('[data-check]').forEach(b => b.setAttribute('aria-pressed', String(b === button)));
    document.querySelectorAll<HTMLElement>('[data-check-result]').forEach(panel => { panel.hidden = panel.dataset.checkResult !== button.dataset.check; });
    const shot = document.querySelector<HTMLImageElement>('#check-shot')!;
    shot.src = '/landing/' + (fixed ? 'fixed' : 'flawed') + '-slide.png';
    shot.alt = fixed ? 'Example slide after the recorded fixes' : 'Example slide before fixes: clipped content and small text';
  }));
</script>
<style>
.landing{--ink:#252620;--muted:#6b6b62;--line:#deded4;--orange:#c44920;color:var(--ink);background:#f7f7f0;font-family:Inter,Arial,sans-serif} .wrap{width:min(1320px,calc(100% - 96px));margin-inline:auto}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}a,button{touch-action:manipulation}a:focus-visible,button:focus-visible{outline:3px solid #c44920;outline-offset:5px}.nav{height:96px;display:flex;align-items:center;gap:48px;border-bottom:1px solid var(--line)}.wordmark{font-size:36px;font-weight:850;letter-spacing:-2px}.wordmark span{font-size:14px;vertical-align:top;letter-spacing:0;margin-left:3px}.nav nav{display:flex;gap:30px;margin-left:auto;font-size:14px;font-weight:550}.nav-cta{background:var(--ink);color:#fff;padding:13px 19px;border-radius:6px;font-size:14px}.nav-cta span{margin-left:20px}.hero{display:grid;grid-template-columns:.85fr 1.35fr;gap:58px;align-items:center;padding-block:86px 64px}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:14px;font-weight:700;line-height:1.5;margin:0 0 22px}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--orange);margin-right:8px}h1{font-size:clamp(44px,4.3vw,66px);font-weight:650;letter-spacing:-.065em;line-height:1.06;margin:0 0 26px}h1 em{font-style:normal;color:var(--orange)}.intro{font-size:17px;line-height:1.7;max-width:37ch;color:var(--muted);margin:0 0 30px}.actions{display:flex;gap:24px;align-items:center}.primary{display:inline-flex;align-items:center;gap:24px;background:var(--orange);color:white;border:0;border-radius:5px;padding:16px 20px;font-size:14px;font-weight:650;min-height:48px}.primary:hover{background:#a33a19}.text-link{font-size:14px;font-weight:650;line-height:1.5}.text-link:hover{text-decoration:underline}.hero-note{font-size:14px;color:var(--muted);margin:18px 0 0}.demo{min-width:0;transform:rotate(-1deg)}.demo-label{display:flex;justify-content:space-between;align-items:center;font-size:14px;padding:0 2px 13px;color:var(--muted)}.demo-label i{display:inline-block;width:6px;height:6px;background:#488369;border-radius:50%;margin-right:6px}.screen{aspect-ratio:16/9;background:#080b13;border-radius:8px 8px 0 0;overflow:hidden;box-shadow:0 20px 45px #28292016}iframe{display:block;width:100%;height:100%;border:0}.demo-controls{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid var(--line);border-top:0;padding:10px;border-radius:0 0 8px 8px;gap:8px}.steps{display:flex;gap:4px}.steps button{border:0;background:transparent;padding:11px 10px;border-radius:4px;color:var(--muted);font-size:14px}.steps button[aria-pressed=true]{background:#f2ede4;color:var(--ink)}.steps span{margin-left:5px}.arrows{display:flex;gap:4px}.arrows button{height:36px;width:36px;border:1px solid var(--line);border-radius:4px;background:white}.arrows button:disabled{opacity:.3;cursor:default}.demo-caption{display:flex;justify-content:space-between;font-size:14px;color:var(--muted);margin:12px 2px}.proof{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-block:22px;border-block:1px solid var(--line);font-size:14px}.proof p{color:var(--muted);margin:0}.proof span::before{content:'↗';color:var(--orange);margin-right:12px}.examples{padding-block:84px 72px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:34px}.section-head .eyebrow{margin-bottom:12px}h2{font-size:clamp(30px,3vw,44px);line-height:1.12;letter-spacing:-.045em;font-weight:600;margin:0}.section-head>p{font-size:14px;line-height:1.6;color:var(--muted);margin:0}.story-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.story-image{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:6px;background:#e6e4de;margin-bottom:24px}.story-image img{width:100%;height:100%;object-fit:cover;transition:transform .2s}.story:hover img{transform:scale(1.025)}.open-story{position:absolute;right:12px;bottom:12px;background:#ffffffde;border-radius:50%;width:30px;height:30px;display:grid;place-items:center;color:#252620}.story .eyebrow{font-size:14px;color:var(--muted);margin-bottom:9px}h3{font-size:20px;letter-spacing:-.03em;font-weight:650;margin:0 0 10px}.story>p:not(.eyebrow){font-size:14px;line-height:1.65;color:var(--muted);max-width:34ch;margin:0 0 14px}.story-link{font-size:14px;font-weight:650}.fineprint{font-size:14px;color:var(--muted);margin:30px 0 0;display:flex;justify-content:space-between;gap:16px}.fineprint a{text-decoration:underline}.source-section{background:#ebece3;padding-block:72px}.source-grid{display:grid;grid-template-columns:1fr 1.3fr;gap:100px;align-items:center}.source-copy h2{font-size:48px;margin-bottom:24px}.source-copy>p:not(.eyebrow){font-size:14px;line-height:1.75;color:var(--muted);max-width:38ch}.source-copy .text-link{display:inline-block;margin-top:12px}.source-code{min-width:0}.file-label{background:#1b202b;color:#babdc6;padding:15px 20px;display:flex;justify-content:space-between;font:14px monospace;border-radius:7px 7px 0 0}.source-code :global(.code){margin:0}.source-code :global(pre){border-radius:0 0 7px 7px;box-shadow:none}.source-code :global(.block){min-width:0}.source-code>p{font-size:14px;color:var(--muted);margin-top:15px}.workflow{padding-block:82px}.workflow-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px}.workflow-grid article{border-top:1px solid var(--line);padding-top:22px}.number{font-size:14px;color:var(--orange);display:block;margin-bottom:22px}.workflow-grid p{font-size:14px;color:var(--muted);line-height:1.65;min-height:44px;max-width:31ch;margin:0 0 20px}.workflow-grid code{font-size:14px;background:#eeeee5;padding:10px 12px;display:inline-block;max-width:100%;overflow-wrap:anywhere}.setup-note{font-size:14px;color:var(--muted);margin:25px 0 32px}.agent{border:1px solid var(--line);border-radius:6px;display:flex;align-items:center;gap:22px;padding:22px 26px}.agent-icon{font:20px monospace;color:var(--orange)}.agent strong{font-size:14px}.agent p{font-size:14px;color:var(--muted);margin:6px 0 0;line-height:1.6}.agent a{margin-left:auto;font-size:14px;white-space:nowrap}.agent code{font-size:14px}.start{background:#252b24;color:#f7f7f0;display:grid;grid-template-columns:1.3fr 1fr;gap:60px;padding:52px 56px;border-radius:8px}.start .eyebrow{color:#bbc5b5;margin-bottom:16px}.start h2{font-size:36px}.start p:not(.eyebrow){font-size:14px;color:#b9c3b4;margin:16px 0 24px}.start .primary{background:#e0eab5;color:#253120}.install{align-self:center;min-width:0}.install>p{font-size:14px!important;margin:0 0 12px!important}.install a{display:inline-block;color:#c9d4be;font-size:14px;margin-top:14px}.install :global(.code-block){margin:0}footer{display:flex;align-items:center;gap:24px;padding-block:40px}footer .wordmark{font-size:26px}footer>p{font-size:14px;color:var(--muted)}footer>div{margin-left:auto;display:flex;gap:25px;font-size:14px}
@media(min-width:1600px){.hero{padding-block:100px 80px}}@media(max-width:1100px){.wrap{width:calc(100% - 56px)}.hero{gap:30px;grid-template-columns:1fr 1.2fr}h1{font-size:45px}.actions{gap:14px;flex-wrap:wrap}.steps span{display:none}.source-grid{gap:40px}.start{padding:40px}.workflow-grid{gap:20px}}
@media(max-width:720px){.wrap{width:calc(100% - 40px)}.nav{height:76px;gap:20px}.wordmark{font-size:30px}.nav nav{display:none}.nav-cta{margin-left:auto;font-size:14px;padding:12px 14px}.hero{grid-template-columns:1fr;padding-block:44px 30px;gap:38px}h1{font-size:52px;max-width:10ch;letter-spacing:-.065em}.hero .eyebrow{font-size:14px;margin-bottom:20px}.intro{font-size:15px;max-width:34ch}.hero-note{font-size:14px}.demo{transform:none}.steps button{padding:10px 6px;font-size:14px}.steps span{display:inline;margin-left:3px}.arrows button{width:30px;height:34px}.demo-controls{padding:6px}.proof{flex-wrap:wrap;justify-content:flex-start;gap:16px 22px;font-size:14px;padding-block:18px}.proof p{width:100%}.proof span::before{margin-right:5px}.examples{padding-block:50px}.section-head{display:block;margin-bottom:25px}.section-head>p{margin-top:16px}.section-head>.text-link{display:inline-block;margin-top:20px}.story-grid{grid-template-columns:1fr;gap:32px}.story-image{margin-bottom:18px}.story>p:not(.eyebrow){max-width:100%}.fineprint{flex-direction:column;line-height:1.6}.source-section{padding-block:44px}.source-grid{grid-template-columns:1fr;gap:25px}.source-copy h2{font-size:40px}.source-copy h2 br{display:none}.source-copy>p:not(.eyebrow){max-width:100%}.file-label{font-size:14px;padding:13px}.source-code :global(pre){font-size:14px!important;padding:16px!important}.workflow{padding-block:48px}.workflow-grid{grid-template-columns:1fr;gap:28px}.number{margin-bottom:14px}.workflow-grid p{min-height:0;max-width:100%;margin-bottom:14px}.agent{padding:20px;gap:14px;flex-wrap:wrap}.agent-icon{display:none}.agent a{margin:0}.setup-note{line-height:1.6}.start{grid-template-columns:1fr;padding:28px;gap:32px}.start h2{font-size:34px}.install :global(pre){font-size:14px}footer{flex-wrap:wrap;gap:16px;padding-block:30px}footer>p{margin:0}footer>div{width:100%;margin:0;gap:20px}.eyebrow{font-size:14px}h2{font-size:32px}}
@media(prefers-reduced-motion:reduce){.story-image img{transition:none}}

/* Keep the original Rikiki identity across the new composition. */
