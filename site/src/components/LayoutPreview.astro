---
// Pixel-accurate layout previews. Each card embeds a tiny iframe that
// renders the *real* <deck-*> Web Components, scaled down to fit the card.
// Heavy in iframes, but lazy-loaded so they only fetch when scrolled into
// view · the home page itself ships no JS for this.
interface Props {
  type: 'cover' | 'hero' | 'split' | 'bento' | 'data' | 'hook';
}
const type = Astro.props.type as Props['type'];

// One self-contained HTML per layout. The iframe scales the 1920×1080 deck
// to the card width (about 0.27 at the page measure).
// Fixtures keep a few large elements per slide: the preview shows the
// composition, not a dense slide, and body-sized text would not read at
// the card scale (see the type floor in the srcdoc styles below).
// Every cell that claims a span writes BOTH grid lines explicitly. A bare
// integer is read as `span N` (see shared/grid-tracks.ts), so `col="3"` on a
// three-column bento claims the whole width and paints an empty band over its
// neighbours · the composition the tile exists to show is then unreadable.
const decks: Record<Props['type'], string> = {
  cover: `
    <deck-cover>
      <h1>Hello, <span class="accent">world</span>.</h1>
      <p class="sub">Sub-title or opening question.</p>
    </deck-cover>`,

  hero: `
    <deck-feature>
      <h1 slot="title">Side effects</h1>
      <p slot="lead" class="lead">A module can act on import.</p>
      <deck-code lang="ts" hero>import './polyfill';
const greet = (n) => \`Hi \${n}\`;</deck-code>
    </deck-feature>`,

  split: `
    <deck-split cols="1-1">
      <h1 slot="title">Two takes</h1>
      <deck-card slot="left"><h3>Before, a bundler step</h3><p>A build step before the slide.</p></deck-card>
      <deck-card slot="right" color="green"><h3>After, plain HTML</h3><p>Open the file and present.</p></deck-card>
    </deck-split>`,

  bento: `
    <deck-bento cols="3" rows="2" gap="3">
      <h1 slot="title">One canvas. Unequal ideas.</h1>
      <deck-point col="1 / 3" row="1 / 2" tone="ok"><h3>Main signal</h3><p>Give the strongest idea room.</p></deck-point>
      <deck-point col="3 / 4" row="1 / 3"><h3>Context</h3><p>Keep the detail nearby.</p></deck-point>
      <deck-point col="1 / 2" row="2 / 3"><h3>Proof</h3><p>One number, sourced.</p></deck-point>
      <deck-point col="2 / 3" row="2 / 3"><h3>Action</h3><p>What to do next.</p></deck-point>
    </deck-bento>`,

  data: `
    <deck-feature>
      <h1 slot="title">Make the result legible</h1>
      <deck-kpi-grid cols="3" ruled>
        <deck-kpi value="20" label="slides"></deck-kpi>
        <deck-kpi value="0" label="errors" tone="ok"></deck-kpi>
        <deck-kpi value="19 min" label="duration"></deck-kpi>
      </deck-kpi-grid>
    </deck-feature>`,

  hook: `
    <deck-takeaway>
      <deck-punch size="display">Source = output.</deck-punch>
      <p class="caption on-dark">A deck is a folder.</p>
    </deck-takeaway>`,
};

const labels: Record<Props['type'], string> = {
  cover: 'deck-cover preview',
  hero: 'deck-feature preview',
  split: 'deck-split preview',
  bento: 'deck-bento preview',
  data: 'deck-kpi-grid preview',
  hook: 'deck-takeaway preview',
};

const srcdoc = `<!doctype html><html><head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="/rikiki/themes/rikiki.css">
  <script type="module" src="/rikiki/dist/index.js"></script>
  ${type === 'data' ? '<script type="module" src="/rikiki/dist/deck-kpi-grid.js"><\/script>' : ''}
  <style>
    html, body { width: 100%; height: 100%; overflow: hidden; }
    body { display: flex; }
    deck-root { flex: 1; }
    /* Preview type floor. The card renders the slide at about 0.27, where
       every size below --rik-text-lg falls under 11 px. The small end of the
       scale is clamped to that step; headings keep their own sizes. */
    deck-root {
      --rik-font-size-xs: var(--rik-text-lg);
      --rik-font-size-sm: var(--rik-text-lg);
      --rik-font-size-body: var(--rik-text-lg);
      --rik-font-size-lead: var(--rik-text-lg);
      --rik-font-size-h2: var(--rik-text-lg);
      --rik-font-size-strong: var(--rik-text-lg);
      --rik-font-size-mono: var(--rik-text-lg);
      --rik-font-size-mono-sm: var(--rik-text-lg);
      --rik-extras-reading: var(--rik-text-lg);
    }
  </style>
</head><body>
  <deck-root preview no-hint no-counter no-arrows>${decks[type]}</deck-root>
</body></html>`;
---

<div class="layout-preview" data-type={type}>
  <iframe
    data-preview-srcdoc={srcdoc}
    title={labels[type]}
    loading="lazy"
    aria-hidden="true"
    tabindex="-1"
  ></iframe>
</div>

<style>
  .layout-preview {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--rik-surface-sunken);
    border: 1px solid var(--rik-border-default);
    margin-bottom: var(--rik-space-3);
  }
  /* Scaled-down 1920×1080 deck, 480×270 area · 25% scale */
  iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1920px;
    height: 1080px;
    transform: scale(0.25);
    transform-origin: top left;
    border: 0;
    pointer-events: none;
  }
</style>

<script>
  import '../scripts/previews';
</script>
