---
import { resolve } from 'node:path';
import { pathToFileURL } from 'node:url';

// Counts come from the source and the catalogue, never from a typed number ·
// scripts/component.test.mjs guards the same figures on the pages themselves.
// Loaded through a runtime file URL so Vite leaves the module out of the
// prerender bundle: it locates the repository from its own import.meta.url.
const surfaces = pathToFileURL(
  resolve(process.cwd(), '../rikiki/scripts/component-surfaces.mjs'),
).href;
const { catalogueCounts, separateElements } = await import(/* @vite-ignore */ surfaces);
const { layouts, atoms } = catalogueCounts();
const optIn = separateElements().length;

const sections = [
  {
    title: 'Getting started',
    links: [
      { href: '/docs/',                 label: 'Overview' },
      { href: '/docs/getting-started',  label: 'Install · Quickstart' },
      { href: '/docs/cheatsheet',       label: 'Cheatsheet · 5 components' },
      { href: '/docs/anatomy',          label: 'Anatomy of a slide' },
      { href: '/docs/navigation',       label: 'Navigation' },
    ],
  },
  {
    title: 'Guides',
    links: [
      { href: '/docs/cli',         label: 'Check & deliver' },
      { href: '/docs/theming',     label: 'Theming · design tokens' },
      { href: '/docs/multi-deck',  label: 'Multi-file decks' },
      { href: '/docs/recipes',     label: 'Recipes' },
    ],
  },
  {
    title: 'Reference',
    links: [
      { href: '/docs/components',          label: 'Component library' },
      { href: '/docs/components#layouts',  label: `Layouts (${layouts})` },
      { href: '/docs/components#atoms',    label: `Building blocks (${atoms})` },
      { href: '/docs/components#optional', label: `Opt-in elements (${optIn})` },
      { href: '/docs/api',                 label: 'deck-root API' },
      { href: '/docs/plugins',             label: 'Runtime modules · transitions, presenter, Shiki' },
      { href: '/docs/lit-and-shadow-dom',  label: 'Lit & Shadow DOM' },
      { href: '/rikiki/docs/llms/rikiki-reference.md', label: 'For coding agents · reference .md' },
      { href: '/docs/changelog',           label: 'Changelog' },
      { href: '/docs/contributing',        label: 'Contributing' },
    ],
  },
];

const path = Astro.url.pathname.replace(/\/$/, '');
---

<aside class="sidebar">
  <button
    type="button"
    class="sidebar-toggle"
    aria-expanded="false"
    aria-controls="sidebar-nav"
    aria-label="Toggle docs navigation"
  >
    <span class="hamburger" aria-hidden="true">≡</span>
    <span class="label">Docs nav</span>
    <span class="chevron" aria-hidden="true">▾</span>
  </button>
  <nav id="sidebar-nav">
    {sections.map((s) => (
      <section>
        <h4>{s.title}</h4>
        <ul>
          {s.links.map((l) => {
            const [linkPath, linkHash] = l.href.split('#');
            const cleanPath = linkPath!.replace(/\/$/, '');
            const isPathMatch = cleanPath === path;
            const isActive = isPathMatch && !linkHash;
            return (
              <li>
                <a
                  href={l.href}
                  class={isActive ? 'active' : ''}
                  data-path={cleanPath}
                  data-hash={linkHash ?? ''}
                >{l.label}</a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </nav>
</aside>

<script is:inline>
  // Mobile toggle. The sidebar is rendered open by default so no-JS readers
  // still get the full site nav · we collapse it client-side once we know
  // the viewport is narrow, and let the user reopen it via the button.
  (function () {
    const sidebar = document.querySelector('.sidebar');
    const toggle = sidebar && sidebar.querySelector('.sidebar-toggle');
    if (!sidebar || !toggle) return;
    const apply = () => {
      const narrow = window.matchMedia('(max-width: 920px)').matches;
      if (narrow) {
        sidebar.classList.add('is-collapsed');
        toggle.setAttribute('aria-expanded', 'false');
      } else {
        sidebar.classList.remove('is-collapsed');
        toggle.setAttribute('aria-expanded', 'true');
      }
    };
    toggle.addEventListener('click', () => {
      const open = sidebar.classList.toggle('is-collapsed');
      // After toggle, .is-collapsed = closed (true means just collapsed)
      toggle.setAttribute('aria-expanded', String(!open));
    });
    apply();
    // Re-sync on resize so a phone-rotated-to-landscape reflows sanely.
    window.addEventListener('resize', apply);
  })();
</script>

<style>
  .sidebar {
    position: sticky;
    top: 60px;
    height: calc(100vh - 60px);
    overflow-y: auto;
    padding: var(--rik-space-5) 0 var(--rik-space-5) var(--rik-space-4);
    border-right: 1px solid var(--rik-border-default);
    background: var(--rik-surface-page);
  }
  nav { display: flex; flex-direction: column; gap: var(--rik-space-4); }
  section { display: flex; flex-direction: column; gap: 6px; }
  h4 {
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rik-text-default--faint);
    padding: 0 var(--rik-space-3);
  }
  ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
  a {
    display: block;
    padding: 6px var(--rik-space-3);
    color: var(--rik-text-default--muted);
    text-decoration: none;
    font-size: var(--rik-font-size-sm);
    border-left: 2px solid transparent;
    border-radius: 0 var(--rik-radius-sm) var(--rik-radius-sm) 0;
    transition: color 0.12s, background 0.12s, border-color 0.12s;
  }
  a:hover {
    color: var(--rik-text-default);
    background: rgba(42, 37, 32, 0.04);
    text-decoration: none;
  }
  a.active {
    color: var(--rik-accent);
    border-left-color: var(--rik-accent);
    background: rgba(240, 112, 32, 0.06);
    font-weight: 700;
  }

  /* ── Mobile toggle · hidden on desktop ─────────────────────── */
  .sidebar-toggle { display: none; }
  @media (max-width: 920px) {
    /* On phones the sidebar takes the full layout column and is no longer
       sticky · letting it grow with content would push everything below
       the fold. Show the toggle, hide the nav until the user opens it. */
    .sidebar {
      position: static;
      height: auto;
      max-height: none;
      padding: var(--rik-space-3) var(--rik-space-3) 0;
      border-right: 0;
      border-bottom: 1px solid var(--rik-border-default);
    }
    .sidebar-toggle {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 10px var(--rik-space-3);
      background: var(--rik-surface-raised);
      border: 1px solid var(--rik-border-default);
      border-radius: var(--rik-radius-sm);
      color: var(--rik-text-default);
      font: 700 var(--rik-font-size-sm)/1 var(--rik-font-mono);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.12s, border-color 0.12s;
    }
    .sidebar-toggle:hover { background: var(--rik-surface-raised--strong); }
    .sidebar-toggle .hamburger {
      font-size: 1.25rem; line-height: 1; color: var(--rik-accent);
    }
    .sidebar-toggle .label { flex: 1; text-align: left; }
    .sidebar-toggle .chevron {
      font-size: 0.85rem; transition: transform 0.15s;
    }
    .sidebar.is-collapsed .sidebar-toggle .chevron { transform: rotate(-90deg); }
    .sidebar nav {
      padding: var(--rik-space-3) 0;
    }
    .sidebar.is-collapsed nav { display: none; }
  }
</style>
