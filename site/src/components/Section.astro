---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  tone?: 'paper' | 'dark';
}
const { id, eyebrow, title, tone = 'paper' } = Astro.props;
---

<section id={id} class={`section ${tone}`}>
  <div class="inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="title" set:html={title}></h2>
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding: var(--rik-space-7) var(--rik-space-5);
  }
  .section.dark {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
  }
  .inner {
    max-width: 1080px;
    margin: 0 auto;
  }
  .eyebrow {
    display: table;             /* hugs content but breaks the flow before title */
    padding: 4px 10px;
    background: var(--rik-accent);
    color: var(--rik-surface-inverse);
    border-radius: var(--rik-radius-pill);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: var(--rik-space-3);
  }
  .title {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-mega);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--rik-text-default);
    margin-bottom: var(--rik-space-5);
    padding-bottom: var(--rik-space-2);
    border-bottom: 4px solid var(--rik-accent);
    display: inline-block;
    align-self: flex-start;
  }
  .dark .title { color: var(--rik-text-inverse); }
  .body { margin-top: var(--rik-space-4); }
</style>
