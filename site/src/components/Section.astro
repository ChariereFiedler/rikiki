---
import Eyebrow from './Eyebrow.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  /** Two-digit section number rendered inside the eyebrow chip. */
  num?: string;
  title: string;
  tone?: 'paper' | 'tint' | 'dark';
}
const { id, eyebrow, num, title, tone = 'paper' } = Astro.props;
---

<section id={id} class={`section ${tone}`}>
  <div class="inner">
    {eyebrow && <Eyebrow text={eyebrow} num={num} tone={tone === 'dark' ? 'inverse' : 'paper'} />}
    <h2 class="title" set:html={title}></h2>
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section { padding: var(--rik-space-7) var(--rik-space-5); }
  @media (max-width: 640px) {
    /* Tighten the side padding on phones · 36px each side on a 375px
       viewport ate 19% of the width and left code blocks no room. */
    .section { padding: var(--rik-space-6) var(--rik-space-3); }
  }
  .section.dark {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
  }
  .section.tint {
    background: var(--rik-surface-tint--strong);
    border-block: 1px solid var(--rik-border-default);
  }
  .inner { max-width: var(--rik-measure-page); margin: 0 auto; }

  .title {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-mega);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--rik-text-default);
    margin-bottom: var(--rik-space-5);
    display: block;
    align-self: flex-start;
    max-width: 24ch;
    text-wrap: balance;
    overflow-wrap:anywhere;
  }
  .dark .title { color: var(--rik-text-inverse); }
  .body { margin-top: var(--rik-space-4); }
</style>
