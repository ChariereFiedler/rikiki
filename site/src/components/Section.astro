---
interface Props {
  id?: string;
  eyebrow?: string;
  /** Two-digit section number rendered inside the eyebrow chip. */
  num?: string;
  title: string;
  tone?: 'paper' | 'dark';
}
const { id, eyebrow, num, title, tone = 'paper' } = Astro.props;
---

<section id={id} class={`section ${tone}`}>
  <div class="inner">
    {eyebrow && (
      <p class="eyebrow">
        {num && <span class="num">{num}</span>}
        <span class="eyebrow-text">{eyebrow}</span>
      </p>
    )}
    <h2 class="title" set:html={title}></h2>
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section { padding: var(--rik-space-7) var(--rik-space-5); }
  .section.dark {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
  }
  .inner { max-width: 1080px; margin: 0 auto; }

  /* The eyebrow is a two-part pill: a white "num" chip flush-left and an
     orange section name to its right. Both share the pill rounding so the
     left curve belongs to the num chip · no double-rounded overlap. */
  .eyebrow {
    /* width: fit-content keeps the pill hugging its content while the
       flex container stays block-level · prevents the eyebrow from
       sharing its line with the following <h2 class="title">. */
    display: flex; align-items: stretch;
    width: fit-content;
    background: var(--rik-accent);
    color: var(--rik-accent__on);
    border-radius: var(--rik-radius-pill);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 var(--rik-space-3);
    overflow: hidden;
  }
  .eyebrow .num {
    display: inline-flex; align-items: center;
    background: var(--rik-accent__on);
    color: var(--rik-accent--strong);
    padding: 5px 11px;
  }
  .eyebrow .eyebrow-text {
    display: inline-flex; align-items: center;
    padding: 5px 14px;
  }
  /* eyebrow without num · single-segment pill */
  .eyebrow:not(:has(.num)) .eyebrow-text { padding: 5px 12px; }

  .title {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-mega);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--rik-text-default);
    margin-bottom: var(--rik-space-5);
    padding-bottom: var(--rik-space-2);
    border-bottom: 4px solid var(--rik-accent);
    display: inline-block;
    align-self: flex-start;
  }
  .dark .title { color: var(--rik-text-inverse); }
  .body { margin-top: var(--rik-space-4); }
</style>
