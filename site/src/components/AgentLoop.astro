---
const stages = [
  {title:'Brief', file:'Audience + evidence', detail:'You define the audience, the decision and the source material. The agent must mark missing facts instead of inventing them.'},
  {title:'Reference', file:'Skills + components', detail:'The authoring skills provide layouts, component APIs and the review workflow. The agent can inspect the same reference you use.'},
  {title:'Write', file:'Editable HTML', detail:'The agent turns the plan into HTML slides and speaker notes. You can inspect every claim and review the source in Git.'},
  {title:'Check & revise', file:'Diagnostics + images', detail:'Browser checks report defects. The agent revises the HTML, reruns the checks and renders screenshots for visual review.'},
  {title:'Review & deliver', file:'HTML / PDF', detail:'You approve the evidence, story and visual result. Then present the deck, bundle offline HTML or export a PDF.'},
];
---
<section class="agent-loop" aria-label="Explore the agent authoring workflow">
  <header><div><h3>A draft is the start of the loop.</h3><p>Explore each handoff, including the return from checks to source.</p></div><button class="play-loop" type="button">Play the loop <span aria-hidden="true">▶</span></button></header>
  <ol>{stages.map((stage,i)=><li><button class="loop-step" type="button" data-stage={i} aria-pressed={i===0} aria-controls="loop-explanation"><span class="step-index">{i+1}</span><strong>{stage.title}</strong><span class="step-file">{stage.file}</span></button></li>)}</ol>
  <svg class="flow-lines" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true"><defs><marker id="loop-arrowhead" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 1L8 5L0 9" fill="none" stroke="currentColor" stroke-width="1.5"/></marker></defs><path class="forward" d="M100 3V20H300V3M300 20H500V3M500 20H700V3M700 20H900V3"/><path class="feedback" d="M700 30C700 90 500 90 500 30" marker-end="url(#loop-arrowhead)"/><circle class="packet" r="5" cx="100" cy="20"><animateMotion class="flow-motion" dur="6s" begin="indefinite" fill="freeze" path="M0 0H200H400H600C600 65 400 65 400 10V0H800"/></circle></svg>
  <div class="feedback-caption">Revise the source, then check again</div>
  <div id="loop-explanation" class="explanation" aria-live="polite"><strong>{stages[0].title}</strong><p>{stages[0].detail}</p></div>
  <div class="stage-data" hidden>{stages.map(stage=><p data-title={stage.title}>{stage.detail}</p>)}</div>
  <a href="/rikiki/docs/llms/rikiki-workflow.md">Read the full authoring workflow ↗</a>
</section>
<script>
const root=document.querySelector<HTMLElement>('.agent-loop');
if(root){
 const buttons=[...root.querySelectorAll<HTMLButtonElement>('.loop-step')];
 const data=[...root.querySelectorAll<HTMLParagraphElement>('.stage-data p')];
 const play=root.querySelector<HTMLButtonElement>('.play-loop')!;
 const motion=root.querySelector<SVGAnimationElement>('.flow-motion');
 let timers:ReturnType<typeof setTimeout>[]=[];
 function stop(){timers.forEach(clearTimeout);timers=[];motion?.endElement();root!.classList.remove('playing');play.innerHTML='Play the loop <span aria-hidden="true">▶</span>';}
 function select(i:number){buttons.forEach((button,n)=>button.setAttribute('aria-pressed',String(n===i)));root!.querySelector('.explanation strong')!.textContent=data[i].dataset.title!;root!.querySelector('.explanation p')!.textContent=data[i].textContent;}
 buttons.forEach((button,i)=>button.addEventListener('click',()=>{stop();select(i);}));
 play.addEventListener('click',()=>{if(root.classList.contains('playing')){stop();return;}stop();select(0);if(matchMedia('(prefers-reduced-motion: reduce)').matches){select(3);return;}root.classList.add('playing');play.innerHTML='Pause the loop <span aria-hidden="true">Ⅱ</span>';motion?.beginElement();[1,2,3,2,3,4].forEach((stage,i)=>timers.push(setTimeout(()=>select(stage),(i+1)*850)));timers.push(setTimeout(stop,6100));});
 document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
}
</script>
<style>
.agent-loop{background:var(--rik-surface-inverse);color:var(--rik-text-inverse);padding:30px;border-radius:8px;margin-top:48px}header{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:28px}h3{font:750 22px/1.35 var(--rik-font-display);margin:0 0 10px}header p{font-size:14px;color:var(--rik-text-inverse--muted);margin:0;line-height:1.6}.play-loop{flex:none;border:1px solid var(--rik-border-inverse);background:transparent;color:var(--rik-text-inverse);padding:12px 16px;border-radius:4px;font:600 14px var(--rik-font-sans);cursor:pointer}.play-loop span{margin-left:12px}ol{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}li{min-width:0}.loop-step{width:100%;height:116px;padding:16px 12px;text-align:left;background:var(--rik-surface-inverse--soft-2);border:1px solid var(--rik-border-inverse);border-radius:5px;color:var(--rik-text-inverse);cursor:pointer}.loop-step[aria-pressed=true]{border-color:var(--rik-accent);background:var(--rik-surface-inverse__overlay)}.step-index{font:14px var(--rik-font-mono);color:var(--rik-accent);display:block;margin-bottom:10px}.loop-step strong{font:700 14px var(--rik-font-sans);display:block;margin-bottom:8px}.step-file{font:14px var(--rik-font-mono);color:var(--rik-text-inverse--muted)}.flow-lines{width:100%;height:94px;display:block;overflow:visible;color:var(--rik-accent)}.forward,.feedback{fill:none;stroke:var(--rik-border-inverse--strong);stroke-width:1.5;vector-effect:non-scaling-stroke}.feedback{stroke:var(--rik-accent);stroke-dasharray:4 5}.packet{display:none;fill:var(--rik-accent)}.playing .packet{display:block}.feedback-caption{text-align:center;font:14px var(--rik-font-sans);color:var(--rik-accent);margin:-4px 0 22px}.explanation{border-top:1px solid var(--rik-border-inverse);padding-top:20px;display:grid;grid-template-columns:180px 1fr;gap:24px;min-height:92px}.explanation strong{font-size:14px}.explanation p{font-size:14px;line-height:1.7;color:var(--rik-text-inverse--muted);margin:0;max-width:80ch}.agent-loop>a{display:inline-block;color:var(--rik-accent);font-size:14px;margin-top:12px;text-decoration:none}button:focus-visible,a:focus-visible{outline:2px solid var(--rik-accent);outline-offset:4px}@media(max-width:720px){.agent-loop{padding:22px 16px}header{display:block}h3{font-size:19px}.play-loop{margin-top:18px}ol{grid-template-columns:1fr;gap:8px}.loop-step{height:auto;min-height:70px;display:grid;grid-template-columns:24px 1fr;gap:5px 10px;align-items:center}.step-index{grid-row:1/3;margin:0}.loop-step strong{margin:0}.step-file{grid-column:2}.flow-lines{display:none}.feedback-caption{text-align:left;margin:18px 0;line-height:1.5}.explanation{grid-template-columns:1fr;gap:10px;min-height:145px}.explanation p{font-size:14px}}@media(prefers-reduced-motion:reduce){.packet{display:none!important}}
</style>
