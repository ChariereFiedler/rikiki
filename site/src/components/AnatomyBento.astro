---
interface Props { code: string; }
const { code } = Astro.props;
---

<div class="anatomy">
  <div class="source">
    <p class="overline">What you write</p>
    <div class="editor">
      <header><span>index.html</span><span class="editing">Editable</span></header>
      <div class="editing-surface">
        <pre class="highlight" aria-hidden="true"><code></code></pre>
        <textarea aria-label="Editable slide source" spellcheck="false">{code}</textarea>
      </div>
    </div>
    <div class="doctor" role="status" aria-live="polite">
      <header><span><i></i> Sample checks · not the CLI</span><code>interactive example</code></header>
      <div class="doctor-output"></div>
    </div>
  </div>
  <div class="result" aria-label="Annotated rendering of the source">
    <p class="overline on-dark">What Rikiki renders</p>
    <div class="slide">
      <div class="slide-copy">
        <span class="eyebrow" data-render="eyebrow">Module</span>
        <h3 data-render="title">Side effects</h3>
        <p data-render="lead">A module can act on import.</p>
      </div>
      <pre class="rendered-code"><code data-render="code"><span class="syn-keyword">import</span> <span class="syn-string">'./polyfill'</span>;</code></pre>
    </div>
    <ol class="legend">
      <li><span>Layout</span><code>&lt;deck-feature&gt;</code> sets the composition.</li>
      <li><span>Content fields</span><code>title</code> and <code>lead</code> place the copy.</li>
      <li><span>Content component</span><code>&lt;deck-code&gt;</code> renders the code.</li>
    </ol>
  </div>
</div>

<ol class="delivery" aria-label="Delivery workflow, five commands in order">
  <li><span>Start</span><code>npx rikiki init <span class="arg">index.html</span></code><strong>starter deck</strong></li>
  <li><span>Inspect</span><code>npx rikiki check <span class="arg">index.html</span></code><strong>diagnostic report</strong></li>
  <li><span>Review</span><code>npx rikiki render <span class="arg">index.html</span></code><strong>PNGs + gallery</strong></li>
  <li><span>Package</span><code>npx rikiki bundle <span class="arg">index.html</span></code><strong>standalone HTML</strong></li>
  <li><span>Deliver</span><code>npx rikiki export <span class="arg">index.html</span></code><strong>PDF</strong></li>
</ol>

<style>
  .anatomy { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--rik-space-4); align-items:stretch; }
  .source,.result { min-width:0; }
  .overline { margin:0 0 var(--rik-space-2); color:var(--rik-text-default--muted); font:600 var(--rik-font-size-sm)/1.3 var(--rik-font-sans); }
  .editor { overflow:hidden; background:var(--rik-code__bg); border:1px solid var(--rik-border-inverse); border-radius:var(--rik-radius-md) var(--rik-radius-md) 0 0; box-shadow:var(--rik-elevation-3); }
  .editor header,.doctor header { display:flex; flex-wrap:wrap; justify-content:space-between; gap:var(--rik-space-2); padding:var(--rik-space-2) var(--rik-space-3); color:var(--rik-text-inverse--muted); border-bottom:1px solid var(--rik-border-inverse); font:700 var(--rik-font-size-xs)/1.2 var(--rik-font-mono); }
  .editor header code,.doctor header code { font-size:inherit; color:var(--rik-text-inverse--muted); background:transparent; padding:0; }
  .editor header > *,.doctor header > * { min-width:0; overflow-wrap:anywhere; }
  .editing { color:var(--rik-status-success); }
  .editing-surface { position:relative; min-height:320px; }
  textarea,.highlight { box-sizing:border-box; width:100%; min-height:320px; margin:0; padding:var(--rik-space-4); border:0; font:clamp(var(--rik-font-size-xs),1.1vw,var(--rik-font-size-mono))/1.65 var(--rik-font-mono); tab-size:2; white-space:pre-wrap; overflow-wrap:normal; }
  .highlight { position:absolute; inset:0; overflow:hidden; color:var(--rik-text-inverse); background:transparent; pointer-events:none; }
  .highlight code { display:block; padding:0; color:inherit; background:transparent; border-radius:0; font:inherit; line-height:inherit; letter-spacing:inherit; white-space:inherit; }
  textarea { position:relative; display:block; resize:vertical; outline:0; color:transparent; caret-color:var(--rik-text-inverse); background:transparent; -webkit-text-fill-color:transparent; }
  textarea::selection { color:transparent; background:var(--rik-status-success__border); }
  textarea:focus { box-shadow:inset 0 0 0 2px var(--rik-status-success); }
  .highlight :global(.syn-tag) { color:var(--rik-code__syntax-keyword); }
  .highlight :global(.syn-attr) { color:var(--rik-code__syntax-type); }
  .highlight :global(.syn-string) { color:var(--rik-code__syntax-string); }
  .highlight :global(.syn-comment) { color:var(--rik-text-inverse--faint); font-style:italic; }
  .doctor { overflow:hidden; color:var(--rik-text-inverse--muted); background:var(--rik-surface-inverse--soft-2); border-radius:0 0 var(--rik-radius-md) var(--rik-radius-md); }
  .doctor header { border-top:1px solid var(--rik-border-inverse); border-bottom:0; }
  .doctor header span { color:var(--rik-text-inverse); }
  .doctor i { display:inline-block; width:var(--rik-space-2xs); height:var(--rik-space-2xs); margin-right:var(--rik-space-2xs); border-radius:50%; background:var(--rik-status-success); }
  .doctor-output { min-height:var(--rik-btn-height); padding:0 var(--rik-space-3) var(--rik-space-2); font:var(--rik-font-size-xs)/1.55 var(--rik-font-mono); }
  .doctor-output p { margin:2px 0; }
  .doctor-output .ok { color:var(--rik-status-success); }
  .doctor-output .error { color:var(--rik-status-danger); }
  .result { display:grid; grid-template-rows:auto 1fr auto; min-width:0; overflow:hidden; padding:var(--rik-space-4); color:var(--rik-text-default); background:var(--rik-surface-raised); border:1px solid var(--rik-border-default); border-radius:var(--rik-radius-md); box-shadow:var(--rik-elevation-2); }
  .on-dark { color:var(--rik-text-default--faint); }
  .slide { display:grid; grid-template-columns:minmax(0,1fr) minmax(210px,.85fr); gap:var(--rik-space-4); align-items:center; min-height:220px; padding:var(--rik-space-3) 0; }
  .eyebrow { color:var(--rik-accent--strong); font:700 var(--rik-font-size-body)/1 var(--rik-font-mono); }
  h3 { margin:var(--rik-space-2) 0; color:var(--rik-text-default); font:900 clamp(2rem,3.2vw,3rem)/.95 var(--rik-font-display); letter-spacing:-.04em; overflow-wrap:anywhere; }
  .slide-copy p { margin:0; color:var(--rik-text-default--muted); line-height:1.45; }
  .rendered-code { min-width:0; margin:0; padding:var(--rik-space-4); overflow:auto; color:var(--rik-text-inverse); background:var(--rik-code__bg); border:1px solid var(--rik-code__border); border-radius:var(--rik-radius-sm); font:var(--rik-font-size-body)/1.5 var(--rik-font-mono); }
  .rendered-code code { white-space:pre-wrap; overflow-wrap:anywhere; }
  .rendered-code :global(.syn-keyword) { color:var(--rik-code__syntax-keyword); }
  .rendered-code :global(.syn-string) { color:var(--rik-code__syntax-string); }
  .legend { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); min-width:0; gap:0; margin:0; padding:var(--rik-space-3) 0 0; list-style:none; border-top:1px solid var(--rik-border-default); }
  .legend li { padding-right:var(--rik-space-3); color:var(--rik-text-default--muted); font-size:var(--rik-font-size-sm); line-height:1.45; }
  .legend li + li { padding-left:var(--rik-space-3); border-left:1px solid var(--rik-border-default); }
  .legend span { display:block; margin-bottom:.35rem; color:var(--rik-text-default); font-weight:800; }
  .legend code { color:var(--rik-text-default); }
  /* Five steps on one row · the order is the row. The result chip is the
     only fill in the rail, so it is what the eye lands on. The command is
     the verb only · every one of them takes the deck file. */
  .delivery { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:1px; margin:var(--rik-space-3) 0 0; padding:0; list-style:none; background:var(--rik-border-default); border:1px solid var(--rik-border-default); }
  .delivery li { display:grid; align-content:start; gap:var(--rik-space-1); min-width:0; padding:var(--rik-space-3); background:var(--rik-surface-page); }
  .delivery span { color:var(--rik-text-default--muted); font:600 var(--rik-font-size-sm)/1.3 var(--rik-font-sans); }
  .delivery code { width:fit-content; max-width:100%; color:var(--rik-text-default); font:var(--rik-font-size-sm)/1.4 var(--rik-font-mono); white-space:nowrap; background:transparent; padding:0; }
  /* The file argument sits on its own line so the command never breaks mid-token; the text is still one command. */
  .delivery code .arg { display:block; }
  .delivery strong { width:fit-content; max-width:100%; margin-top:var(--rik-space-1); padding:var(--rik-space-hair) var(--rik-space-2); color:var(--rik-text-inverse); background:var(--rik-surface-inverse); border-radius:var(--rik-radius-xs); font:700 var(--rik-font-size-sm)/1.3 var(--rik-font-sans); }
  @media (max-width:800px) {
    .anatomy { grid-template-columns:1fr; }
    .source :global(.code),.source :global(.block),.source :global(pre) { height:auto; }
    .slide { grid-template-columns:1fr; min-height:0; }
    .legend { grid-template-columns:1fr; }
    .legend li { padding:var(--rik-space-2) 0; }
    .legend li + li { padding-left:0; border-left:0; border-top:1px solid var(--rik-border-default); }
    .delivery { grid-template-columns:1fr; }
    .delivery li { grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:var(--rik-space-2xs) var(--rik-space-3); }
    .delivery span { grid-column:1; }
    .delivery code { grid-column:1; }
    .delivery strong { grid-column:2; grid-row:1 / span 2; margin-top:0; }
  }
</style>

<script is:inline>
  document.querySelectorAll('.anatomy').forEach((root) => {
    const input = root.querySelector('textarea');
    const highlight = root.querySelector('.highlight code');
    const output = root.querySelector('.doctor-output');
    if (!input || !highlight || !output) return;
    const escape = (value) => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
    const highlightMarkup = (value) => {
      const parts = value.split(/(<!--[\s\S]*?-->|<\/?[\w-]+(?:\s+[\s\S]*?)?>|'[^'\n]*'|"[^"\n]*")/g);
      return parts.map((part) => {
        const safe = escape(part);
        if (part.startsWith('<!--')) return `<span class="syn-comment">${safe}</span>`;
        if (part.startsWith('<')) {
          const attributes = safe.replace(/\s([\w-]+)(=)("[^"]*"|'[^']*')/g,
            ' <span class="syn-attr">$1</span>$2<span class="syn-string">$3</span>');
          return attributes.replace(/^(&lt;\/?)([\w-]+)/, '$1<span class="syn-tag">$2</span>');
        }
        if (/^['"]/.test(part)) return `<span class="syn-string">${safe}</span>`;
        return safe.replace(/\b(import|export|from|const|let|function|return|await)\b/g, '<span class="syn-tag">$1</span>');
      }).join('');
    };
    const highlightCode = (value) => value.split(/((?:'[^'\n]*'|"[^"\n]*"))/g).map((part) => {
      const safe = escape(part);
      if (/^['"]/.test(part)) return `<span class="syn-string">${safe}</span>`;
      return safe.replace(/\b(import|export|from|const|let|function|return|await)\b/g, '<span class="syn-keyword">$1</span>');
    }).join('');
    const text = (pattern, fallback) => input.value.match(pattern)?.[1]?.trim() || fallback;
    const line = (needle) => input.value.slice(0, Math.max(0, input.value.indexOf(needle))).split('\n').length;
    const render = () => {
      const problems = [];
      if (!/<deck-feature\b/.test(input.value)) problems.push(`Line ${line('<deck-feature')} · add a slide layout`);
      if (!/<h1\b[^>]*\bslot=["']title["'][^>]*>/.test(input.value)) problems.push(`Line ${line('<h1')} · add a title slot`);
      const opens = (input.value.match(/<deck-code\b/g) || []).length;
      const closes = (input.value.match(/<\/deck-code>/g) || []).length;
      if (opens !== closes) problems.push('Close the deck-code element');

      root.querySelector('[data-render="eyebrow"]').textContent = text(/<deck-feature[^>]*eyebrow=["']([^"']+)/, 'Slide');
      root.querySelector('[data-render="title"]').textContent = text(/<h1\s+slot=["']title["'][^>]*>([^<]*)<\/h1>/, 'Untitled slide');
      root.querySelector('[data-render="lead"]').textContent = text(/<p\s+slot=["']lead["'][^>]*>([\s\S]*?)<\/p>/, '').replace(/\s+/g, ' ');
      const code = text(/<deck-code[^>]*>([\s\S]*?)<\/deck-code>/, '');
      root.querySelector('[data-render="code"]').innerHTML = highlightCode(code);
      highlight.innerHTML = highlightMarkup(input.value) + '\n';
      output.innerHTML = problems.length
        ? problems.map((message) => `<p class="error">× ${message}</p>`).join('')
        : '<p class="ok">✓ sample checks passed</p><p>Run the CLI for browser, layout and timing checks.</p>';
    };
    input.addEventListener('input', render);
    input.addEventListener('scroll', () => {
      highlight.parentElement.scrollTop = input.scrollTop;
      highlight.parentElement.scrollLeft = input.scrollLeft;
    });
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      event.preventDefault();
      const start = input.selectionStart;
      input.setRangeText('  ', start, input.selectionEnd, 'end');
      render();
    });
    render();
  });
</script>
