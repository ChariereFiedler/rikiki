---
interface Props { code: string; }
const { code } = Astro.props;
---

<div class="anatomy">
  <div class="source">
    <p class="overline">What you write</p>
    <div class="editor">
      <header><span>index.html</span><span class="editing">Editable</span></header>
      <textarea aria-label="Editable slide source" spellcheck="false">{code}</textarea>
    </div>
    <div class="doctor" role="status" aria-live="polite">
      <header><span><i></i> Simplified markup hints</span><code>interactive example</code></header>
      <div class="doctor-output"></div>
    </div>
  </div>
  <div class="result" aria-label="Annotated rendering of the source">
    <p class="overline on-dark">What Rikiki renders</p>
    <div class="slide">
      <div class="slide-copy">
        <span class="eyebrow" data-render="eyebrow">Module</span>
        <h3 data-render="title">Side effects</h3>
        <p data-render="lead">A module can act on import.</p>
      </div>
      <pre><code data-render="code">import './polyfill';</code></pre>
    </div>
    <ol class="legend">
      <li><span>Layout</span><code>&lt;deck-feature&gt;</code> sets the composition.</li>
      <li><span>Content fields</span><code>title</code> and <code>lead</code> place the copy.</li>
      <li><span>Content component</span><code>&lt;deck-code&gt;</code> renders the code.</li>
    </ol>
  </div>
</div>

<ol class="delivery" aria-label="Verified delivery workflow">
  <li><span>01 · Inspect</span><code>npx rikiki check deck.html</code><strong>diagnostic report</strong></li>
  <li><span>02 · Review</span><code>npx rikiki render deck.html</code><strong>PNGs + gallery</strong></li>
  <li><span>03 · Package</span><code>npx rikiki bundle deck.html</code><strong>standalone HTML</strong></li>
  <li><span>04 · Deliver</span><code>npx rikiki export deck.html</code><strong>PDF created</strong></li>
</ol>

<style>
  .anatomy { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--rik-space-4); align-items:stretch; }
  .source,.result { min-width:0; }
  .overline { margin:0 0 var(--rik-space-2); color:var(--rik-text-default--faint); font:700 var(--rik-font-size-xs)/1 var(--rik-font-mono); letter-spacing:.15em; text-transform:uppercase; }
  .editor { overflow:hidden; background:#0d0d0f; border-radius:var(--rik-radius-md) var(--rik-radius-md) 0 0; }
  .editor header,.doctor header { display:flex; flex-wrap:wrap; justify-content:space-between; gap:var(--rik-space-2); padding:11px 14px; color:var(--rik-text-inverse--faint); border-bottom:1px solid var(--rik-border-inverse); font:700 .68rem/1 var(--rik-font-mono); letter-spacing:.1em; text-transform:uppercase; }
  .editor header > *,.doctor header > * { min-width:0; overflow-wrap:anywhere; }
  .editing { color:#79dec9; }
  textarea { display:block; box-sizing:border-box; width:100%; min-height:320px; resize:vertical; padding:var(--rik-space-4); border:0; outline:0; color:#e8e4f0; background:#0d0d0f; font:clamp(.76rem,1.1vw,.9rem)/1.65 var(--rik-font-mono); tab-size:2; }
  textarea:focus { box-shadow:inset 0 0 0 2px #00c8a0; }
  .doctor { overflow:hidden; color:#d8d4df; background:#17171a; border-radius:0 0 var(--rik-radius-md) var(--rik-radius-md); }
  .doctor header { border-top:1px solid rgba(255,255,255,.08); border-bottom:0; }
  .doctor header span { color:#fff; }
  .doctor i { display:inline-block; width:7px; height:7px; margin-right:6px; border-radius:50%; background:#00c8a0; }
  .doctor-output { min-height:44px; padding:0 14px 13px; font:clamp(.68rem,1vw,.78rem)/1.55 var(--rik-font-mono); }
  .doctor-output p { margin:2px 0; }
  .doctor-output .ok { color:#79dec9; }
  .doctor-output .error { color:#ff8d72; }
  .result { display:grid; grid-template-rows:auto 1fr auto; min-width:0; overflow:hidden; padding:var(--rik-space-4); color:var(--rik-code__text); background:var(--rik-code__bg); border-radius:var(--rik-radius-md); }
  .on-dark { color:rgba(255,255,255,.5); }
  .slide { display:grid; grid-template-columns:minmax(0,1fr) minmax(210px,.85fr); gap:var(--rik-space-4); align-items:center; min-height:220px; padding:var(--rik-space-3) 0; }
  .eyebrow { color:#f07020; font:700 .72rem/1 var(--rik-font-mono); letter-spacing:.14em; text-transform:uppercase; }
  h3 { margin:var(--rik-space-2) 0; color:var(--rik-text-inverse); font:900 clamp(2rem,3.2vw,3rem)/.95 var(--rik-font-display); letter-spacing:-.04em; overflow-wrap:anywhere; }
  .slide-copy p { margin:0; color:rgba(255,255,255,.62); line-height:1.45; }
  pre { min-width:0; margin:0; padding:var(--rik-space-4); overflow:auto; color:var(--rik-code__syntax-string); background:var(--rik-surface-inverse--soft-2); border-left:2px solid var(--rik-status-success); font:var(--rik-font-size-body)/1.5 var(--rik-font-mono); }
  pre code { white-space:pre-wrap; overflow-wrap:anywhere; }
  .legend { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); min-width:0; gap:0; margin:0; padding:var(--rik-space-3) 0 0; list-style:none; border-top:1px solid var(--rik-border-inverse); }
  .legend li { padding-right:var(--rik-space-3); color:rgba(255,255,255,.58); font-size:.84rem; line-height:1.45; }
  .legend li + li { padding-left:var(--rik-space-3); border-left:1px solid rgba(255,255,255,.14); }
  .legend span { display:block; margin-bottom:.35rem; color:#fff; font-weight:800; }
  .legend code { color:#79dec9; font-size:.82em; }
  .delivery { display:grid; grid-template-columns:repeat(4,1fr); margin:var(--rik-space-3) 0 0; padding:0; list-style:none; border:1px solid var(--rik-border-default); }
  .delivery li { display:grid; grid-template-columns:1fr auto; align-items:center; gap:5px 12px; padding:var(--rik-space-3); }
  .delivery li + li { border-left:1px solid var(--rik-border-default); }
  .delivery span { grid-column:1 / -1; color:var(--rik-accent--strong); font:700 var(--rik-font-size-xs)/1 var(--rik-font-mono); text-transform:uppercase; letter-spacing:.06em; }
  .delivery strong { color:var(--rik-status-success-on-light); font:800 var(--rik-font-size-xs)/1.3 var(--rik-font-mono); text-align:right; }
  .delivery code { width:fit-content; color:var(--rik-text-default--muted); font:var(--rik-font-size-xs)/1.4 var(--rik-font-mono); }
  @media (max-width:800px) {
    .anatomy { grid-template-columns:1fr; }
    .source :global(.code),.source :global(.block),.source :global(pre) { height:auto; }
    .slide { grid-template-columns:1fr; min-height:0; }
    .legend { grid-template-columns:1fr; }
    .legend li { padding:var(--rik-space-2) 0; }
    .legend li + li { padding-left:0; border-left:0; border-top:1px solid rgba(255,255,255,.14); }
    .delivery { grid-template-columns:1fr 1fr; }
    .delivery li:nth-child(3) { border-left:0; }
    .delivery li:nth-child(n+3) { border-top:1px solid var(--rik-border-default); }
  }
  @media (max-width:480px) {
    .delivery { grid-template-columns:1fr; }
    .delivery li + li { border-left:0; border-top:1px solid var(--rik-border-default); }
    .delivery li:nth-child(3) { border-left:0; }
  }
</style>

<script is:inline>
  document.querySelectorAll('.anatomy').forEach((root) => {
    const input = root.querySelector('textarea');
    const output = root.querySelector('.doctor-output');
    if (!input || !output) return;
    const text = (pattern, fallback) => input.value.match(pattern)?.[1]?.trim() || fallback;
    const line = (needle) => input.value.slice(0, Math.max(0, input.value.indexOf(needle))).split('\n').length;
    const render = () => {
      const problems = [];
      if (!/<deck-feature\b/.test(input.value)) problems.push(`Line ${line('<deck-feature')} · add a slide layout`);
      if (!/<h1\b[^>]*\bslot=["']title["'][^>]*>/.test(input.value)) problems.push(`Line ${line('<h1')} · add a title slot`);
      const opens = (input.value.match(/<deck-code\b/g) || []).length;
      const closes = (input.value.match(/<\/deck-code>/g) || []).length;
      if (opens !== closes) problems.push('Close the deck-code element');

      root.querySelector('[data-render="eyebrow"]').textContent = text(/<deck-feature[^>]*eyebrow=["']([^"']+)/, 'Slide');
      root.querySelector('[data-render="title"]').textContent = text(/<h1\s+slot=["']title["'][^>]*>([^<]*)<\/h1>/, 'Untitled slide');
      root.querySelector('[data-render="lead"]').textContent = text(/<p\s+slot=["']lead["'][^>]*>([\s\S]*?)<\/p>/, '').replace(/\s+/g, ' ');
      root.querySelector('[data-render="code"]').textContent = text(/<deck-code[^>]*>([\s\S]*?)<\/deck-code>/, '');
      output.innerHTML = problems.length
        ? problems.map((message) => `<p class="error">× ${message}</p>`).join('')
        : '<p class="ok">✓ simplified markup hints passed</p><p>Run the CLI for browser, layout and timing checks.</p>';
    };
    input.addEventListener('input', render);
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      event.preventDefault();
      const start = input.selectionStart;
      input.setRangeText('  ', start, input.selectionEnd, 'end');
      render();
    });
    render();
  });
</script>
