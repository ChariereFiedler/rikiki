---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <div class="brand">
      <span class="dot">●</span>
      <span class="name">rikiki</span>
    </div>
    <nav class="nav">
      <a href="/docs/">Docs</a>
      <a href="/docs/getting-started">Getting started</a>
      <a href="/docs/components">Components</a>
      <a href="/docs/theming">Theming</a>
      <a href="/docs/recipes">Recipes</a>
      <a href="/docs/api">API</a>
      <a href="/docs/changelog">Changelog</a>
      <a href="/docs/contributing">Contributing</a>
      <a href="https://gitlab.com/tordu-jardin/rikiki">View source on GitLab</a>
    </nav>
    <p class="meta">MIT · ©{year} · Astro site with live Rikiki demos</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse--faint);
    padding: var(--rik-space-6) var(--rik-space-5);
  }
  .inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex; flex-direction: column;
    gap: var(--rik-space-3);
  }
  .brand {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--rik-text-inverse);
    font: 800 1.05rem/1 var(--rik-font-display);
  }
  .dot { color: var(--rik-accent); }
  .nav {
    display: flex; flex-wrap: wrap;
    gap: var(--rik-space-3) var(--rik-space-4);
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-sm);
  }
  .nav a {
    color: var(--rik-text-inverse--muted);
    text-decoration: none;
  }
  .nav a:hover { color: var(--rik-accent); text-decoration: none; }
  .meta {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-xs);
    color: var(--rik-text-inverse--faint);
    margin-top: var(--rik-space-2);
    border-top: 1px solid var(--rik-border-inverse);
    padding-top: var(--rik-space-3);
  }
</style>
