---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <div class="brand">
      <span class="dot">●</span>
      <span class="name">rikiki</span>
    </div>
    <nav class="nav">
      <a href="#why">Why</a>
      <a href="#anatomy">Anatomy</a>
      <a href="#library">Library</a>
      <a href="#themes">Themes</a>
      <a href="#quickstart">Quickstart</a>
      <a href="/demo/">Live tour</a>
      <a href="https://github.com">Source</a>
    </nav>
    <p class="meta">MIT · ©{year} · made with the framework</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--on-dark-muted);
    padding: var(--sp-6) var(--sp-5);
  }
  .inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex; flex-direction: column;
    gap: var(--sp-3);
  }
  .brand {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--on-dark-text);
    font: 800 1.05rem/1 var(--display);
  }
  .dot { color: var(--mango); }
  .nav {
    display: flex; flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-4);
    font-family: var(--mono);
    font-size: var(--fs-small);
  }
  .nav a {
    color: var(--on-dark-soft);
    text-decoration: none;
  }
  .nav a:hover { color: var(--mango); text-decoration: none; }
  .meta {
    font-family: var(--mono);
    font-size: var(--fs-micro);
    color: var(--on-dark-faint);
    margin-top: var(--sp-2);
    border-top: 1px solid var(--on-dark-border);
    padding-top: var(--sp-3);
  }
</style>
