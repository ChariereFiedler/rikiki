---
import CodeBlock from './CodeBlock.astro';
import ComponentPreview from './ComponentPreview.astro';

interface Props {
  source: string;
  preview: string;
}
const { source, preview } = Astro.props;
---

<div class="quickstart-showcase">
  <header class="intro">
    <div>
      <p class="kicker">Source and result</p>
      <h3>Write one file. See the deck immediately.</h3>
    </div>
    <p>
      The source remains ordinary HTML. The browser renders the same file you
      review, check, bundle, and deliver.
    </p>
  </header>

  <div class="source-result">
    <div class="source-pane">
      <CodeBlock label="my-talk/index.html" lang="html" code={source} />
    </div>
    <div class="result-pane">
      <div class="result-label">
        <span class="live-dot"></span>
        Live result
        <span>resize-safe</span>
      </div>
      <ComponentPreview code={preview} full />
      <p class="result-note">
        Edit the markup and reload. No application shell or generated project
        sits between the source and the slide.
      </p>
    </div>
  </div>

  <ol class="commands">
    <li><span>01</span><strong>Inspect</strong><code>rikiki check</code></li>
    <li><span>02</span><strong>Review</strong><code>rikiki render</code></li>
    <li><span>03</span><strong>Package</strong><code>rikiki bundle</code></li>
    <li><span>04</span><strong>Deliver</strong><code>rikiki export</code></li>
  </ol>

  <footer>
    <p><strong>Delivery:</strong> one offline HTML file, plus PDF when the room needs it.</p>
    <a href="/docs/cheatsheet">Start with a five-component deck →</a>
  </footer>
</div>

<style>
  .quickstart-showcase { display: grid; gap: var(--rik-space-5); }
  .intro {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .8fr);
    align-items: end; gap: var(--rik-space-6);
  }
  .kicker {
    margin: 0 0 8px; color: var(--rik-accent--strong);
    font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: .14em; text-transform: uppercase;
  }
  h3 {
    margin: 0; max-width: 18ch; color: var(--rik-text-default);
    font: 900 clamp(1.6rem, 3vw, 2.4rem)/1.08 var(--rik-font-display);
    letter-spacing: -.025em; text-wrap: balance;
  }
  .intro > p {
    margin: 0; color: var(--rik-text-default--muted);
    font-size: var(--rik-font-size-body); line-height: 1.6;
  }
  .source-result {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: var(--rik-space-4); align-items: stretch;
  }
  .source-pane, .result-pane { min-width: 0; }
  .source-pane :global(.code-wrap) { height: 100%; }
  .source-pane :global(pre) { min-height: 100%; }
  .result-pane {
    padding: var(--rik-space-3);
    border: 1px solid var(--rik-border-default);
    border-radius: var(--rik-radius-md);
    background: var(--rik-surface-raised--strong);
    box-shadow: var(--rik-elevation-1);
  }
  .result-label {
    display: flex; align-items: center; gap: 8px;
    margin-bottom: var(--rik-space-2);
    color: var(--rik-text-default); font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono);
    letter-spacing: .12em; text-transform: uppercase;
  }
  .result-label span:last-child { margin-left: auto; color: var(--rik-text-default--faint); font-weight: 400; }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rik-status-success); box-shadow: 0 0 0 4px rgba(0, 200, 160, .12); }
  .result-pane :global(.comp-preview) { margin-bottom: var(--rik-space-3); }
  .result-pane :global(figcaption) { display: none; }
  .result-note { margin: 0; color: var(--rik-text-default--muted); font-size: var(--rik-font-size-sm); line-height: 1.5; }
  .commands {
    display: grid; grid-template-columns: repeat(4, 1fr);
    list-style: none; padding: 0; margin: 0;
    border-top: 1px solid var(--rik-border-default);
    border-bottom: 1px solid var(--rik-border-default);
  }
  .commands li { display: grid; gap: 5px; padding: var(--rik-space-3); border-right: 1px solid var(--rik-border-default); }
  .commands li:first-child { padding-left: 0; }
  .commands li:last-child { border-right: 0; }
  .commands span { color: var(--rik-accent--strong); font: 700 var(--rik-font-size-xs)/1 var(--rik-font-mono); }
  .commands strong { color: var(--rik-text-default); font-family: var(--rik-font-display); }
  .commands code { width: fit-content; color: var(--rik-text-default--muted); font-size: .75rem; }
  footer { display: flex; justify-content: space-between; align-items: center; gap: var(--rik-space-4); }
  footer p { margin: 0; color: var(--rik-text-default--muted); }
  footer strong { color: var(--rik-text-default); }
  footer a { color: var(--rik-accent--strong); font-weight: 800; text-decoration: none; }
  footer a:hover { text-decoration: underline; }
  @media (max-width: 760px) {
    .intro, .source-result { grid-template-columns: 1fr; gap: var(--rik-space-3); }
    .commands { grid-template-columns: 1fr 1fr; }
    .commands li, .commands li:first-child { padding: var(--rik-space-3); border-bottom: 1px solid var(--rik-border-default); }
    .commands li:nth-child(2) { border-right: 0; }
    .commands li:nth-child(n + 3) { border-bottom: 0; }
    footer { align-items: flex-start; flex-direction: column; }
  }
</style>
