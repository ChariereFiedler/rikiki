---
import CodeBlock from './CodeBlock.astro';
import Eyebrow from './Eyebrow.astro';

const embedSnippet = `<deck-root
  autoplay="4000"
  loop
  swipe>
  …your slides
</deck-root>`;

const carousel = `<!doctype html><html><head><meta charset="UTF-8">
<link rel="stylesheet" href="/rikiki/themes/rikiki.css">
<script type="module" src="/rikiki/dist/index.js"></scr` + `ipt>
<style>html,body{width:100%;height:100%;margin:0;overflow:hidden}deck-root{width:100%;height:100%}</style>
</head><body><deck-root autoplay="4000" loop swipe no-hint no-counter no-arrows transition="slide">
  <deck-cover brand="COURSE · 01">
    <h1>Learn in <span class="accent">context.</span></h1>
    <p class="sub">A lesson embedded where people need it.</p>
  </deck-cover>
  <deck-feature eyebrow="Concept">
    <h1 slot="title">One idea per screen</h1>
    <p slot="lead" class="lead">Use the same layouts, components and theme as the full deck.</p>
    <deck-callout type="ok"><strong>Swipe, click, or let it advance.</strong></deck-callout>
  </deck-feature>
  <deck-split cols="1-1">
    <h1 slot="title">Check understanding</h1>
    <deck-card slot="left" color="green"><h3>Example</h3><p>Show the pattern.</p></deck-card>
    <deck-card slot="right"><h3>Practice</h3><p>Let the learner apply it.</p></deck-card>
  </deck-split>
</deck-root></body></html>`;
---

<section id="dual" class="dual">
  <div class="inner">
    <Eyebrow text="Embedded learning" num="06" />
    <div class="intro">
      <h2>Put the deck inside the page.</h2>
      <p class="lede">
        A Rikiki deck is a Web Component, so the same material can live inside
        a training course, an onboarding guide, or product documentation.
        The slide canvas scales to its container; keyboard navigation starts when the embedded deck has focus.
      </p>
    </div>

    <div class="demo-grid">
      <div class="embed">
        <header>
          <span><i></i> Live carousel</span>
          <span>Swipe or use the arrows</span>
        </header>
        <div class="viewport">
          <iframe srcdoc={carousel} title="Embedded Rikiki training carousel"></iframe>
        </div>
        <div class="carousel-controls" aria-label="Carousel controls">
          <button type="button" class="btn btn-ghost btn-icon" data-carousel-prev aria-label="Previous slide"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"></path></svg></button>
          <span><strong data-carousel-current>1</strong> / 3</span>
          <button type="button" class="btn btn-ghost btn-icon" data-carousel-next aria-label="Next slide"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"></path></svg></button>
        </div>
      </div>
      <div class="how">
        <p class="label">The integration</p>
        <CodeBlock lang="html" code={embedSnippet} />
        <p>
          Add three attributes to the existing deck. Autoplay pauses on hover,
          touch gestures work on mobile, and <code>loop</code> returns to the first slide.
        </p>
        <div class="how-actions">
          <button type="button" class="btn btn-ghost" data-copy-embed>Copy markup snippet</button>
          <a href="/demo/">Open the example</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dual { padding:var(--rik-space-7) var(--rik-space-5); background:var(--rik-surface-raised); border-block:1px solid var(--rik-border-default); }
  .inner { max-width:var(--rik-measure-page); margin:0 auto; }
  .intro { margin-bottom:var(--rik-space-5); }
  h2 { max-width:20ch; margin:0 0 var(--rik-space-3); color:var(--rik-text-default); font:900 var(--rik-font-size-mega)/1.05 var(--rik-font-display); letter-spacing:-.025em; }
  .lede { max-width:66ch; margin:0; color:var(--rik-text-default--muted); font-size:var(--rik-font-size-lead); line-height:1.55; }
  .demo-grid { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(260px,.65fr); gap:var(--rik-space-4); align-items:stretch; }
  .embed { --rik-btn-ghost__border:var(--rik-border-inverse--strong); --rik-btn-ghost__text:var(--rik-text-inverse); min-width:0; overflow:hidden; background:var(--rik-surface-inverse); border-radius:var(--rik-radius-md); box-shadow:var(--rik-elevation-3); }
  .embed header { display:flex; justify-content:space-between; gap:var(--rik-space-3); padding:var(--rik-space-2) var(--rik-space-3); color:var(--rik-text-inverse--muted); font:600 var(--rik-font-size-sm)/1.3 var(--rik-font-sans); }
  .embed header span:first-child { color:var(--rik-text-inverse); }
  .embed i { display:inline-block; width:var(--rik-space-1); height:var(--rik-space-1); margin-right:var(--rik-space-2xs); border-radius:50%; background:var(--rik-status-success); }
  .viewport { position:relative; aspect-ratio:16/9; overflow:hidden; }
  .carousel-controls { display:flex; justify-content:flex-end; align-items:center; gap:var(--rik-space-2); padding:var(--rik-space-2) var(--rik-space-3); color:var(--rik-text-inverse--muted); border-top:1px solid var(--rik-border-inverse); font:600 var(--rik-font-size-sm)/1 var(--rik-font-mono); }
  .carousel-controls strong { color:var(--rik-text-inverse); }
  iframe { position:absolute; inset:0; width:1920px; height:1080px; border:0; transform-origin:top left; }
  .how { display:flex; flex-direction:column; justify-content:center; gap:var(--rik-space-3); min-width:0; padding:var(--rik-space-4) 0; border-block:1px solid var(--rik-border-default); }
  .label { margin:0; color:var(--rik-text-default--muted); font:600 var(--rik-font-size-sm)/1.3 var(--rik-font-sans); }
  .how p { margin:0; color:var(--rik-text-default--muted); font-size:var(--rik-font-size-md); line-height:1.55; }
  .how a { color:var(--rik-accent--strong); font-size:var(--rik-font-size-body); font-weight:700; text-decoration:none; }
  .how-actions { display:flex; flex-wrap:wrap; align-items:center; gap:var(--rik-space-3); }
  @media (max-width:800px) {
    .dual { padding:var(--rik-space-6) var(--rik-space-3); }
    .demo-grid { grid-template-columns:1fr; }
    .embed header span:last-child { display:none; }
  }
</style>

<script is:inline>
  document.querySelectorAll('.embed .viewport').forEach((viewport) => {
    const iframe = viewport.querySelector('iframe');
    if (!iframe) return;
    const fit = () => { iframe.style.transform = `scale(${viewport.clientWidth / 1920})`; };
    fit();
    new ResizeObserver(fit).observe(viewport);
    const embed = viewport.closest('.embed');
    const current = embed?.querySelector('[data-carousel-current]');
    const move = (key) => {
      iframe.contentWindow?.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true }));
      window.setTimeout(() => {
        const deck = iframe.contentDocument?.querySelector('deck-root');
        if (current && deck && typeof deck.current === 'number') current.textContent = String(deck.current + 1);
      }, 120);
    };
    embed?.querySelector('[data-carousel-prev]')?.addEventListener('click', () => move('ArrowLeft'));
    embed?.querySelector('[data-carousel-next]')?.addEventListener('click', () => move('ArrowRight'));
  });
  document.querySelectorAll('[data-copy-embed]').forEach((button) => button.addEventListener('click', async () => {
    await navigator.clipboard.writeText('<deck-root autoplay="4000" loop swipe>\n  …your slides\n</deck-root>');
    button.textContent = 'Copied';
  }));
</script>
