---
// Hero · same XL display + accent split as <deck-cover>, but on a marketing page.
import Eyebrow from './Eyebrow.astro';
---

<section id="top" class="hero">
  <div class="hero-inner">
    <Eyebrow text="For coding agents and the developers who brief them" tone="inverse" />

    <h1 class="title">
      Brief. Build.<br />
      Check. <span class="accent">Present.</span>
    </h1>

    <p class="tagline">
      Readable HTML <span class="dot">·</span> no build step <span class="dot">·</span> <strong>automated deck checks</strong> <span class="dot">·</span> offline delivery <span class="dot">·</span> MIT
    </p>

    <p class="lead">
      Turn a brief into HTML slides with your coding agent. Check the layout in a
      browser, review the screenshots, then share a standalone deck or PDF.
      Keep the source to make the next edit.
    </p>

    <div class="ctas">
      <a class="btn btn-primary" href="/docs/getting-started">Create your first deck</a>
      <a class="btn btn-ghost" href="#decks">See a finished deck</a>
    </div>

    <ul class="meta">
      <li><strong>43 KB</strong> initial JavaScript load · gzip</li>
      <li><strong>36</strong> core components · 23 optional</li>
      <li><strong>Chromium, Firefox, WebKit</strong> · tested rendering contract</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    --rik-btn-ghost__border: var(--rik-border-inverse--strong);
    --rik-btn-ghost__text: var(--rik-text-inverse);
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
    padding: var(--rik-space-7) var(--rik-space-5);
    position: relative;
    overflow: hidden;
  }
  .hero-inner {
    max-width: 920px;
    margin: 0 auto;
    position: relative;
  }
  .title {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-display);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--rik-text-inverse);
    margin-bottom: var(--rik-space-4);
    overflow-wrap:anywhere;
  }
  .title .accent { color: var(--rik-accent); }
  .tagline {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-inverse--muted);
    letter-spacing: 0.02em;
    margin-bottom: var(--rik-space-4);
    line-height: 1.5;
  }
  .tagline strong { color: var(--rik-accent); font-weight: 700; }
  .tagline .dot { color: var(--rik-text-inverse--faint); margin: 0 4px; }
  .lead {
    font-size: var(--rik-font-size-lead);
    line-height: 1.55;
    max-width: 60ch;
    color: var(--rik-text-inverse--muted);
    margin-bottom: var(--rik-space-5);
  }
  .lead code {
    background: var(--rik-surface-inverse__overlay);
    color: var(--rik-text-inverse);
  }
  .ctas { display: flex; gap: var(--rik-space-3); flex-wrap: wrap; margin-bottom: var(--rik-space-6); }
  .meta {
    display: flex; flex-wrap: wrap;
    gap: var(--rik-space-4);
    list-style: none;
    padding: var(--rik-space-4) 0 0;
    border-top: 1px solid var(--rik-border-inverse);
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-inverse--faint);
  }
  .meta strong { color: var(--rik-text-inverse); font-weight: 700; }
  .meta li { min-width:0; overflow-wrap:anywhere; }

  @media (max-width: 640px) {
    .hero {
      padding: var(--rik-space-6) var(--rik-space-3);
    }
    .title {
      font-size: clamp(2.8rem, 12vw, 4.5rem);
      line-height: 0.98;
    }
    .tagline {
      line-height: 1.7;
    }
    .lead {
      font-size: var(--rik-font-size-body);
      line-height: 1.55;
    }
    .ctas {
      align-items: stretch;
      flex-direction: column;
    }
    .meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--rik-space-3);
      font-size: var(--rik-font-size-xs);
    }
  }
</style>
