---
// Hero · same XL display + accent split as <deck-cover>, but on a marketing page.
---

<section id="top" class="hero">
  <div class="hero-inner">
    <p class="eyebrow"><span class="eyebrow-mark"></span>Presentation tools for teams that work in code</p>

    <h1 class="title">
      Write the talk.<br />
      Check it. <span class="accent">Ship it.</span>
    </h1>

    <p class="tagline">
      Readable HTML <span class="dot">·</span> <strong>automated deck checks</strong> <span class="dot">·</span> offline delivery <span class="dot">·</span> MIT
    </p>

    <p class="lead">
      Build technical presentations in readable HTML, keep the source in version
      control, catch layout and runtime problems, then export standalone HTML or PDF.
    </p>

    <div class="ctas">
      <a class="btn primary" href="/docs/getting-started">Create your first deck</a>
      <a class="btn ghost" href="#quickstart">Try the live editor →</a>
    </div>

    <ul class="meta">
      <li><strong>43 KB</strong> initial JavaScript load · gzip</li>
      <li><strong>36</strong> core components · 23 optional</li>
      <li><strong>Offline HTML + PDF</strong></li>
      <li><strong>MIT</strong></li>
    </ul>
  </div>
</section>

<style>
  .hero {
    background: var(--rik-surface-inverse);
    color: var(--rik-text-inverse);
    padding: var(--rik-space-7) var(--rik-space-5);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 15% 85%, rgba(240, 112, 32, 0.10) 0%, transparent 50%),
      radial-gradient(circle at 85% 15%, rgba(0, 200, 160, 0.08) 0%, transparent 45%);
    pointer-events: none;
  }
  .hero-inner {
    max-width: 920px;
    margin: 0 auto;
    position: relative;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-xs);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--rik-text-inverse--muted);
    margin-bottom: var(--rik-space-4);
  }
  .eyebrow-mark {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--rik-accent);
    box-shadow: 0 0 0 5px rgba(240, 112, 32, 0.12);
  }
  .title {
    font-family: var(--rik-font-display);
    font-size: var(--rik-font-size-display);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--rik-text-inverse);
    margin-bottom: var(--rik-space-4);
    overflow-wrap:anywhere;
  }
  .title .accent { color: var(--rik-accent); }
  .tagline {
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-inverse--muted);
    letter-spacing: 0.02em;
    margin-bottom: var(--rik-space-4);
    line-height: 1.5;
  }
  .tagline strong { color: var(--rik-accent); font-weight: 700; }
  .tagline .dot { color: var(--rik-text-inverse--faint); margin: 0 4px; }
  .lead {
    font-size: var(--rik-font-size-lead);
    line-height: 1.55;
    max-width: 60ch;
    color: var(--rik-text-inverse--muted);
    margin-bottom: var(--rik-space-5);
  }
  .lead code {
    background: rgba(232, 228, 240, 0.10);
    color: var(--rik-text-inverse);
  }
  .ctas { display: flex; gap: var(--rik-space-3); flex-wrap: wrap; margin-bottom: var(--rik-space-6); }
  .btn {
    display: inline-flex; align-items: center;
    min-height: 44px;
    padding: 12px 22px;
    border-radius: var(--rik-radius-pill);
    font: 700 var(--rik-font-size-body)/1 var(--rik-font-sans);
    transition: transform 0.15s ease;
  }
  .btn:hover { text-decoration: none; transform: translateY(-2px); }
  .btn.primary { background: var(--rik-accent); color: var(--rik-surface-inverse); }
  .btn.ghost {
    background: transparent;
    color: var(--rik-text-inverse);
    border: 1px solid var(--rik-border-inverse);
  }
  .meta {
    display: flex; flex-wrap: wrap;
    gap: var(--rik-space-4);
    list-style: none;
    padding: var(--rik-space-4) 0 0;
    border-top: 1px solid var(--rik-border-inverse);
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-sm);
    color: var(--rik-text-inverse--faint);
  }
  .meta strong { color: var(--rik-text-inverse); font-weight: 700; }
  .meta li { min-width:0; overflow-wrap:anywhere; }

  @media (max-width: 640px) {
    .hero {
      padding: var(--rik-space-6) var(--rik-space-3);
    }
    .title {
      font-size: clamp(2.8rem, 15vw, 4.5rem);
      line-height: 0.98;
    }
    .tagline {
      font-size: var(--rik-font-size-xs);
      line-height: 1.7;
    }
    .lead {
      font-size: var(--rik-font-size-body);
      line-height: 1.55;
    }
    .ctas {
      align-items: stretch;
      flex-direction: column;
    }
    .btn {
      justify-content: center;
      min-height: 44px;
    }
    .meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--rik-space-3);
      font-size: var(--rik-font-size-xs);
    }
  }
</style>
