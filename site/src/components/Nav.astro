---
// Sticky top nav · brand chip + section anchors + GitHub link.
---

<nav class="nav">
  <a href="/" class="brand" aria-label="Home">
    <span class="brand-mark" aria-hidden="true">●</span>
    <span class="brand-name">rikiki</span>
  </a>

  <div class="links">
    <a href="/docs/">Docs</a>
    <a href="/docs/components">Components</a>
    <a href="/docs/theming">Theming</a>
    <a href="/docs/changelog">Changelog</a>
    <a href="https://gitlab.com/tordu-jardin/rikiki" class="cta">Source ↗</a>
  </div>
</nav>

<style>
  .nav {
    position: sticky; top: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--rik-space-3) var(--rik-space-5);
    background: rgba(250, 248, 245, 0.85);
    backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid var(--rik-border-default);
    font-family: var(--rik-font-mono);
    font-size: var(--rik-font-size-sm);
  }
  .brand {
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none;
    color: var(--rik-text-default);
    font-weight: 700;
  }
  .brand-mark { color: var(--rik-accent); font-size: 1.3rem; line-height: 1; }
  .brand-name {
    font-family: var(--rik-font-display); font-weight: 800;
    letter-spacing: -0.01em; font-size: 1.05rem;
  }
  .links { display: inline-flex; align-items: center; gap: var(--rik-space-4); }
  .links a {
    color: var(--rik-text-default--faint);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .links a:hover { color: var(--rik-text-default); text-decoration: none; }
  .links .cta {
    color: var(--rik-surface-inverse);
    background: var(--rik-accent);
    padding: 6px 12px;
    border-radius: var(--rik-radius-pill);
    font-weight: 700;
  }
  .links .cta:hover { color: var(--rik-surface-inverse); }
  @media (max-width: 640px) {
    .links a:not(:first-child):not(.cta) { display: none; }
  }
  @media (max-width: 400px) {
    .nav { padding-inline:var(--rik-space-3); }
    .links a:not(.cta) { display:none; }
  }
</style>
